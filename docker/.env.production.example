# Copy to .env.production on the Oracle VM. Never commit the real file.

API_DOMAIN=internal-api.molystudio.online
ACME_EMAIL=admin@molystudio.online
API_IMAGE_TAG=local

POSTGRES_USER=moli_app
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=moli_internal_management

# At least 32 random characters; use a different value from every other app.
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ISSUER=MoliBackendApi
JWT_AUDIENCE=MoliClients

# The website origin is included for future browser integrations.
CORS_ALLOWED_ORIGIN_0=https://molystudio.online
CORS_ALLOWED_ORIGIN_1=https://www.molystudio.online

# Optional: required only when receipt attachments are enabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=moli/attachments
CLOUDINARY_MAX_FILE_SIZE_BYTES=15728640

# Optional external integration credentials. Keep blank until contracts and sandbox tests exist.
CSCA_MOLI_STUDIO_BEARER_TOKEN=
CSCA_MOLI_STUDIO_INTEGRATION_KEY=
WEBSITE_INTERVIEW_BEARER_TOKEN=
WEBSITE_INTERVIEW_INTEGRATION_KEY=

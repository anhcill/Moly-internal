<Window x:Class="InternalManagement.Desktop.CscaClassFinanceDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InternalManagement.Desktop"
        Title="Chi tiết tài chính lớp học"
        Icon="Assets/app-icon.ico"
        Width="1120" Height="680" MinWidth="880" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource LightBgBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="BorderBrush" Value="#4F46E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="Transparent" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563EB" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RightAlignStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="CenterAlignStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EmeraldTextRightStyle" TargetType="TextBlock" BasedOn="{StaticResource RightAlignStyle}">
            <Setter Property="Foreground" Value="#059669" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="AmberTextRightStyle" TargetType="TextBlock" BasedOn="{StaticResource RightAlignStyle}">
            <Setter Property="Foreground" Value="#D97706" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP HEADER -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border x:Name="ClassTypeBadge" CornerRadius="6" Padding="8,3" Margin="0,0,10,0" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1">
                            <TextBlock x:Name="ClassTypeText" Text="LỚP CHÍNH THỨC" FontSize="11" FontWeight="Bold" Foreground="#065F46" />
                        </Border>
                        <TextBlock x:Name="ClassCodeText" Text="CSCA" FontSize="17" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        <TextBlock Text=" — " FontSize="17" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                        <TextBlock x:Name="ClassNameText" Text="Tên lớp học" FontSize="17" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ClassSubtitleText" Text="Khóa học: ... • Đợt: ... • Học phí niêm yết: ... đ/học viên" FontSize="12" Foreground="#64748B" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ Thêm học viên" Click="AddStudent_Click" Style="{StaticResource PrimaryButton}" Height="34" />
                    <Button Content="↻ Tải lại" Click="Refresh_Click" Style="{StaticResource ToolbarButton}" Height="34" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ROW 1: METRICS SUMMARY CARDS -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <!-- Sĩ số -->
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="SĨ SỐ HỌC VIÊN" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                    <TextBlock Grid.Row="1" x:Name="MetricStudentCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,3,0,1" />
                    <TextBlock Grid.Row="2" Text="Tổng học viên trong lớp" FontSize="10" Foreground="#94A3B8" />
                </Grid>
            </Border>

            <!-- Học phí cần thu -->
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="TỔNG CẦN THU" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                    <TextBlock Grid.Row="1" x:Name="MetricPayable" Text="0 đ" FontSize="20" FontWeight="Bold" Foreground="#3B82F6" Margin="0,3,0,1" />
                    <TextBlock Grid.Row="2" Text="Sau trừ giảm giá" FontSize="10" Foreground="#94A3B8" />
                </Grid>
            </Border>

            <!-- Thực tế đã thu -->
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="ĐÃ THU THỰC TẾ" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                    <TextBlock Grid.Row="1" x:Name="MetricPaid" Text="0 đ" FontSize="20" FontWeight="Bold" Foreground="#059669" Margin="0,3,0,1" />
                    <TextBlock Grid.Row="2" Text="Đã nộp vào quỹ" FontSize="10" Foreground="#94A3B8" />
                </Grid>
            </Border>

            <!-- Số tiền còn nợ -->
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,10" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="SỐ TIỀN CÒN NỢ" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                    <TextBlock Grid.Row="1" x:Name="MetricDebt" Text="0 đ" FontSize="20" FontWeight="Bold" Foreground="#D97706" Margin="0,3,0,1" />
                    <TextBlock Grid.Row="2" Text="Cần thu bổ sung" FontSize="10" Foreground="#94A3B8" />
                </Grid>
            </Border>
        </UniformGrid>

        <!-- ROW 2: SEARCH & FILTER TOOLBAR -->
        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#94A3B8" />
                    <TextBox x:Name="SearchBox" Width="240" Height="32" Padding="6,3" VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged" ToolTip="Tìm kiếm theo mã, họ tên, điện thoại, email..." />
                    <ComboBox x:Name="PaymentStatusFilterCombo" Width="170" Height="32" Margin="10,0,0,0"
                              VerticalContentAlignment="Center" SelectionChanged="PaymentStatusFilterCombo_SelectionChanged">
                        <ComboBoxItem Content="Tất cả trạng thái" IsSelected="True" />
                        <ComboBoxItem Content="Đã đóng đủ" />
                        <ComboBoxItem Content="Đóng một phần" />
                        <ComboBoxItem Content="Còn nợ tiền" />
                        <ComboBoxItem Content="Chưa đóng" />
                    </ComboBox>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💡 Bấm đúp (double-click) một học viên để sửa số tiền đóng / học phí"
                               FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="⬇ Xuất CSV" Click="ExportCsv_Click" Style="{StaticResource ToolbarButton}" Height="32" Padding="12,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ROW 3: STUDENTS FINANCE DATAGRID -->
        <Border Grid.Row="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="10" Padding="6">
            <DataGrid x:Name="StudentsFinanceDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      RowHeight="44" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource TableLinesBrush}"
                      Background="{DynamicResource TableBgBrush}" BorderThickness="0" MouseDoubleClick="StudentsFinanceDataGrid_MouseDoubleClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MÃ HV" Binding="{Binding StudentCode}" Width="95" FontWeight="Bold" />
                    <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding StudentName}" Width="1.5*" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="ĐIỆN THOẠI" Binding="{Binding PhoneNumber}" Width="110" />
                    <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="1.3*" />
                    <DataGridTextColumn Header="HỌC PHÍ GỐC" Binding="{Binding TuitionFee, StringFormat='{}{0:N0} đ'}" Width="110" ElementStyle="{StaticResource RightAlignStyle}" />
                    <DataGridTextColumn Header="GIẢM GIÁ" Binding="{Binding DiscountAmount, StringFormat='{}{0:N0} đ'}" Width="100" ElementStyle="{StaticResource RightAlignStyle}" />
                    <DataGridTextColumn Header="CẦN THU" Binding="{Binding PayableAmount, StringFormat='{}{0:N0} đ'}" Width="110" FontWeight="SemiBold" ElementStyle="{StaticResource RightAlignStyle}" />
                    <DataGridTextColumn Header="ĐÃ ĐÓNG" Binding="{Binding PaidAmount, StringFormat='{}{0:N0} đ'}" Width="120" FontWeight="Bold" ElementStyle="{StaticResource EmeraldTextRightStyle}" />
                    <DataGridTextColumn Header="CÒN NỢ" Binding="{Binding DebtAmount, StringFormat='{}{0:N0} đ'}" Width="110" FontWeight="Bold" ElementStyle="{StaticResource AmberTextRightStyle}" />
                    <DataGridTextColumn Header="NGÀY ĐÓNG" Binding="{Binding JoinedAtFormatted}" Width="110" ElementStyle="{StaticResource CenterAlignStyle}" />
                    <DataGridTemplateColumn Header="TRẠNG THÁI" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FEE2E2" />
                                            <Setter Property="BorderBrush" Value="#FECACA" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PaymentStatusValue}" Value="2">
                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                    <Setter Property="BorderBrush" Value="#BBF7D0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PaymentStatusValue}" Value="1">
                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                    <Setter Property="BorderBrush" Value="#FDE68A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PaymentStatusValue}" Value="4">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PaymentStatusValue}" Value="5">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding PaymentStatusLabel}" FontWeight="SemiBold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#B91C1C" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PaymentStatusValue}" Value="2">
                                                        <Setter Property="Foreground" Value="#15803D" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentStatusValue}" Value="1">
                                                        <Setter Property="Foreground" Value="#B45309" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentStatusValue}" Value="4">
                                                        <Setter Property="Foreground" Value="#64748B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentStatusValue}" Value="5">
                                                        <Setter Property="Foreground" Value="#64748B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="HẸN TRẢ" Binding="{Binding DebtDueDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="105" ElementStyle="{StaticResource CenterAlignStyle}" />
                    <DataGridTextColumn Header="GHI CHÚ" Binding="{Binding Notes}" Width="1.3*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ROW 4: FOOTER STATUS & CLOSE -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="FooterStatusText" Text="Hiển thị: 0 học viên" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <Button Content="Đóng" Click="Close_Click" Style="{StaticResource ToolbarButton}" Width="90" Height="34" DockPanel.Dock="Right" IsCancel="True" />
        </DockPanel>

        <!-- BUSY OVERLAY -->
        <Border x:Name="BusyOverlay" Grid.RowSpan="5" Background="#66090E1D" Visibility="Collapsed" Panel.ZIndex="100" Margin="-18">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="280">
                <StackPanel HorizontalAlignment="Center">
                    <local:MolyDualOrbitSpinner Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock x:Name="BusyText" Text="Đang tải dữ liệu học viên..." HorizontalAlignment="Center" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4" />
                    <ProgressBar IsIndeterminate="True" Width="200" Height="3" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:InternalManagement.Desktop.Converters">

    <!-- Shared Converters (Status Badges) -->
    <converters:StatusBadgeBackgroundConverter x:Key="StatusBadgeBackgroundConverter" />
    <converters:StatusBadgeForegroundConverter x:Key="StatusBadgeForegroundConverter" />
    <converters:StatusBadgeDotConverter x:Key="StatusBadgeDotConverter" />

    <!-- Brand & Shell Palette -->
    <Color x:Key="DarkBgColor">#090E1A</Color>
    <Color x:Key="DarkSidebarColor">#0B1120</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>

    <SolidColorBrush x:Key="DarkBgBrush" Color="{StaticResource DarkBgColor}" />
    <SolidColorBrush x:Key="DarkSidebarBrush" Color="{StaticResource DarkSidebarColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <!-- Refined Modern Gradients -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F46E5" Offset="0" />
        <GradientStop Color="#4338CA" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="EnterpriseDarkGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#060A14" Offset="0" />
        <GradientStop Color="#0B1120" Offset="0.4" />
        <GradientStop Color="#111B33" Offset="0.75" />
        <GradientStop Color="#090E1A" Offset="1" />
    </LinearGradientBrush>

    <!-- Sleek Obsidian-Slate Sidebar (no garish purple wash) -->
    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0B1120" Offset="0" />
        <GradientStop Color="#0D1426" Offset="0.55" />
        <GradientStop Color="#090E1A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandGlowGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#60A5FA" Offset="0" />
        <GradientStop Color="#818CF8" Offset="0.5" />
        <GradientStop Color="#38BDF8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#059669" Offset="0" />
        <GradientStop Color="#10B981" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LogoBadgeGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0" />
        <GradientStop Color="#4F46E5" Offset="0.55" />
        <GradientStop Color="#0EA5E9" Offset="1" />
    </LinearGradientBrush>

    <!-- Modern Font Family -->
    <FontFamily x:Key="MainFont">Segoe UI</FontFamily>

    <!-- Refined Elevation Effects (subtle, clean, never garish) -->
    <DropShadowEffect x:Key="HeroCardShadow" BlurRadius="14" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.22" />
    <DropShadowEffect x:Key="ButtonGlowShadow" BlurRadius="8" ShadowDepth="1" Direction="270" Color="#4F46E5" Opacity="0.18" />
    <DropShadowEffect x:Key="LogoGlowShadow" BlurRadius="16" ShadowDepth="0" Color="#6366F1" Opacity="0.38" />
    <DropShadowEffect x:Key="LoginCardGlowShadow" BlurRadius="22" ShadowDepth="0" Color="#38BDF8" Opacity="0.28" />

</ResourceDictionary>

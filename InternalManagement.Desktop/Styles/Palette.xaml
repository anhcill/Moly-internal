<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <!-- Modern Color Palette -->
        <Color x:Key="PrimaryColor">#4F46E5</Color>
        <Color x:Key="PrimaryDarkColor">#3730A3</Color>
        <Color x:Key="SecondaryColor">#3B82F6</Color>
        <Color x:Key="AccentColor">#06B6D4</Color>
        <Color x:Key="DarkBgColor">#0F172A</Color>
        <Color x:Key="DarkSidebarColor">#1E1B4B</Color>
        <Color x:Key="LightBgColor">#F8FAFC</Color>
        <Color x:Key="CardBgColor">#FFFFFF</Color>
        <Color x:Key="BorderLightColor">#E2E8F0</Color>
        <Color x:Key="TextDarkColor">#0F172A</Color>
        <Color x:Key="TextMutedColor">#64748B</Color>
        <Color x:Key="SuccessColor">#10B981</Color>
        <Color x:Key="WarningColor">#F59E0B</Color>
        <Color x:Key="DangerColor">#EF4444</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="DarkBgBrush" Color="{StaticResource DarkBgColor}" />
        <SolidColorBrush x:Key="DarkSidebarBrush" Color="{StaticResource DarkSidebarColor}" />
        <SolidColorBrush x:Key="LightBgBrush" Color="{StaticResource LightBgColor}" />
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
        <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />
        <SolidColorBrush x:Key="TextDarkBrush" Color="{StaticResource TextDarkColor}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

        <!-- Accessible table interaction colors. Keep selected rows readable even when
             a column uses a semantic color for money/status values. -->
        <SolidColorBrush x:Key="TableHoverBrush" Color="#EFF6FF" />
        <SolidColorBrush x:Key="TableSelectionBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="TableSelectionHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="TableSelectionTextBrush" Color="#FFFFFF" />

        <!-- Linear Gradients -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4F46E5" Offset="0" />
            <GradientStop Color="#2563EB" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="EnterpriseDarkGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#090E1D" Offset="0" />
            <GradientStop Color="#0F172A" Offset="0.35" />
            <GradientStop Color="#17223F" Offset="0.7" />
            <GradientStop Color="#0C1222" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0F172A" Offset="0" />
            <GradientStop Color="#1E1B4B" Offset="0.6" />
            <GradientStop Color="#0F172A" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BrandGlowGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#60A5FA" Offset="0" />
            <GradientStop Color="#A78BFA" Offset="0.5" />
            <GradientStop Color="#F472B6" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#059669" Offset="0" />
            <GradientStop Color="#10B981" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LogoBadgeGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6366F1" Offset="0" />
            <GradientStop Color="#4F46E5" Offset="0.5" />
            <GradientStop Color="#06B6D4" Offset="1" />
        </LinearGradientBrush>

        <!-- Modern Font Family -->
        <!-- WPF accepts a font family name, not a CSS fallback list. -->
        <FontFamily x:Key="MainFont">Segoe UI</FontFamily>

        <!-- Drop Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.06" />
        <DropShadowEffect x:Key="FloatingShadow" BlurRadius="36" ShadowDepth="10" Direction="270" Color="#0F172A" Opacity="0.10" />
        <DropShadowEffect x:Key="HeroCardShadow" BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.30" />
        <DropShadowEffect x:Key="ButtonGlowShadow" BlurRadius="14" ShadowDepth="4" Direction="270" Color="#4F46E5" Opacity="0.40" />
        <DropShadowEffect x:Key="LogoGlowShadow" BlurRadius="20" ShadowDepth="0" Color="#6366F1" Opacity="0.55" />
        <DropShadowEffect x:Key="LoginCardGlowShadow" BlurRadius="26" ShadowDepth="0" Color="#38BDF8" Opacity="0.45" />

</ResourceDictionary>

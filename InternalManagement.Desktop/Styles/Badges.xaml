<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <!-- KPI Summary Chips (Matching Image 2, 3: Orange, Green, Blue, Purple) -->
        <Style x:Key="KpiChipOrange" TargetType="Border">
            <Setter Property="Background" Value="#FEF3C7" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KpiChipGreen" TargetType="Border">
            <Setter Property="Background" Value="#DCFCE7" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KpiChipBlue" TargetType="Border">
            <Setter Property="Background" Value="#DBEAFE" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KpiChipPurple" TargetType="Border">
            <Setter Property="Background" Value="#F3E8FF" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Table Status Pill Badges (Matching Image 1, 2, 3) -->
        <Style x:Key="TableStatusPillOrange" TargetType="Border">
            <Setter Property="Background" Value="#FEF3C7" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TableStatusPillGreen" TargetType="Border">
            <Setter Property="Background" Value="#DCFCE7" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TableStatusPillBlue" TargetType="Border">
            <Setter Property="Background" Value="#DBEAFE" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TableStatusPillSlate" TargetType="Border">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TableStatusPillRed" TargetType="Border">
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TableStatusPillPurple" TargetType="Border">
            <Setter Property="Background" Value="#F3E8FF" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary brand colors (Fluent / Linear Dark 2.0) -->
    <Color x:Key="PrimaryColor">#6366F1</Color>
    <Color x:Key="PrimaryHoverColor">#818CF8</Color>
    <Color x:Key="PrimaryDarkColor">#4F46E5</Color>
    <Color x:Key="SecondaryColor">#60A5FA</Color>
    <Color x:Key="AccentColor">#38BDF8</Color>

    <!-- Surfaces & Backgrounds -->
    <Color x:Key="AppBgColor">#090E1A</Color>
    <Color x:Key="LightBgColor">#090E1A</Color>
    <Color x:Key="CardBgColor">#111827</Color>
    <Color x:Key="CardAltBgColor">#172033</Color>
    <Color x:Key="TopBarBgColor">#0D1322</Color>

    <!-- Borders -->
    <Color x:Key="BorderLightColor">#1F2D46</Color>
    <Color x:Key="BorderMediumColor">#2F4264</Color>
    <Color x:Key="BorderStrongColor">#334668</Color>
    <Color x:Key="TopBarBorderColor">#1A253B</Color>

    <!-- Typography -->
    <Color x:Key="TextDarkColor">#F1F5F9</Color>
    <Color x:Key="TextMutedColor">#94A3B8</Color>
    <Color x:Key="TextSubtleColor">#7E93AE</Color>

    <!-- Inputs & Controls -->
    <Color x:Key="InputBgColor">#0B1220</Color>
    <Color x:Key="InputBgHoverColor">#101A2E</Color>
    <Color x:Key="InputBorderColor">#263653</Color>
    <Color x:Key="InputTextColor">#F8FAFC</Color>

    <!-- Tables & Grids (Modern soft Dark selection, clean contrast) -->
    <Color x:Key="TableBgColor">#111827</Color>
    <Color x:Key="TableRowBgColor">#111827</Color>
    <Color x:Key="TableAltRowBgColor">#0E1524</Color>
    <Color x:Key="TableHeaderBgColor">#0C1220</Color>
    <Color x:Key="TableHeaderTextColor">#94A3B8</Color>
    <Color x:Key="TableHeaderBorderColor">#1F2D46</Color>
    <Color x:Key="TableLinesColor">#1A263C</Color>
    <Color x:Key="TableHoverColor">#18243A</Color>
    <Color x:Key="TableSelectionColor">#1E2E54</Color>
    <Color x:Key="TableSelectionHoverColor">#243866</Color>
    <Color x:Key="TableSelectionTextColor">#F8FAFC</Color>

    <!-- Buttons -->
    <Color x:Key="ButtonOutlineBgColor">#141E30</Color>
    <Color x:Key="ButtonOutlineBorderColor">#293B5C</Color>
    <Color x:Key="ButtonOutlineTextColor">#E2E8F0</Color>
    <Color x:Key="ButtonOutlineHoverBgColor">#1C2A44</Color>
    <Color x:Key="GhostHoverColor">#1B2740</Color>

    <!-- Tabs -->
    <Color x:Key="TabItemInactiveTextColor">#94A3B8</Color>
    <Color x:Key="TabItemActiveIndicatorColor">#818CF8</Color>
    <Color x:Key="TabItemActiveTextColor">#A5B4FC</Color>
    <Color x:Key="TabItemHoverBgColor">#172236</Color>
    <Color x:Key="TabStripBorderColor">#1F2D46</Color>

    <!-- Status Pills / Badges -->
    <Color x:Key="PillOrangeBgColor">#422006</Color>
    <Color x:Key="PillOrangeTextColor">#FCD34D</Color>
    <Color x:Key="PillGreenBgColor">#052E24</Color>
    <Color x:Key="PillGreenTextColor">#6EE7B7</Color>
    <Color x:Key="PillBlueBgColor">#172554</Color>
    <Color x:Key="PillBlueTextColor">#93C5FD</Color>
    <Color x:Key="PillPurpleBgColor">#2E1065</Color>
    <Color x:Key="PillPurpleTextColor">#D8B4FE</Color>
    <Color x:Key="PillSlateBgColor">#1E293B</Color>
    <Color x:Key="PillSlateTextColor">#CBD5E1</Color>
    <Color x:Key="PillRedBgColor">#450A0A</Color>
    <Color x:Key="PillRedTextColor">#FCA5A5</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="LightBgBrush" Color="{StaticResource LightBgColor}" />
    <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="CardAltBgBrush" Color="{StaticResource CardAltBgColor}" />
    <SolidColorBrush x:Key="TopBarBgBrush" Color="{StaticResource TopBarBgColor}" />

    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />
    <SolidColorBrush x:Key="BorderMediumBrush" Color="{StaticResource BorderMediumColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TopBarBorderBrush" Color="{StaticResource TopBarBorderColor}" />

    <SolidColorBrush x:Key="TextDarkBrush" Color="{StaticResource TextDarkColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="{StaticResource TextSubtleColor}" />

    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}" />
    <SolidColorBrush x:Key="InputBgHoverBrush" Color="{StaticResource InputBgHoverColor}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />
    <SolidColorBrush x:Key="InputTextBrush" Color="{StaticResource InputTextColor}" />

    <SolidColorBrush x:Key="TableBgBrush" Color="{StaticResource TableBgColor}" />
    <SolidColorBrush x:Key="TableRowBgBrush" Color="{StaticResource TableRowBgColor}" />
    <SolidColorBrush x:Key="TableAltRowBgBrush" Color="{StaticResource TableAltRowBgColor}" />
    <SolidColorBrush x:Key="TableHeaderBgBrush" Color="{StaticResource TableHeaderBgColor}" />
    <SolidColorBrush x:Key="TableHeaderTextBrush" Color="{StaticResource TableHeaderTextColor}" />
    <SolidColorBrush x:Key="TableHeaderBorderBrush" Color="{StaticResource TableHeaderBorderColor}" />
    <SolidColorBrush x:Key="TableLinesBrush" Color="{StaticResource TableLinesColor}" />
    <SolidColorBrush x:Key="TableHoverBrush" Color="{StaticResource TableHoverColor}" />
    <SolidColorBrush x:Key="TableSelectionBrush" Color="{StaticResource TableSelectionColor}" />
    <SolidColorBrush x:Key="TableSelectionHoverBrush" Color="{StaticResource TableSelectionHoverColor}" />
    <SolidColorBrush x:Key="TableSelectionTextBrush" Color="{StaticResource TableSelectionTextColor}" />

    <SolidColorBrush x:Key="ButtonOutlineBgBrush" Color="{StaticResource ButtonOutlineBgColor}" />
    <SolidColorBrush x:Key="ButtonOutlineBorderBrush" Color="{StaticResource ButtonOutlineBorderColor}" />
    <SolidColorBrush x:Key="ButtonOutlineTextBrush" Color="{StaticResource ButtonOutlineTextColor}" />
    <SolidColorBrush x:Key="ButtonOutlineHoverBgBrush" Color="{StaticResource ButtonOutlineHoverBgColor}" />
    <SolidColorBrush x:Key="GhostHoverBrush" Color="{StaticResource GhostHoverColor}" />

    <SolidColorBrush x:Key="TabItemInactiveTextBrush" Color="{StaticResource TabItemInactiveTextColor}" />
    <SolidColorBrush x:Key="TabItemActiveIndicatorBrush" Color="{StaticResource TabItemActiveIndicatorColor}" />
    <SolidColorBrush x:Key="TabItemActiveTextBrush" Color="{StaticResource TabItemActiveTextColor}" />
    <SolidColorBrush x:Key="TabItemHoverBgBrush" Color="{StaticResource TabItemHoverBgColor}" />
    <SolidColorBrush x:Key="TabStripBorderBrush" Color="{StaticResource TabStripBorderColor}" />

    <SolidColorBrush x:Key="PillOrangeBgBrush" Color="{StaticResource PillOrangeBgColor}" />
    <SolidColorBrush x:Key="PillOrangeTextBrush" Color="{StaticResource PillOrangeTextColor}" />
    <SolidColorBrush x:Key="PillGreenBgBrush" Color="{StaticResource PillGreenBgColor}" />
    <SolidColorBrush x:Key="PillGreenTextBrush" Color="{StaticResource PillGreenTextColor}" />
    <SolidColorBrush x:Key="PillBlueBgBrush" Color="{StaticResource PillBlueBgColor}" />
    <SolidColorBrush x:Key="PillBlueTextBrush" Color="{StaticResource PillBlueTextColor}" />
    <SolidColorBrush x:Key="PillPurpleBgBrush" Color="{StaticResource PillPurpleBgColor}" />
    <SolidColorBrush x:Key="PillPurpleTextBrush" Color="{StaticResource PillPurpleTextColor}" />
    <SolidColorBrush x:Key="PillSlateBgBrush" Color="{StaticResource PillSlateBgColor}" />
    <SolidColorBrush x:Key="PillSlateTextBrush" Color="{StaticResource PillSlateTextColor}" />
    <SolidColorBrush x:Key="PillRedBgBrush" Color="{StaticResource PillRedBgColor}" />
    <SolidColorBrush x:Key="PillRedTextBrush" Color="{StaticResource PillRedTextColor}" />

    <!-- ScrollBars & Semantic Surfaces (Dark) -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#2D3E5E" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#475F8A" />
    <SolidColorBrush x:Key="OverlayBackdropBrush" Color="#88040814" />

    <SolidColorBrush x:Key="SurfaceInfoBgBrush" Color="#172554" />
    <SolidColorBrush x:Key="SurfaceInfoBorderBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="SurfaceInfoTextBrush" Color="#93C5FD" />
    <SolidColorBrush x:Key="SurfaceSuccessBgBrush" Color="#052E24" />
    <SolidColorBrush x:Key="SurfaceSuccessBorderBrush" Color="#047857" />
    <SolidColorBrush x:Key="SurfaceSuccessTextBrush" Color="#6EE7B7" />
    <SolidColorBrush x:Key="SurfaceWarningBgBrush" Color="#422006" />
    <SolidColorBrush x:Key="SurfaceWarningBorderBrush" Color="#92400E" />
    <SolidColorBrush x:Key="SurfaceWarningTextBrush" Color="#FCD34D" />
    <SolidColorBrush x:Key="SurfaceDangerBgBrush" Color="#450A0A" />
    <SolidColorBrush x:Key="SurfaceDangerBorderBrush" Color="#991B1B" />
    <SolidColorBrush x:Key="SurfaceDangerTextBrush" Color="#FCA5A5" />
    <SolidColorBrush x:Key="SurfaceAccentBgBrush" Color="#1E1B4B" />
    <SolidColorBrush x:Key="SurfaceAccentBorderBrush" Color="#3730A3" />
    <SolidColorBrush x:Key="SurfaceAccentTextBrush" Color="#A5B4FC" />

    <LinearGradientBrush x:Key="HeroBannerBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#111827" Offset="0" />
        <GradientStop Color="#131E34" Offset="0.6" />
        <GradientStop Color="#191C3A" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.28" />

</ResourceDictionary>

<UserControl x:Class="InternalManagement.Desktop.Views.QuestionBankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- TOOLBAR & FILTERS -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="QuestionSearchBox" Width="280" Height="36" Style="{StaticResource ModernTextBox}" Tag="Tìm câu hỏi / nội dung..." Margin="0,0,12,0" TextChanged="QuestionSearch_TextChanged" />
                                    <TextBlock x:Name="QuestionSearchPlaceholder" Visibility="Collapsed" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Click="RefreshQuestions_Click" Style="{StaticResource OutlineButton}" Height="36" Margin="0,0,8,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Tải Lại" VerticalAlignment="Center"/></StackPanel></Button>
                                    <Button Content="+ Tạo Câu Hỏi Mới" Click="CreateQuestionDialog_Click" Style="{StaticResource PrimaryGradientButton}" Height="36" Padding="16,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- QUESTIONS LIST WITH PUBLICATION WORKFLOW -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="16" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                            <ListView ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent" MaxHeight="620" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardAltBgBrush}" CornerRadius="12" Padding="18,14" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- QUESTION HEADER & BADGES -->
                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource SurfaceAccentBgBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,8,4">
                                                            <TextBlock Text="{Binding BankName}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SurfaceAccentTextBrush}" />
                                                        </Border>
                                                        <Border Background="{DynamicResource SurfaceSuccessBgBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,8,4">
                                                            <TextBlock Text="{Binding SubjectName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SurfaceSuccessTextBrush}" />
                                                        </Border>
                                                        <Border Background="{DynamicResource SurfaceWarningBgBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,8,4">
                                                            <TextBlock Text="{Binding DifficultyLevel, StringFormat='Độ khó: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SurfaceWarningTextBrush}" />
                                                        </Border>
                                                        <Border Background="{DynamicResource PillSlateBgBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding CurrentVersionNumber, StringFormat='Phiên bản v{0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PillSlateTextBrush}" />
                                                        </Border>
                                                    </WrapPanel>

                                                    <!-- STATUS & PUBLISH ACTION -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource PillOrangeBgBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Published">
                                                                            <Setter Property="Background" Value="{DynamicResource PillGreenBgBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource PillOrangeTextBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Published">
                                                                                <Setter Property="Foreground" Value="{DynamicResource PillGreenTextBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <Button Click="PublishQuestion_Click" Tag="{Binding CurrentVersionId}" Style="{StaticResource SuccessButton}" Height="32" FontSize="11.5" Padding="12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE898;" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Xuất Bản (Publish)" Foreground="White" VerticalAlignment="Center"/></StackPanel></Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- QUESTION CONTENT -->
                                                <TextBlock Grid.Row="1" Text="{Binding ContentHtml}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextDarkBrush}" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="20" />

                                                <!-- CHOICES LIST -->
                                                <ItemsControl Grid.Row="2" ItemsSource="{Binding Choices}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                                <Border CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{DynamicResource PillSlateBgBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCorrect}" Value="True">
                                                                                    <Setter Property="Background" Value="#10B981" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource PillSlateTextBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCorrect}" Value="True">
                                                                                        <Setter Property="Foreground" Value="White" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                                <TextBlock Text="{Binding ContentHtml}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="18" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>
</UserControl>

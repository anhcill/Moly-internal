<UserControl x:Class="InternalManagement.Desktop.Views.SyncRunsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- SYNC TRIGGER CONTROLS -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#EEF2FF" CornerRadius="8" Width="30" Height="30" Margin="0,0,10,0">
                            <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE895;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Kích Hoạt Đồng Bộ Dữ Liệu Nguồn Ngoại" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Hệ thống tự động đồng bộ theo cơ chế Cursor, Idempotency và chuyển bản ghi lỗi vào Dead-Letter Queue." Margin="40,4,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚡ Đồng Bộ Courses" Click="TriggerSyncCourses_Click" Style="{StaticResource PrimaryGradientButton}" Margin="0,0,8,0" Height="36" Padding="16,0" />
                    <Button Content="⚡ Đồng Bộ Customers" Click="TriggerSyncCustomers_Click" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Height="36" Padding="14,0" />
                    <Button Click="RefreshSyncRuns_Click" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Height="36" Padding="12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Tải Lại Lịch Sử" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Content="⬇ Xuất CSV" Click="ExportSyncRuns_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="12,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- SYNC RUNS & DEAD-LETTER TABLES -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.2*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="8" Margin="0,0,0,12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <DataGrid x:Name="SyncRunsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="42">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="HỆ THỐNG NGUỒN" Binding="{Binding SourceSystem}" Width="150" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapBoldTextCellStyle}" />
                        <DataGridTextColumn Header="LOẠI THỰC THỂ" Binding="{Binding EntityType}" Width="140" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                        <DataGridTextColumn Header="THỜI ĐIỂM CHẠY" Binding="{Binding StartedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" Width="160" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                        <DataGridTextColumn Header="ĐÃ ĐỌC" Binding="{Binding RecordsRead}" Width="80" />
                        <DataGridTextColumn Header="ĐÃ GHI" Binding="{Binding RecordsWritten}" Width="80" FontWeight="Bold" ElementStyle="{StaticResource DataGridEmeraldTextCellStyle}" />
                        <DataGridTextColumn Header="BỎ QUA" Binding="{Binding RecordsSkipped}" Width="80" />
                        <DataGridTextColumn Header="LỖI" Binding="{Binding RecordsFailed}" Width="70" ElementStyle="{StaticResource DataGridRedTextCellStyle}" FontWeight="Bold" />
                        <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusLabel}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="4,0,4,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FEF2F2" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="DLQ" FontSize="10" FontWeight="Bold" Foreground="#DC2626" />
                                </Border>
                                <TextBlock Text="Dead-Letter Queue — Bản ghi cần xử lý" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Các bản ghi đồng bộ lỗi được giữ lại để kiểm tra và retry có kiểm soát." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Click="RefreshDeadLetters_Click" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Height="34" Padding="12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Tải Dead-Letter" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Content="↻ Retry bản ghi đã chọn" Click="RetryDeadLetter_Click" Style="{StaticResource PrimaryGradientButton}" Height="34" Padding="14,0" />
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="DeadLettersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NGUỒN" Binding="{Binding SourceSystem}" Width="120" FontWeight="Bold" />
                            <DataGridTextColumn Header="LOẠI" Binding="{Binding EntityType}" Width="110" />
                            <DataGridTextColumn Header="MÃ NGUỒN" Binding="{Binding SourceId}" Width="130" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                            <DataGridTextColumn Header="MÃ LỖI" Binding="{Binding ErrorCode}" Width="100" ElementStyle="{StaticResource DataGridRedTextCellStyle}" FontWeight="Bold" />
                            <DataGridTextColumn Header="NỘI DUNG LỖI" Binding="{Binding ErrorMessage}" Width="2*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                            <DataGridTextColumn Header="SỐ LẦN RETRY" Binding="{Binding RetryCount}" Width="100" />
                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding ResolvedLabel}" Width="110" />
                            <DataGridTextColumn Header="TẠO LÚC" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

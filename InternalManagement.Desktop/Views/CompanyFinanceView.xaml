<UserControl x:Class="InternalManagement.Desktop.Views.CompanyFinanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="215" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- COMPACT DATE FILTER BAR -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Effect="{DynamicResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tổng hợp tài chính theo mảng" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource SurfaceAccentBgBrush}" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" BorderBrush="{DynamicResource SurfaceAccentBorderBrush}" BorderThickness="1">
                        <TextBlock Text="Toàn công ty" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SurfaceAccentTextBrush}" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Từ" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                    <DatePicker x:Name="FinanceFromDatePicker" Width="130" Height="32" Margin="0,0,10,0" VerticalContentAlignment="Center" />
                    <TextBlock Text="Đến" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                    <DatePicker x:Name="FinanceToDatePicker" Width="130" Height="32" Margin="0,0,10,0" VerticalContentAlignment="Center" />
                    <Button Click="RefreshCompanyFinance_Click" Style="{StaticResource ModernPrimaryButton}" Height="32" Padding="14,0" Margin="0,0,6,0" Content="Xem" />
                    <Button Click="PrintOverview_Click" Style="{StaticResource OutlineButton}" Height="32" Padding="11,0" Margin="0,0,6,0" Content="In / PDF" ToolTip="Xuất báo cáo tổng hợp theo mảng chuẩn A4 để in / lưu PDF" />
                    <Button Click="ExportOverviewExcel_Click" Style="{StaticResource OutlineButton}" Height="32" Padding="11,0" Content="Xuất Excel" ToolTip="Xuất báo cáo Excel tổng hợp theo mảng (.xlsx)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4 CLEAN KPI CARDS -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="THỰC THU" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="MetricCompanyIncome" Text="0 đ" FontSize="19" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="THỰC CHI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="MetricCompanyExpense" Text="0 đ" FontSize="19" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="DÒNG TIỀN RÒNG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="MetricCompanyNetCash" Text="0 đ" FontSize="19" FontWeight="Bold" Foreground="#3B82F6" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,10" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="LỢI NHUẬN HOẠT ĐỘNG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="MetricCompanyProfit" Text="0 đ" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource SurfaceAccentTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- AREA COMPARISON CHART -->
        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="So sánh Thu – Chi – Lợi nhuận theo mảng" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" />
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock Text="■ Thu" Foreground="#10B981" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,10,0" />
                        <TextBlock Text="■ Chi" Foreground="#EF4444" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,10,0" />
                        <TextBlock Text="■ Lợi nhuận" Foreground="#6366F1" FontSize="10.5" FontWeight="SemiBold" />
                    </WrapPanel>
                </DockPanel>
                <Canvas x:Name="CompanyAreasChartCanvas" Grid.Row="1" Background="{DynamicResource CardAltBgBrush}" SizeChanged="CompanyAreasChartCanvas_SizeChanged" />
            </Grid>
        </Border>

        <!-- DATA GRID -->
        <Border Grid.Row="3" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
            <Grid>
                <DataGrid x:Name="CompanyFinanceAreasDataGrid" MinHeight="220" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource TableLinesBrush}" Background="{DynamicResource TableBgBrush}" BorderThickness="0" MinRowHeight="44">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MẢNG HOẠT ĐỘNG" Binding="{Binding AreaName}" Width="1.8*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapBoldTextCellStyle}" />
                        <DataGridTextColumn Header="TỔNG THU" Binding="{Binding TotalIncome, StringFormat='{}{0:N0} đ'}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapGreenTextCellStyle}" />
                        <DataGridTextColumn Header="TỔNG CHI" Binding="{Binding TotalExpense, StringFormat='{}{0:N0} đ'}" Width="1.2*" ElementStyle="{StaticResource DataGridRedTextCellStyle}" />
                        <DataGridTextColumn Header="DÒNG TIỀN RÒNG" Binding="{Binding NetCashFlow, StringFormat='{}{0:N0} đ'}" Width="1.2*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapBoldTextCellStyle}" />
                        <DataGridTextColumn Header="LỢI NHUẬN" Binding="{Binding OperatingProfit, StringFormat='{}{0:N0} đ'}" Width="1.2*" FontWeight="Bold" ElementStyle="{StaticResource DataGridIndigoTextCellStyle}" />
                        <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding ProfitDataStatusName}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                        <DataGridTextColumn Header="SỐ GD" Binding="{Binding CashTransactionCount}" Width="80" ElementStyle="{StaticResource DataGridTextCellStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="CompanyFinanceEmptyText" Text="Chưa có dữ liệu tài chính trong khoảng thời gian đã chọn." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" />
            </Grid>
        </Border>

        <!-- UNCLASSIFIED WARNING -->
        <Border x:Name="UnclassifiedFinanceWarning" Grid.Row="4" Background="{DynamicResource SurfaceWarningBgBrush}" BorderBrush="{DynamicResource SurfaceWarningBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource SurfaceWarningTextBrush}" Margin="0,0,8,0" />
                <TextBlock x:Name="UnclassifiedFinanceWarningText" TextWrapping="Wrap" Foreground="{DynamicResource SurfaceWarningTextBrush}" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="InternalManagement.Desktop.Views.CompanyFinanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOOLBAR & DATE FILTER -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,16" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Báo Cáo Tài Chính Độc Lập" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                        <Border Background="#EEF2FF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" BorderBrush="#C7D2FE" BorderThickness="1">
                            <TextBlock Text="Toàn công ty" FontSize="11" FontWeight="SemiBold" Foreground="#4F46E5" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Thu, chi, dòng tiền ròng và lợi nhuận được tổng hợp từ sổ tài chính độc lập theo từng phân hệ." FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Từ ngày" FontSize="12.5" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                    <DatePicker x:Name="FinanceFromDatePicker" Width="135" Height="36" Margin="0,0,10,0" VerticalContentAlignment="Center" />
                    <TextBlock Text="Đến ngày" FontSize="12.5" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                    <DatePicker x:Name="FinanceToDatePicker" Width="135" Height="36" Margin="0,0,10,0" VerticalContentAlignment="Center" />
                    <Button Content="📊 Xem báo cáo" Click="RefreshCompanyFinance_Click" Style="{StaticResource ModernPrimaryButton}" Height="36" Padding="16,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4 SAAS KPI SUMMARY CARDS -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <!-- Card 1: Total Income -->
            <Border Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="TỔNG THU" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <Border Grid.Row="0" Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Width="26" Height="26">
                        <TextBlock Text="💰" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="MetricCompanyIncome" Text="0 đ" FontSize="20" FontWeight="Bold" Foreground="#059669" Margin="0,3,0,3" />
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <Border Background="#ECFDF5" CornerRadius="6" Padding="6,1.5" BorderBrush="#A7F3D0" BorderThickness="1">
                            <TextBlock Text="Doanh thu ghi nhận" FontSize="10" FontWeight="SemiBold" Foreground="#059669" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: Total Expense -->
            <Border Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="TỔNG CHI" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <Border Grid.Row="0" Grid.Column="1" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Width="26" Height="26">
                        <TextBlock Text="📉" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="MetricCompanyExpense" Text="0 đ" FontSize="20" FontWeight="Bold" Foreground="#DC2626" Margin="0,3,0,3" />
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <Border Background="#FEF2F2" CornerRadius="6" Padding="6,1.5" BorderBrush="#FECACA" BorderThickness="1">
                            <TextBlock Text="Chi phí hoạt động" FontSize="10" FontWeight="SemiBold" Foreground="#DC2626" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 3: Net Cash Flow -->
            <Border Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DÒNG TIỀN RÒNG" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <Border Grid.Row="0" Grid.Column="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Width="26" Height="26">
                        <TextBlock Text="💳" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="MetricCompanyNetCash" Text="0 đ" FontSize="20" FontWeight="Bold" Foreground="#2563EB" Margin="0,3,0,3" />
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <Border Background="#EFF6FF" CornerRadius="6" Padding="6,1.5" BorderBrush="#BFDBFE" BorderThickness="1">
                            <TextBlock Text="Thực thu trừ thực chi" FontSize="10" FontWeight="SemiBold" Foreground="#0284C7" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 4: Operating Profit -->
            <Border Background="White" CornerRadius="10" Padding="14,10" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="LỢI NHUẬN HOẠT ĐỘNG" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <Border Grid.Row="0" Grid.Column="1" Background="#FAF5FF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="6" Width="26" Height="26">
                        <TextBlock Text="📈" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="MetricCompanyProfit" Text="0 đ" FontSize="20" FontWeight="Bold" Foreground="#7C3AED" Margin="0,3,0,3" />
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <Border Background="#FAF5FF" CornerRadius="6" Padding="6,1.5" BorderBrush="#E9D5FF" BorderThickness="1">
                            <TextBlock Text="Hiệu quả kinh doanh" FontSize="10" FontWeight="SemiBold" Foreground="#7C3AED" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- DATA GRID -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
            <Grid>
                <DataGrid x:Name="CompanyFinanceAreasDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="48">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MẢNG HOẠT ĐỘNG" Binding="{Binding AreaName}" Width="1.8*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapBoldTextCellStyle}" />
                        <DataGridTextColumn Header="TỔNG THU" Binding="{Binding TotalIncome, StringFormat='{}{0:N0} đ'}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapGreenTextCellStyle}" />
                        <DataGridTextColumn Header="TỔNG CHI" Binding="{Binding TotalExpense, StringFormat='{}{0:N0} đ'}" Width="1.2*" ElementStyle="{StaticResource DataGridRedTextCellStyle}" />
                        <DataGridTextColumn Header="DÒNG TIỀN RÒNG" Binding="{Binding NetCashFlow, StringFormat='{}{0:N0} đ'}" Width="1.2*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapBoldTextCellStyle}" />
                        <DataGridTextColumn Header="LỢI NHUẬN" Binding="{Binding OperatingProfit, StringFormat='{}{0:N0} đ'}" Width="1.2*" FontWeight="Bold" ElementStyle="{StaticResource DataGridPurpleTextCellStyle}" />
                        <DataGridTextColumn Header="TRẠNG THÁI DỮ LIỆU" Binding="{Binding ProfitDataStatusName}" Width="1.4*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                        <DataGridTextColumn Header="SỐ GIAO DỊCH" Binding="{Binding CashTransactionCount}" Width="0.9*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="CompanyFinanceEmptyText" Text="Chưa có dữ liệu tài chính trong khoảng thời gian đã chọn." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="14" />
            </Grid>
        </Border>

        <!-- UNCLASSIFIED WARNING -->
        <Border x:Name="UnclassifiedFinanceWarning" Grid.Row="3" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="UnclassifiedFinanceWarningText" TextWrapping="Wrap" Foreground="#92400E" FontSize="12.5" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

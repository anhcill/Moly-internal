<UserControl x:Class="InternalManagement.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StudentRowButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StudentRowDangerButton" TargetType="Button" BasedOn="{StaticResource StudentRowButton}">
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#FECACA" />
            <Setter Property="Background" Value="#FEF2F2" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOOLBAR & SEARCH -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,16" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Học viên &amp; Khách hàng" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                    <TextBlock Text="Học viên đồng bộ trực tiếp từ các lớp học EdTech; thông tin khách hàng đăng ký toàn hệ thống." FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="CustomerSearchBox" Width="280" Height="36" Style="{StaticResource ModernTextBox}" Tag="Tìm tên, SĐT, email..." Margin="0,0,10,0" TextChanged="CustomerSearch_TextChanged" />
                    <Button Click="RefreshCustomers_Click" Style="{StaticResource OutlineButton}" Height="36"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Tải Lại" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Click="AddStudent_Click" Style="{StaticResource ModernPrimaryButton}" Height="36" Padding="14,0" Margin="10,0,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Thêm Học Viên" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DATA TABS -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabItem Header="Học viên từ lớp học" FontWeight="SemiBold">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- ACTION SUB-TOOLBAR -->
                        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="+ Thêm học viên" Click="AddStudent_Click" Style="{StaticResource ModernPrimaryButton}" Height="32" Padding="14,0" Margin="0,0,8,0" />
                                    <Button x:Name="EditStudentButton" Content="✎ Sửa học viên" Click="EditStudent_Click" Style="{StaticResource OutlineButton}" Height="32" Padding="12,0" Margin="0,0,8,0" />
                                    <Button x:Name="DeleteStudentButton" Click="DeleteStudent_Click" Style="{StaticResource OutlineButton}" Foreground="#DC2626" Height="32" Padding="12,0" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Xóa học viên" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="💡 Double-click hoặc bấm nút Thao tác để sửa nhanh thông tin học viên." Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" x:Name="StudentsDataGrid" ItemsSource="{Binding Students}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="46" CanUserResizeColumns="True" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="StudentsDataGrid_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="+ Thêm học viên mới" Click="AddStudent_Click" FontWeight="SemiBold" />
                                    <MenuItem Header="✎ Sửa thông tin &amp; học phí" Click="EditStudent_Click" />
                                    <Separator />
                                    <MenuItem Header="🗑 Xóa học viên khỏi lớp" Click="DeleteStudent_Click" Foreground="#DC2626" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding StudentName}" MinWidth="150" Width="1.5*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapBoldTextCellStyle}" />
                                <DataGridTextColumn Header="SỐ ĐIỆN THOẠI" Binding="{Binding PhoneNumber}" MinWidth="110" Width="120" ElementStyle="{StaticResource DataGridTextCellStyle}" />
                                <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" MinWidth="170" Width="1.8*" ElementStyle="{StaticResource DataGridTextCellStyle}" />
                                <DataGridTextColumn Header="KHÓA HỌC" Binding="{Binding CourseTitle}" MinWidth="150" Width="1.6*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                <DataGridTextColumn Header="LỚP" Binding="{Binding ClassCode}" MinWidth="110" Width="120" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridTextCellStyle}" />
                                <DataGridTextColumn Header="HỌC PHÍ GỐC" Binding="{Binding TuitionFee, StringFormat='{}{0:N0} đ'}" MinWidth="100" Width="110" ElementStyle="{StaticResource DataGridTextCellStyle}" />
                                <DataGridTextColumn Header="GIẢM GIÁ" Binding="{Binding DiscountAmount, StringFormat='{}{0:N0} đ'}" MinWidth="90" Width="100" ElementStyle="{StaticResource DataGridTextCellStyle}" />
                                <DataGridTextColumn Header="CẦN THU" Binding="{Binding PayableAmount, StringFormat='{}{0:N0} đ'}" MinWidth="100" Width="110" ElementStyle="{StaticResource DataGridTextCellStyle}" />
                                <DataGridTextColumn Header="ĐÃ ĐÓNG" Binding="{Binding PaidAmount, StringFormat='{}{0:N0} đ'}" MinWidth="100" Width="110" FontWeight="Bold" ElementStyle="{StaticResource DataGridGreenTextCellStyle}" />
                                <DataGridTextColumn Header="CÒN NỢ" Binding="{Binding DebtAmount, StringFormat='{}{0:N0} đ'}" MinWidth="95" Width="105" FontWeight="Bold" ElementStyle="{StaticResource DataGridAmberTextCellStyle}" />
                                <DataGridTextColumn Header="HẸN TRẢ" Binding="{Binding DebtDueDate, StringFormat='{}{0:dd/MM/yyyy}'}" MinWidth="95" Width="100" ElementStyle="{StaticResource DataGridMutedTextCellStyle}" />
                                <DataGridTemplateColumn Header="THAO TÁC" MinWidth="140" Width="145">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Sửa" Click="EditStudentRow_Click" Style="{StaticResource StudentRowButton}" Margin="0,0,6,0" />
                                                <Button Content="Xóa" Click="DeleteStudentRow_Click" Style="{StaticResource StudentRowDangerButton}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="Khách hàng đăng ký" FontWeight="SemiBold">
                    <Grid Margin="0,8,0,0">
                        <DataGrid x:Name="CustomersDataGrid" ItemsSource="{Binding Customers}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="46" CanUserResizeColumns="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MÃ KHÁCH HÀNG" Binding="{Binding SourceId}" MinWidth="120" Width="135" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridBoldTextCellStyle}" />
                                <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding FullName}" MinWidth="150" Width="1.6*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapBoldTextCellStyle}" />
                                <DataGridTextColumn Header="SỐ ĐIỆN THOẠI" Binding="{Binding PhoneNumber}" MinWidth="110" Width="125" ElementStyle="{StaticResource DataGridTextCellStyle}" />
                                <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" MinWidth="170" Width="1.8*" ElementStyle="{StaticResource DataGridTextCellStyle}" />
                                <DataGridTextColumn Header="GÓI / KHÓA ĐĂNG KÝ" Binding="{Binding SubscriptionCount}" MinWidth="130" Width="145" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridTextCellStyle}" />
                                <DataGridTextColumn Header="TỔNG ĐÃ ĐÓNG" Binding="{Binding TotalPaidAmount, StringFormat='{}{0:N0} đ'}" MinWidth="120" Width="135" FontWeight="Bold" ElementStyle="{StaticResource DataGridGreenTextCellStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>

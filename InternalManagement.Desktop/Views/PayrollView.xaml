<UserControl x:Class="InternalManagement.Desktop.Views.PayrollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:InternalManagement.Desktop.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- PAYROLL KPIS -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=PayrollFunctionTabs}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 0: Tổng kỳ lương -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,10,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="TỔNG KỲ LƯƠNG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <Border Grid.Row="0" Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Width="30" Height="30" HorizontalAlignment="Right">
                        <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE787;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="MetricPayrollTotalPeriods" Text="0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Đã thiết lập trong hệ thống" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                </Grid>
            </Border>

            <!-- Card 1: Quỹ lương Gross -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,10,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="QUỸ LƯƠNG GROSS (KỲ HIỆN TẠI)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <Border Grid.Row="0" Grid.Column="1" Background="#EFF6FF" CornerRadius="8" Width="30" Height="30" HorizontalAlignment="Right">
                        <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE821;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="MetricPayrollTotalGross" Text="0 đ" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Tổng chi phí lương trước giảm trừ" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                </Grid>
            </Border>

            <!-- Card 2: Thực chi lương Net -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,10,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="THỰC CHI LƯƠNG NET" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <Border Grid.Row="0" Grid.Column="1" Background="#ECFDF5" CornerRadius="8" Width="30" Height="30" HorizontalAlignment="Right">
                        <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE8D4;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="MetricPayrollTotalNet" Text="0 đ" FontSize="22" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Tổng thực chi tài khoản nhân sự" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                </Grid>
            </Border>

            <!-- Card 3: Số phiếu lương đã tính -->
            <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="16,14" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="SỐ PHIẾU LƯƠNG ĐÃ TÍNH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <Border Grid.Row="0" Grid.Column="1" Background="#FAF5FF" CornerRadius="8" Width="30" Height="30" HorizontalAlignment="Right">
                        <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE8A5;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="MetricPayrollPayslipsCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Bản ghi phiếu lương snapshot" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- PAYROLL TOOLBAR & PERIOD SELECTOR -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,0,16" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Kỳ lương" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="PayrollPeriodSelectorCombo" Grid.Column="1" Height="36" SelectionChanged="PayrollPeriodSelector_SelectionChanged" VerticalContentAlignment="Center" Margin="0,0,10,0" />
                <Border x:Name="PayrollStatusBadgeBorder" Grid.Column="2" Background="#EEF2FF" CornerRadius="6" Padding="10,6" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="PayrollStatusBadgeText" Text="Draft" FontSize="11" FontWeight="Bold" Foreground="#4F46E5" />
                </Border>
                <Button x:Name="BtnCalculatePayrollShortcut" Grid.Column="3" Content="⚡ Tính lương" Click="CalculatePayroll_Click" Style="{StaticResource PrimaryGradientButton}" Height="36" Padding="14,0" Visibility="Collapsed" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnCancelPayroll" Content="Hủy bản nháp" Click="CancelPayroll_Click" Style="{StaticResource OutlineButton}" Foreground="#DC2626" Height="36" Padding="12,0" Margin="8,0,0,0" Visibility="Collapsed" />
                    <Button x:Name="BtnExportPayroll" Content="⬇ Xuất Excel" Click="ExportPayrollExcel_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="12,0" Margin="8,0,0,0" Visibility="Collapsed" />
                </StackPanel>
                <Button FontFamily="Segoe MDL2 Assets, Segoe UI" Grid.Column="5" Content="&#xE895; Tải lại" Click="RefreshPayroll_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="12,0" />

                <Border Grid.Row="1" Grid.ColumnSpan="6" Background="#F8FAFC" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Lọc phiếu lương" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Grid Grid.Column="1" Height="32" Margin="0,0,10,0">
                            <TextBox x:Name="PayrollSearchBox" Height="32" Style="{StaticResource ModernTextBox}" TextChanged="PayrollSearch_TextChanged" AutomationProperties.Name="Tìm phiếu lương theo mã nhân viên hoặc họ tên" />
                            <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" x:Name="PayrollSearchPlaceholder" Text="&#xE721; Tìm mã nhân viên, họ tên..." IsHitTestVisible="False" Foreground="#94A3B8" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ComboBox x:Name="PayrollDeptFilterCombo" Grid.Column="2" Height="32" VerticalContentAlignment="Center" SelectionChanged="PayrollDeptFilter_SelectionChanged" AutomationProperties.Name="Lọc phiếu lương theo phòng ban">
                            <ComboBoxItem Content="-- Tất cả phòng ban --" IsSelected="True" />
                        </ComboBox>
                        <TextBlock Grid.Column="3" Text="Nhấp đúp một dòng để xem chi tiết hoặc điều chỉnh." FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- PAYROLL FUNCTION TABS -->
        <TabControl x:Name="PayrollFunctionTabs" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="PayrollFunctionTabs_SelectionChanged">
            <TabItem Header="Kỳ lương &amp; Tính lương" FontWeight="SemiBold">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- SECTION TITLE (IMAGE 1) -->
                    <TextBlock Grid.Row="0" x:Name="PayrollPeriodHeaderTitle" Text="Kỳ lương hiện tại — Mảng Thời trang &amp; Giáo dục" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,12" />

                    <!-- 5-STAGE WORKFLOW PIPELINE STEPPER (IMAGE 1) -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Step 1 -->
                            <Border Grid.Column="0" x:Name="PayrollStep1Border" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="8,8" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="PayrollStep1Icon" Text="✓ " FontWeight="Bold" Foreground="#16A34A" />
                                    <TextBlock Text="1. Tính toán" FontWeight="SemiBold" Foreground="#15803D" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <!-- Step 2 -->
                            <Border Grid.Column="1" x:Name="PayrollStep2Border" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="8,8" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="PayrollStep2Icon" Text="✓ " FontWeight="Bold" Foreground="#16A34A" />
                                    <TextBlock Text="2. Gửi duyệt" FontWeight="SemiBold" Foreground="#15803D" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <!-- Step 3 -->
                            <Border Grid.Column="2" x:Name="PayrollStep3Border" Background="#CCFBF1" BorderBrush="#5EEAD4" BorderThickness="1" CornerRadius="6" Padding="8,8" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="PayrollStep3Icon" Text="" FontWeight="Bold" Foreground="#0F766E" />
                                    <TextBlock Text="3. Phê duyệt" FontWeight="Bold" Foreground="#0F766E" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <!-- Step 4 -->
                            <Border Grid.Column="3" x:Name="PayrollStep4Border" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,8" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="PayrollStep4Icon" Text="" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="4. Đã chi" FontWeight="Medium" Foreground="#64748B" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <!-- Step 5 -->
                            <Border Grid.Column="4" x:Name="PayrollStep5Border" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="PayrollStep5Icon" Text="" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="5. Phát hành" FontWeight="Medium" Foreground="#64748B" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ACTION BAR (IMAGE 1: Phê duyệt kỳ lương, Xuất Excel, Xem phiếu chi tiết) -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Danh sách phiếu lương chi tiết" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnApprovePayrollMain" Content="Phê duyệt kỳ lương" Click="ApprovePayroll_Click" Style="{StaticResource ModernPrimaryButton}" Height="36" Padding="16,0" Margin="0,0,8,0" Visibility="Collapsed" />
                            <Button FontFamily="Segoe MDL2 Assets, Segoe UI" x:Name="BtnExportPayrollMain" Content="&#xE8A5; Xuất Excel" Click="ExportPayrollExcel_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="14,0" Margin="0,0,8,0" />
                            <Button x:Name="BtnViewPayslipDetailMain" Content="Xem phiếu chi tiết" Click="ViewPayslipDetail_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="14,0" />
                        </StackPanel>
                    </Grid>

                     <!-- DATA TABLE (IMAGE 1) -->
                    <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <DataGrid x:Name="PayslipsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="44" ScrollViewer.HorizontalScrollBarVisibility="Auto" MouseDoubleClick="PayslipsDataGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MÃ NV" Binding="{Binding EmployeeCode}" Width="105" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapBoldTextCellStyle}" />
                                    <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding EmployeeName}" Width="1.5*" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="HÌNH THỨC" Binding="{Binding EmploymentTypeNameVi}" Width="110" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="NGÀY CÔNG / GIỜ" Binding="{Binding WorkQuantityDisplay}" Width="130" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="LƯƠNG CƠ BẢN" Binding="{Binding PayRateDisplay}" Width="130" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="PHỤ CẤP" Binding="{Binding Allowances, StringFormat='{}{0:N0} đ'}" Width="120" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="THƯỞNG KPI" Binding="{Binding KpiBonus, StringFormat='{}{0:N0} đ'}" Width="120" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="KHẤU TRỪ BHYT" Binding="{Binding HealthInsurance, StringFormat='{}{0:N0} đ'}" Width="130" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="THỰC LĨNH (NET PAY)" Binding="{Binding NetSalary, StringFormat='{}{0:N0} đ'}" Width="160" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapGreenTextCellStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="PayslipsEmptyText" Text="Chưa có phiếu lương cho mảng hoặc kỳ lương đã chọn." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="620" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="PayrollAdjustmentsTab" Header="✎ Chỉnh lương · thưởng/phạt" FontWeight="SemiBold">
                <Grid Margin="12,14,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.35*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ĐIỀU CHỈNH LƯƠNG THEO NHÂN VIÊN" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                                <TextBlock Text="Chọn nhân viên ở bảng dưới. Có thể đổi mức lương hồ sơ hoặc thêm trợ cấp, thưởng, làm thêm và khấu trừ cho riêng kỳ đang chọn." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,12,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnEditPayrollBaseSalary" Content="₫ Chỉnh mức lương" Click="EditPayrollBaseSalary_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="12,0" Margin="0,0,8,0" IsEnabled="False" />
                                <Button Content="▦ Đầu việc / hoa hồng" Click="OpenPayrollWorkEntries_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="12,0" Margin="0,0,8,0" />
                                <Button x:Name="BtnAddPayrollAdjustment" Content="＋ Thêm thưởng / phạt" Click="AddPayrollAdjustment_Click" Style="{StaticResource PrimaryGradientButton}" Height="36" Padding="14,0" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="8" Margin="0,12,0,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <DataGrid x:Name="PayrollAdjustmentEmployeesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="40" SelectionChanged="PayrollAdjustmentEmployees_SelectionChanged" MouseDoubleClick="PayrollAdjustmentEmployees_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MÃ NV" Binding="{Binding EmployeeCode}" Width="0.75*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding EmployeeName}" Width="1.3*" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="MỨC TÍNH" Binding="{Binding PayRateDisplay}" Width="1.1*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="TRỢ CẤP / THƯỞNG KHÁC" Binding="{Binding Allowances, StringFormat='{}{0:N0} đ'}" Width="1.15*" ElementStyle="{StaticResource DataGridWrapSkyTextCellStyle}" />
                                    <DataGridTextColumn Header="THƯỞNG KPI" Binding="{Binding KpiBonus, StringFormat='{}{0:N0} đ'}" Width="0.95*" ElementStyle="{StaticResource DataGridWrapSkyTextCellStyle}" />
                                    <DataGridTextColumn Header="KHẤU TRỪ" Binding="{Binding TotalDeductions, StringFormat='{}{0:N0} đ'}" Width="1*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="THỰC LĨNH" Binding="{Binding NetSalary, StringFormat='{}{0:N0} đ'}" Width="1.1*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapGreenTextCellStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="PayrollAdjustmentEmployeesEmptyText" Text="Kỳ lương chưa có phiếu. Hãy tính lương trước khi điều chỉnh." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PayrollAdjustmentSelectionText" Text="Chọn một nhân viên để xem các khoản đã điều chỉnh." FontSize="11.5" Foreground="#1E40AF" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="BtnDeletePayrollAdjustment" Grid.Column="1" Content="Xóa khoản đã chọn" Click="DeleteSelectedPayrollAdjustment_Click" Style="{StaticResource OutlineButton}" Height="32" Padding="12,0" IsEnabled="False" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="8" Margin="0,10,0,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <DataGrid x:Name="PayrollAdjustmentsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="36" SelectionChanged="PayrollAdjustments_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="LOẠI KHOẢN" Binding="{Binding TypeNameVi}" Width="1.1*" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="TÁC ĐỘNG" Binding="{Binding AmountEffectDisplay}" Width="1*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapSkyTextCellStyle}" />
                                    <DataGridTextColumn Header="LÝ DO" Binding="{Binding Reason}" Width="2*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="THỜI GIAN GHI" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="1.15*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="PayrollAdjustmentsEmptyText" Text="Nhân viên này chưa có khoản điều chỉnh trong kỳ." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="PayrollCreateTab" Header="＋ Tạo kỳ lương" FontWeight="SemiBold">
                <Grid Margin="12,14,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TẠO KỲ LƯƠNG MỚI" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                            <TextBlock Text="Tạo kỳ ở đúng mảng đang chọn. Sau đó vào Bảng tính lương để tính công và sinh phiếu lương." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18" Margin="0,12,0,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,12">
                                <TextBlock Text="Tên kỳ lương *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" />
                                <TextBox x:Name="PayrollCreateNameBox" Height="36" Style="{StaticResource ModernTextBox}" Tag="Ví dụ: Kỳ lương tháng 09/2026" Margin="0,5,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Đơn vị / mảng áp dụng *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" />
                                <ComboBox x:Name="PayrollCreateBusinessUnitCombo" Height="36" Margin="0,5,0,0" VerticalContentAlignment="Center" DisplayMemberPath="Label" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Từ ngày *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" />
                                <DatePicker x:Name="PayrollCreateStartDatePicker" Height="36" Margin="0,5,0,0" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="Đến ngày *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" />
                                <DatePicker x:Name="PayrollCreateEndDatePicker" Height="36" Margin="0,5,0,0" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="BtnCreatePayrollPeriod" Grid.Row="1" Grid.Column="3" Content="＋ Tạo bảng lương" Click="CreatePayrollPeriod_Click" Style="{StaticResource PrimaryGradientButton}" Height="36" Padding="16,0" VerticalAlignment="Bottom" />

                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                                <TextBlock Text="Kỳ mới luôn bắt đầu ở trạng thái Bản nháp. Hệ thống chỉ lấy dữ liệu nhân sự thuộc đơn vị đã chọn, giúp không trộn lương giữa Giáo dục và Fashion." FontSize="11.5" Foreground="#1E40AF" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem FontFamily="Segoe MDL2 Assets, Segoe UI" x:Name="PayrollMonthlySummaryTab" Header="&#xE787; Tổng hợp theo tháng" FontWeight="SemiBold">
                <Grid Margin="12,14,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="160" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Năm báo cáo:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="PayrollSummaryYearCombo" Grid.Column="1" Height="34" VerticalContentAlignment="Center" SelectionChanged="PayrollSummaryYear_SelectionChanged" />
                            <TextBlock x:Name="PayrollMonthlySummaryText" Grid.Column="2" Text="Chọn một tháng để xem danh sách người nhận lương." FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="14,0,10,0" TextWrapping="Wrap" />
                            <Button FontFamily="Segoe MDL2 Assets, Segoe UI" Grid.Column="3" Content="&#xE895; Tải báo cáo" Click="RefreshPayrollMonthlySummary_Click" Style="{StaticResource OutlineButton}" Height="34" Padding="12,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="8" Margin="0,12,0,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <DataGrid x:Name="PayrollMonthlySummaryDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" SelectionChanged="PayrollMonthlySummary_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="THÁNG" Binding="{Binding MonthLabel}" Width="0.7*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                <DataGridTextColumn Header="KỲ LƯƠNG" Binding="{Binding PeriodName}" Width="1.5*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusLabel}" Width="1*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                <DataGridTextColumn Header="NGƯỜI NHẬN" Binding="{Binding RecipientCount}" Width="0.9*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                <DataGridTextColumn Header="TỔNG GROSS" Binding="{Binding TotalGrossLabel}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapSkyTextCellStyle}" />
                                <DataGridTextColumn Header="TỔNG NET" Binding="{Binding TotalNetLabel}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapGreenTextCellStyle}" />
                                <DataGridTextColumn Header="TÍNH LƯƠNG LÚC" Binding="{Binding CalculatedAtLabel}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="8" Margin="0,12,0,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="DANH SÁCH NGƯỜI NHẬN LƯƠNG" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="4,2,4,8" />
                            <DataGrid x:Name="PayrollMonthlyRecipientsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="38" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MÃ NV" Binding="{Binding EmployeeCode}" Width="0.85*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding EmployeeName}" Width="1.25*" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="PHÒNG BAN" Binding="{Binding DepartmentName}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="TỔNG THU NHẬP" Binding="{Binding TotalIncome, StringFormat='{}{0:N0} đ'}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapSkyTextCellStyle}" />
                                    <DataGridTextColumn Header="KHẤU TRỪ" Binding="{Binding TotalDeductions, StringFormat='{}{0:N0} đ'}" Width="1.1*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="THỰC LĨNH NET" Binding="{Binding NetSalary, StringFormat='{}{0:N0} đ'}" Width="1.25*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapGreenTextCellStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="PayrollMonthlyRecipientsEmptyText" Grid.Row="1" Text="Chưa có danh sách người nhận lương cho tháng đã chọn." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem FontFamily="Segoe MDL2 Assets, Segoe UI" x:Name="PayrollReviewTab" Header="&#xE721; Xem xét &amp; gửi duyệt" FontWeight="SemiBold">
                <Grid Margin="12,14,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="BƯỚC 2 · KIỂM TRA VÀ GỬI DUYỆT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                            <TextBlock x:Name="PayrollReviewExplanation" Text="Sau khi tính lương, mở tab Bảng tính lương để kiểm tra từng nhân viên. Khi số liệu đúng, xác nhận gửi duyệt để khóa điều chỉnh." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,12,0,12">
                        <WrapPanel HorizontalAlignment="Left">
                            <Button x:Name="BtnCalculatePayroll" Content="⚡ Bước 1: Tính lương &amp; mở bảng kiểm tra" Click="CalculatePayroll_Click" Style="{StaticResource PrimaryGradientButton}" Margin="0,0,8,0" Height="36" Padding="12,0" Visibility="Collapsed" />
                            <Button x:Name="BtnSubmitReview" Content="✓ Bước 2: Xác nhận gửi duyệt" Click="SubmitReview_Click" Style="{StaticResource PrimaryGradientButton}" Height="36" Padding="12,0" Visibility="Collapsed" />
                        </WrapPanel>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,10,0,0">
                            <TextBlock Text="Cách kiểm tra nhanh: mở tab “Bảng tính lương”, đối chiếu từng nhân viên; nhấp đúp một dòng khi cần xem chi tiết. Quay lại đây chỉ khi đã kiểm tra xong." FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,12">
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="SỐ PHIẾU CẦN XEM" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" /><TextBlock x:Name="PayrollReviewPayslipCountText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#2563EB" Margin="0,3,0,0" /></StackPanel>
                        </Border>
                        <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="KHOẢN ĐIỀU CHỈNH" FontSize="10" FontWeight="Bold" Foreground="#92400E" /><TextBlock x:Name="PayrollReviewAdjustmentCountText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#D97706" Margin="0,3,0,0" /></StackPanel>
                        </Border>
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <StackPanel><TextBlock Text="TỔNG THỰC LĨNH" FontSize="10" FontWeight="Bold" Foreground="#166534" /><TextBlock x:Name="PayrollReviewNetText" Text="0 đ" FontSize="18" FontWeight="Bold" Foreground="#059669" Margin="0,3,0,0" /></StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="CÁC KHOẢN ĐIỀU CHỈNH CẦN ĐỐI CHIẾU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="4,2,4,8" />
                            <Grid Grid.Row="1">
                                <DataGrid x:Name="PayrollReviewAdjustmentsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="36" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="MÃ NV" Binding="{Binding EmployeeCode}" Width="0.75*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                        <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding EmployeeName}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                        <DataGridTextColumn Header="LOẠI KHOẢN" Binding="{Binding TypeNameVi}" Width="1.1*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                        <DataGridTextColumn Header="TÁC ĐỘNG" Binding="{Binding AmountEffectDisplay}" Width="1*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapSkyTextCellStyle}" />
                                        <DataGridTextColumn Header="LÝ DO" Binding="{Binding Reason}" Width="1.8*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="PayrollReviewAdjustmentsEmptyText" Text="Kỳ lương chưa có khoản thưởng, trợ cấp hoặc khấu trừ thủ công." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="PayrollApprovalTab" Header="✓ Duyệt · chi · phát hành" FontWeight="SemiBold">
                <Grid Margin="12,14,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="DUYỆT, XÁC NHẬN CHI VÀ PHÁT HÀNH" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                            <TextBlock x:Name="PayrollWorkflowExplanation" Text="Chọn kỳ lương, thực hiện đúng bước đang mở; các bước đã chốt sẽ không thể sửa dữ liệu." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <WrapPanel Grid.Row="1" Margin="0,12,0,12" HorizontalAlignment="Left">
                        <Button x:Name="BtnApprovePayroll" Content="✅ Phê Duyệt" Click="ApprovePayroll_Click" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Height="36" Padding="12,0" Visibility="Collapsed" />
                        <Button FontFamily="Segoe MDL2 Assets, Segoe UI" x:Name="BtnMarkPaid" Content="&#xE8D4; Đã Chi Lương" Click="MarkPaid_Click" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Height="36" Padding="12,0" Visibility="Collapsed" />
                        <Button FontFamily="Segoe MDL2 Assets, Segoe UI" x:Name="BtnPublishPayroll" Content="&#xE789; Phát Hành" Click="PublishPayroll_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="12,0" Visibility="Collapsed" />
                    </WrapPanel>

                    <UniformGrid Grid.Row="2" Columns="5" VerticalAlignment="Top">
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="01" FontSize="18" FontWeight="Bold" Foreground="#2563EB" /><TextBlock Text="Tính lương" FontWeight="SemiBold" FontSize="12" Foreground="#1E3A8A" /><TextBlock Text="Chấm công + thu nhập" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="02" FontSize="18" FontWeight="Bold" Foreground="#D97706" /><TextBlock Text="Trình duyệt" FontWeight="SemiBold" FontSize="12" Foreground="#92400E" /><TextBlock Text="Khóa điều chỉnh" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="03" FontSize="18" FontWeight="Bold" Foreground="#16A34A" /><TextBlock Text="Phê duyệt" FontWeight="SemiBold" FontSize="12" Foreground="#166534" /><TextBlock Text="Chốt ngân sách" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="04" FontSize="18" FontWeight="Bold" Foreground="#4F46E5" /><TextBlock Text="Chi lương" FontWeight="SemiBold" FontSize="12" Foreground="#3730A3" /><TextBlock Text="Xác nhận giải ngân" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border Background="#FAF5FF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <StackPanel><TextBlock Text="05" FontSize="18" FontWeight="Bold" Foreground="#9333EA" /><TextBlock Text="Phát hành" FontWeight="SemiBold" FontSize="12" Foreground="#6B21A8" /><TextBlock Text="Gửi phiếu lương" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </TabItem>

            <TabItem FontFamily="Segoe MDL2 Assets, Segoe UI" Header="&#xE8F1; Hướng dẫn nghiệp vụ" FontWeight="SemiBold">
                <views:PayrollGuideView x:Name="PayrollGuideView" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

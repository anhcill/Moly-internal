<UserControl x:Class="InternalManagement.Desktop.Views.PayrollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:InternalManagement.Desktop.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- PAYROLL KPIS (COMPACT STAT STRIP) -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=PayrollFunctionTabs}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 0: Tổng kỳ lương -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10,6" Margin="0,0,8,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#F1F5F9" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE787;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#64748B" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="TỔNG KỲ LƯƠNG" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock x:Name="MetricPayrollTotalPeriods" Text="0" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 1: Quỹ lương Gross -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="10,6" Margin="0,0,8,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#EFF6FF" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE821;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2563EB" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="QUỸ LƯƠNG GROSS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock x:Name="MetricPayrollTotalGross" Text="0 đ" FontSize="15" FontWeight="Bold" Foreground="#2563EB" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: Thực chi lương Net -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="10,6" Margin="0,0,8,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#ECFDF5" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE8D4;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#059669" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="THỰC CHI LƯƠNG NET" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock x:Name="MetricPayrollTotalNet" Text="0 đ" FontSize="15" FontWeight="Bold" Foreground="#059669" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 3: Số phiếu lương đã tính -->
            <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="10,6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#FAF5FF" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE8EF;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7C3AED" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="PHIẾU LƯƠNG ĐÃ TÍNH" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock x:Name="MetricPayrollPayslipsCount" Text="0" FontSize="15" FontWeight="Bold" Foreground="#7C3AED" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- PAYROLL TOOLBAR & PERIOD SELECTOR (COMPACT UNIFIED BAR) -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10,6" Margin="0,0,0,8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <!-- VÙNG BỘ LỌC (TRÁI) -->
                <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Kỳ lương:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="PayrollPeriodSelectorCombo" Width="200" Height="30" FontSize="12" SelectionChanged="PayrollPeriodSelector_SelectionChanged" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                    <Border x:Name="PayrollStatusBadgeBorder" Background="#EEF2FF" CornerRadius="5" Padding="8,4" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="PayrollStatusBadgeText" Text="Draft" FontSize="10.5" FontWeight="Bold" Foreground="#4F46E5" />
                    </Border>

                    <Rectangle Width="1" Height="18" Fill="#E2E8F0" VerticalAlignment="Center" Margin="0,0,10,0" />

                    <!-- Search Box -->
                    <Grid Width="200" Height="30" Margin="0,0,6,0">
                        <TextBox x:Name="PayrollSearchBox" Height="30" Style="{StaticResource ModernTextBox}" FontSize="12" Padding="28,0,8,0" VerticalContentAlignment="Center" TextChanged="PayrollSearch_TextChanged" AutomationProperties.Name="Tìm phiếu lương theo mã nhân viên hoặc họ tên" />
                        <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE721;" Foreground="#94A3B8" FontSize="11" Margin="9,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <TextBlock x:Name="PayrollSearchPlaceholder" Text="Tìm mã NV, họ tên..." IsHitTestVisible="False" Foreground="#94A3B8" Margin="28,0,0,0" FontSize="11.5" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Dept Filter -->
                    <ComboBox x:Name="PayrollDeptFilterCombo" Width="170" Height="30" FontSize="12" VerticalContentAlignment="Center" SelectionChanged="PayrollDeptFilter_SelectionChanged" AutomationProperties.Name="Lọc phiếu lương theo phòng ban">
                        <ComboBoxItem Content="-- Tất cả phòng ban --" IsSelected="True" />
                    </ComboBox>
                </WrapPanel>

                <!-- VÙNG THAO TÁC (PHẢI) -->
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="BtnCalculatePayrollShortcut" Content="⚡ Tính lương" Click="CalculatePayroll_Click" Style="{StaticResource PrimaryGradientButton}" Height="30" Padding="10,0" Margin="0,0,6,0" Visibility="Collapsed" />
                    <Button x:Name="BtnCancelPayroll" Content="Hủy nháp" Click="CancelPayroll_Click" Style="{StaticResource OutlineButton}" Foreground="#DC2626" Height="30" Padding="10,0" Margin="0,0,6,0" Visibility="Collapsed" />
                    <Button x:Name="BtnExportPayroll" Content="⬇ Xuất Excel" Click="ExportPayrollExcel_Click" Style="{StaticResource OutlineButton}" Height="30" Padding="10,0" Margin="0,0,6,0" Visibility="Collapsed" />
                    <Button Click="RefreshPayroll_Click" Style="{StaticResource OutlineButton}" Height="30" Padding="10,0" ToolTip="Tải lại danh sách kỳ lương và phiếu lương">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" Margin="0,0,5,0" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="Tải lại" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- PAYROLL FUNCTION TABS -->
        <TabControl x:Name="PayrollFunctionTabs" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="PayrollFunctionTabs_SelectionChanged">
            <TabItem FontWeight="SemiBold">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE809;" FontSize="12.5" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#4F46E5" />
                        <TextBlock Text="Bảng tính lương" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- WORKFLOW STEPPER & PERIOD TITLE BAR (COMPACT) -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,0,6">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="PayrollPeriodHeaderTitle" Text="Kỳ lương hiện tại — Mảng Thời trang &amp; Giáo dục" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="2,0,16,0" />
                            <Grid HorizontalAlignment="Right">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Step 1 -->
                                <Border Grid.Column="0" x:Name="PayrollStep1Border" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="PayrollStep1Icon" Text="✓ " FontWeight="Bold" Foreground="#16A34A" FontSize="10.5" />
                                        <TextBlock Text="1. Tính toán" FontWeight="SemiBold" Foreground="#15803D" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <!-- Step 2 -->
                                <Border Grid.Column="1" x:Name="PayrollStep2Border" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="PayrollStep2Icon" Text="✓ " FontWeight="Bold" Foreground="#16A34A" FontSize="10.5" />
                                        <TextBlock Text="2. Gửi duyệt" FontWeight="SemiBold" Foreground="#15803D" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <!-- Step 3 -->
                                <Border Grid.Column="2" x:Name="PayrollStep3Border" Background="#CCFBF1" BorderBrush="#5EEAD4" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="PayrollStep3Icon" Text="" FontWeight="Bold" Foreground="#0F766E" FontSize="10.5" />
                                        <TextBlock Text="3. Phê duyệt" FontWeight="Bold" Foreground="#0F766E" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <!-- Step 4 -->
                                <Border Grid.Column="3" x:Name="PayrollStep4Border" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="PayrollStep4Icon" Text="" FontWeight="Bold" Foreground="#64748B" FontSize="10.5" />
                                        <TextBlock Text="4. Đã chi" FontWeight="Medium" Foreground="#64748B" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <!-- Step 5 -->
                                <Border Grid.Column="4" x:Name="PayrollStep5Border" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="8,3">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="PayrollStep5Icon" Text="" FontWeight="Bold" Foreground="#64748B" FontSize="10.5" />
                                        <TextBlock Text="5. Phát hành" FontWeight="Medium" Foreground="#64748B" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- ACTION BAR (COMPACT) -->
                    <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Danh sách phiếu lương chi tiết" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                            <TextBlock Text=" · Nhấp đúp để xem chi tiết" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnApprovePayrollMain" Content="Phê duyệt kỳ lương" Click="ApprovePayroll_Click" Style="{StaticResource ModernPrimaryButton}" Height="28" Padding="12,0" Margin="0,0,6,0" FontSize="11.5" Visibility="Collapsed" />
                            <Button x:Name="BtnExportPayrollMain" Click="ExportPayrollExcel_Click" Style="{StaticResource OutlineButton}" Height="28" Padding="10,0" Margin="0,0,6,0" FontSize="11.5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE809;" Margin="0,0,5,0" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="Xuất Excel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnViewPayslipDetailMain" Content="Xem phiếu chi tiết" Click="ViewPayslipDetail_Click" Style="{StaticResource OutlineButton}" Height="28" Padding="10,0" FontSize="11.5" />
                        </StackPanel>
                    </DockPanel>

                    <!-- DATA TABLE (MAXIMIZED VERTICAL SPACE) -->
                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <DataGrid x:Name="PayslipsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="36" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="PayslipsDataGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MÃ NV" Binding="{Binding EmployeeCode}" Width="105" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapBoldTextCellStyle}" />
                                    <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding EmployeeName}" Width="1.5*" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="HÌNH THỨC" Binding="{Binding EmploymentTypeNameVi}" Width="110" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="NGÀY CÔNG / GIỜ" Binding="{Binding WorkQuantityDisplay}" Width="130" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="LƯƠNG CƠ BẢN" Binding="{Binding PayRateDisplay}" Width="130" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="PHỤ CẤP" Binding="{Binding Allowances, StringFormat='{}{0:N0} đ'}" Width="120" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="THƯỞNG KPI" Binding="{Binding KpiBonus, StringFormat='{}{0:N0} đ'}" Width="120" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="KHẤU TRỪ BHYT" Binding="{Binding HealthInsurance, StringFormat='{}{0:N0} đ'}" Width="130" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="THỰC LĨNH (NET PAY)" Binding="{Binding NetSalary, StringFormat='{}{0:N0} đ'}" Width="160" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapGreenTextCellStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="PayslipsEmptyText" Text="Chưa có phiếu lương cho mảng hoặc kỳ lương đã chọn." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="620" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="PayrollAdjustmentsTab" FontWeight="SemiBold">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="12.5" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#D97706" />
                        <TextBlock Text="Chỉnh lương · thưởng/phạt" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="10,6" Margin="0,0,0,6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ĐIỀU CHỈNH LƯƠNG THEO NHÂN VIÊN" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                                <TextBlock Text="Chọn nhân sự ở bảng dưới để điều chỉnh mức lương, giờ dạy hoặc thêm thưởng / phạt." FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,8,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnEditPayrollBaseSalary" Content="₫ Chỉnh mức lương" Click="EditPayrollBaseSalary_Click" Style="{StaticResource OutlineButton}" Height="28" Padding="10,0" Margin="0,0,6,0" FontSize="11.5" IsEnabled="False" />
                                <Button Content="◷ Sửa giờ dạy" Click="EditPayrollTeachingHours_Click" Style="{StaticResource OutlineButton}" Height="28" Padding="10,0" Margin="0,0,6,0" FontSize="11.5" />
                                <Button Content="▦ Đầu việc / hoa hồng" Click="OpenPayrollWorkEntries_Click" Style="{StaticResource OutlineButton}" Height="28" Padding="10,0" Margin="0,0,6,0" FontSize="11.5" />
                                <Button x:Name="BtnAddPayrollAdjustment" Content="＋ Thêm thưởng / phạt" Click="AddPayrollAdjustment_Click" Style="{StaticResource PrimaryGradientButton}" Height="28" Padding="12,0" FontSize="11.5" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="6" Margin="0,0,0,6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <DataGrid x:Name="PayrollAdjustmentEmployeesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="34" SelectionChanged="PayrollAdjustmentEmployees_SelectionChanged" MouseDoubleClick="PayrollAdjustmentEmployees_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MÃ NV" Binding="{Binding EmployeeCode}" Width="0.75*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding EmployeeName}" Width="1.3*" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="MỨC TÍNH" Binding="{Binding PayRateDisplay}" Width="1.1*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="TRỢ CẤP / THƯỞNG KHÁC" Binding="{Binding Allowances, StringFormat='{}{0:N0} đ'}" Width="1.15*" ElementStyle="{StaticResource DataGridWrapSkyTextCellStyle}" />
                                    <DataGridTextColumn Header="THƯỞNG KPI" Binding="{Binding KpiBonus, StringFormat='{}{0:N0} đ'}" Width="0.95*" ElementStyle="{StaticResource DataGridWrapSkyTextCellStyle}" />
                                    <DataGridTextColumn Header="KHẤU TRỪ" Binding="{Binding TotalDeductions, StringFormat='{}{0:N0} đ'}" Width="1*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="THỰC LĨNH" Binding="{Binding NetSalary, StringFormat='{}{0:N0} đ'}" Width="1.1*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapGreenTextCellStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="PayrollAdjustmentEmployeesEmptyText" Text="Kỳ lương chưa có phiếu. Hãy tính lương trước khi điều chỉnh." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PayrollAdjustmentSelectionText" Text="Chọn một nhân viên để xem các khoản đã điều chỉnh." FontSize="11" Foreground="#1E40AF" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="BtnDeletePayrollAdjustment" Grid.Column="1" Content="Xóa khoản đã chọn" Click="DeleteSelectedPayrollAdjustment_Click" Style="{StaticResource OutlineButton}" Height="26" Padding="10,0" FontSize="11" IsEnabled="False" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <DataGrid x:Name="PayrollAdjustmentsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="32" SelectionChanged="PayrollAdjustments_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="LOẠI KHOẢN" Binding="{Binding TypeNameVi}" Width="1.1*" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="TÁC ĐỘNG" Binding="{Binding AmountEffectDisplay}" Width="1*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapSkyTextCellStyle}" />
                                    <DataGridTextColumn Header="LÝ DO" Binding="{Binding Reason}" Width="2*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="THỜI GIAN GHI" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="1.15*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="PayrollAdjustmentsEmptyText" Text="Nhân viên này chưa có khoản điều chỉnh trong kỳ." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="PayrollCreateTab" FontWeight="SemiBold">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="12.5" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#16A34A" />
                        <TextBlock Text="Tạo kỳ lương" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,0,6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TẠO KỲ LƯƠNG MỚI" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                            <TextBlock Text="Tạo kỳ ở đúng mảng đang chọn. Sau đó vào Bảng tính lương để tính công và sinh phiếu lương." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,10">
                                <TextBlock Text="Tên kỳ lương *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" />
                                <TextBox x:Name="PayrollCreateNameBox" Height="32" Style="{StaticResource ModernTextBox}" Tag="Ví dụ: Kỳ lương tháng 09/2026" Margin="0,4,0,0" FontSize="12" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Đơn vị / mảng áp dụng *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" />
                                <ComboBox x:Name="PayrollCreateBusinessUnitCombo" Height="32" Margin="0,4,0,0" VerticalContentAlignment="Center" DisplayMemberPath="Label" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Từ ngày *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" />
                                <DatePicker x:Name="PayrollCreateStartDatePicker" Height="32" Margin="0,4,0,0" VerticalContentAlignment="Center" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Đến ngày *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" />
                                <DatePicker x:Name="PayrollCreateEndDatePicker" Height="32" Margin="0,4,0,0" VerticalContentAlignment="Center" FontSize="12" />
                            </StackPanel>
                            <Button x:Name="BtnCreatePayrollPeriod" Grid.Row="1" Grid.Column="3" Content="＋ Tạo bảng lương" Click="CreatePayrollPeriod_Click" Style="{StaticResource PrimaryGradientButton}" Height="32" Padding="14,0" VerticalAlignment="Bottom" FontSize="12" />

                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,10,0,0">
                                <TextBlock Text="Kỳ mới luôn bắt đầu ở trạng thái Bản nháp. Hệ thống chỉ lấy dữ liệu nhân sự thuộc đơn vị đã chọn, giúp không trộn lương giữa Giáo dục và Fashion." FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="PayrollMonthlySummaryTab" FontWeight="SemiBold">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="12.5" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#2563EB" />
                        <TextBlock Text="Tổng hợp tháng" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="130" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="10,6" Margin="0,0,0,6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Năm báo cáo:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="PayrollSummaryYearCombo" Grid.Column="1" Height="30" FontSize="12" VerticalContentAlignment="Center" SelectionChanged="PayrollSummaryYear_SelectionChanged" />
                            <TextBlock x:Name="PayrollMonthlySummaryText" Grid.Column="2" Text="Chọn một tháng để xem danh sách người nhận lương." FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,8,0" TextWrapping="Wrap" />
                            <Button Grid.Column="3" Click="RefreshPayrollMonthlySummary_Click" Style="{StaticResource OutlineButton}" Height="30" Padding="10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" Margin="0,0,5,0" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tải báo cáo" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="6" Margin="0,0,0,6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <DataGrid x:Name="PayrollMonthlySummaryDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" SelectionChanged="PayrollMonthlySummary_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="THÁNG" Binding="{Binding MonthLabel}" Width="0.7*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                <DataGridTextColumn Header="KỲ LƯƠNG" Binding="{Binding PeriodName}" Width="1.5*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusLabel}" Width="1*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                <DataGridTextColumn Header="NGƯỜI NHẬN" Binding="{Binding RecipientCount}" Width="0.9*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                <DataGridTextColumn Header="TỔNG GROSS" Binding="{Binding TotalGrossLabel}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapSkyTextCellStyle}" />
                                <DataGridTextColumn Header="TỔNG NET" Binding="{Binding TotalNetLabel}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapGreenTextCellStyle}" />
                                <DataGridTextColumn Header="TÍNH LƯƠNG LÚC" Binding="{Binding CalculatedAtLabel}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="DANH SÁCH NGƯỜI NHẬN LƯƠNG" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="4,2,4,6" />
                            <DataGrid x:Name="PayrollMonthlyRecipientsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="34" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MÃ NV" Binding="{Binding EmployeeCode}" Width="0.85*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding EmployeeName}" Width="1.25*" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="PHÒNG BAN" Binding="{Binding DepartmentName}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="TỔNG THU NHẬP" Binding="{Binding TotalIncome, StringFormat='{}{0:N0} đ'}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapSkyTextCellStyle}" />
                                    <DataGridTextColumn Header="KHẤU TRỪ" Binding="{Binding TotalDeductions, StringFormat='{}{0:N0} đ'}" Width="1.1*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="THỰC LĨNH NET" Binding="{Binding NetSalary, StringFormat='{}{0:N0} đ'}" Width="1.25*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapGreenTextCellStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="PayrollMonthlyRecipientsEmptyText" Grid.Row="1" Text="Chưa có danh sách người nhận lương cho tháng đã chọn." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="PayrollReviewTab" FontWeight="SemiBold">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C3;" FontSize="12.5" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#0F766E" />
                        <TextBlock Text="Xem xét &amp; gửi duyệt" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="10,6" Margin="0,0,0,6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="BƯỚC 2 · KIỂM TRA VÀ GỬI DUYỆT" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                            <TextBlock x:Name="PayrollReviewExplanation" Text="Sau khi tính lương, mở tab Bảng tính lương để kiểm tra từng nhân viên. Khi số liệu đúng, xác nhận gửi duyệt để khóa điều chỉnh." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,0,0,6">
                        <WrapPanel HorizontalAlignment="Left">
                            <Button x:Name="BtnCalculatePayroll" Content="⚡ Bước 1: Tính lương &amp; mở bảng kiểm tra" Click="CalculatePayroll_Click" Style="{StaticResource PrimaryGradientButton}" Margin="0,0,6,0" Height="30" Padding="10,0" FontSize="11.5" Visibility="Collapsed" />
                            <Button x:Name="BtnSubmitReview" Content="✓ Bước 2: Xác nhận gửi duyệt" Click="SubmitReview_Click" Style="{StaticResource PrimaryGradientButton}" Height="30" Padding="10,0" FontSize="11.5" Visibility="Collapsed" />
                        </WrapPanel>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,6,0,0">
                            <TextBlock Text="Cách kiểm tra nhanh: mở tab “Bảng tính lương”, đối chiếu từng nhân viên; nhấp đúp một dòng khi cần xem chi tiết. Quay lại đây chỉ khi đã kiểm tra xong." FontSize="10.5" Foreground="#1E40AF" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,6">
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,6,0">
                            <StackPanel><TextBlock Text="SỐ PHIẾU CẦN XEM" FontSize="9.5" FontWeight="Bold" Foreground="#1E40AF" /><TextBlock x:Name="PayrollReviewPayslipCountText" Text="0" FontSize="15" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,0" /></StackPanel>
                        </Border>
                        <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,6,0">
                            <StackPanel><TextBlock Text="KHOẢN ĐIỀU CHỈNH" FontSize="9.5" FontWeight="Bold" Foreground="#92400E" /><TextBlock x:Name="PayrollReviewAdjustmentCountText" Text="0" FontSize="15" FontWeight="Bold" Foreground="#D97706" Margin="0,2,0,0" /></StackPanel>
                        </Border>
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <StackPanel><TextBlock Text="TỔNG THỰC LĨNH" FontSize="9.5" FontWeight="Bold" Foreground="#166534" /><TextBlock x:Name="PayrollReviewNetText" Text="0 đ" FontSize="15" FontWeight="Bold" Foreground="#059669" Margin="0,2,0,0" /></StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="CÁC KHOẢN ĐIỀU CHỈNH CẦN ĐỐI CHIẾU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="4,2,4,6" />
                            <Grid Grid.Row="1">
                                <DataGrid x:Name="PayrollReviewAdjustmentsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="34" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="MÃ NV" Binding="{Binding EmployeeCode}" Width="0.75*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                        <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding EmployeeName}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                        <DataGridTextColumn Header="LOẠI KHOẢN" Binding="{Binding TypeNameVi}" Width="1.1*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                        <DataGridTextColumn Header="TÁC ĐỘNG" Binding="{Binding AmountEffectDisplay}" Width="1*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapSkyTextCellStyle}" />
                                        <DataGridTextColumn Header="LÝ DO" Binding="{Binding Reason}" Width="1.8*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="PayrollReviewAdjustmentsEmptyText" Text="Kỳ lương chưa có khoản thưởng, trợ cấp hoặc khấu trừ thủ công." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="PayrollApprovalTab" FontWeight="SemiBold">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D4;" FontSize="12.5" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#9333EA" />
                        <TextBlock Text="Duyệt · chi · phát hành" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="10,6" Margin="0,0,0,6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="DUYỆT, XÁC NHẬN CHI VÀ PHÁT HÀNH" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                            <TextBlock x:Name="PayrollWorkflowExplanation" Text="Chọn kỳ lương, thực hiện đúng bước đang mở; các bước đã chốt sẽ không thể sửa dữ liệu." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,6" HorizontalAlignment="Left">
                        <Button x:Name="BtnApprovePayroll" Content="✅ Phê Duyệt" Click="ApprovePayroll_Click" Style="{StaticResource OutlineButton}" Margin="0,0,6,0" Height="30" Padding="10,0" FontSize="11.5" Visibility="Collapsed" />
                        <Button x:Name="BtnMarkPaid" Click="MarkPaid_Click" Style="{StaticResource OutlineButton}" Margin="0,0,6,0" Height="30" Padding="10,0" FontSize="11.5" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D4;" Margin="0,0,5,0" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Đã Chi Lương" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnPublishPayroll" Click="PublishPayroll_Click" Style="{StaticResource OutlineButton}" Height="30" Padding="10,0" FontSize="11.5" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE789;" Margin="0,0,5,0" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Phát Hành" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <UniformGrid Grid.Row="2" Columns="5" VerticalAlignment="Top">
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                            <StackPanel><TextBlock Text="01" FontSize="15" FontWeight="Bold" Foreground="#2563EB" /><TextBlock Text="Tính lương" FontWeight="SemiBold" FontSize="11.5" Foreground="#1E3A8A" /><TextBlock Text="Chấm công + thu nhập" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                            <StackPanel><TextBlock Text="02" FontSize="15" FontWeight="Bold" Foreground="#D97706" /><TextBlock Text="Trình duyệt" FontWeight="SemiBold" FontSize="11.5" Foreground="#92400E" /><TextBlock Text="Khóa điều chỉnh" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                            <StackPanel><TextBlock Text="03" FontSize="15" FontWeight="Bold" Foreground="#16A34A" /><TextBlock Text="Phê duyệt" FontWeight="SemiBold" FontSize="11.5" Foreground="#166534" /><TextBlock Text="Chốt ngân sách" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                            <StackPanel><TextBlock Text="04" FontSize="15" FontWeight="Bold" Foreground="#4F46E5" /><TextBlock Text="Chi lương" FontWeight="SemiBold" FontSize="11.5" Foreground="#3730A3" /><TextBlock Text="Xác nhận giải ngân" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border Background="#FAF5FF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <StackPanel><TextBlock Text="05" FontSize="15" FontWeight="Bold" Foreground="#9333EA" /><TextBlock Text="Phát hành" FontWeight="SemiBold" FontSize="11.5" Foreground="#6B21A8" /><TextBlock Text="Gửi phiếu lương" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </TabItem>

            <TabItem FontWeight="SemiBold">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE897;" FontSize="12.5" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#64748B" />
                        <TextBlock Text="Hướng dẫn" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:PayrollGuideView x:Name="PayrollGuideView" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

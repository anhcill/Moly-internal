<UserControl x:Class="InternalManagement.Desktop.Views.PayrollGuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" CornerRadius="12" Padding="20" Margin="0,14,0,0"
            BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="HƯỚNG DẪN VẬN HÀNH" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource TextDarkBrush}" />
            <TextBlock Text="1. Giáo viên theo giờ: khai báo đơn giá trong hồ sơ, gán giáo viên vào lớp và tạo các buổi học có giờ bắt đầu/kết thúc. Khi tính kỳ lương, hệ thống cộng giờ của các buổi trong kỳ (trừ buổi hủy) × đơn giá.&#xA;2. Nếu giờ thực dạy khác lịch, chọn giáo viên trong Điều chỉnh lương rồi bấm Sửa giờ dạy, nhập ngày và số giờ. Giờ chấm công sẽ thay giờ của buổi học trong ngày đó; kỳ lương nháp được tính lại ngay.&#xA;3. Với cộng tác viên theo sản phẩm, mở Đầu việc &amp; tiền công, chọn nhân sự và ghi số đề/dự án/đơn/người marketing kiếm được cùng mã tham chiếu và đơn giá. Khoản tiền tự cộng ngay khi nhập; kỳ nháp sẽ cộng khi tính lương lần đầu.&#xA;4. Vào Bảng tính lương, double-click nhân sự để xem giờ công, lương thời gian và tiền công đầu việc tách riêng. Ghi các khoản điều chỉnh khác kèm lý do; hủy đầu việc sai để giữ lịch sử.&#xA;5. Sau khi gửi duyệt, hệ thống khóa thêm/hủy đầu việc và điều chỉnh. Thực hiện Phê duyệt → Đã chi lương → Phát hành theo trạng thái được mở."
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                       LineHeight="24" Margin="0,12,0,0" />
            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                    CornerRadius="10" Padding="12" Margin="0,16,0,0">
                <TextBlock Text="Mỗi đầu việc chỉ được ghi một lần cho cùng nhân sự, loại việc và mã tham chiếu. Khi kỳ đã gửi duyệt hoặc chi lương, không tự ý tính lại hay thay đổi dữ liệu."
                           FontSize="12" Foreground="#92400E" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>

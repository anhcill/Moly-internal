<UserControl x:Class="InternalManagement.Desktop.Views.CourseManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:InternalManagement.Desktop.Controls">
    <UserControl.Resources>
        <Style x:Key="ClassModeSegmentRadioButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource TabItemHoverBgBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource CardBgBrush}" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextDarkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <TabControl x:Name="CourseModuleTabControl" SelectionChanged="CourseModuleTabControl_SelectionChanged">

            <!-- SUB-TAB 1: KHÓA HỌC -->
            <TabItem x:Name="TabItemCourses" Header="Khóa học" FontWeight="SemiBold">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                     <!-- TOOLBAR -->
                     <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                         <DockPanel LastChildFill="False">
                             <!-- VÙNG TÌM KIẾM (BÊN TRÁI) -->
                             <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                 <Grid Width="240" Height="36" Margin="0,2,8,2">
                                     <TextBox x:Name="CourseSearchBox" Style="{StaticResource ModernTextBox}" Height="36" Padding="32,0,10,0" VerticalContentAlignment="Center" FontSize="12.5" TextChanged="CourseSearch_TextChanged" />
                                     <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE721;" Foreground="#94A3B8" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                     <TextBlock x:Name="CourseSearchPlaceholder" Text="Tìm theo tên khóa học..." Foreground="#94A3B8" FontSize="12" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                 </Grid>
                             </WrapPanel>

                             <!-- VÙNG THAO TÁC (BÊN PHẢI) -->
                             <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                 <Button Click="RefreshCourses_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="10,0" Margin="0,2,6,2" ToolTip="Tải lại danh sách khóa học"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Tải lại" VerticalAlignment="Center"/></StackPanel></Button>
                                 <Button Click="ViewCourseClasses_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="10,0" Margin="0,2,6,2" ToolTip="Xem danh sách lớp của khóa học đã chọn"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Xem các lớp" VerticalAlignment="Center"/></StackPanel></Button>
                                 <Button Click="EditCourseDialog_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="10,0" Margin="0,2,6,2" ToolTip="Chỉnh sửa thông tin khóa học"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Sửa" VerticalAlignment="Center"/></StackPanel></Button>
                                 <Button Click="DeleteCourse_Click" Style="{StaticResource DangerOutlineButton}" Height="36" Padding="10,0" Margin="0,2,8,2" ToolTip="Xóa khóa học đã chọn"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Xóa" VerticalAlignment="Center"/></StackPanel></Button>
                                 <Button Click="CreateCourseDialog_Click" Style="{StaticResource PrimaryGradientButton}" Height="36" Padding="14,0" Margin="0,2,0,2"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Tạo khóa học mới" VerticalAlignment="Center"/></StackPanel></Button>
                             </WrapPanel>
                         </DockPanel>
                     </Border>

                    <!-- COURSES DATAGRID -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <DataGrid x:Name="CoursesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource TableLinesBrush}" Background="{DynamicResource TableBgBrush}" BorderThickness="0" MinRowHeight="48" ScrollViewer.HorizontalScrollBarVisibility="Auto" MouseDoubleClick="CoursesDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MÃ NGUỒN" Binding="{Binding CourseSourceId}" Width="120" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                <DataGridTextColumn Header="TÊN KHÓA HỌC" Binding="{Binding Title}" Width="2*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                <DataGridTextColumn Header="SLUG" Binding="{Binding Slug}" Width="1.4*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                <DataGridTextColumn Header="HỌC PHÍ (VND)" Binding="{Binding Price, StringFormat='{}{0:N0} đ'}" Width="130" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridEmeraldTextCellStyle}" />
                                <DataGridTextColumn Header="MODULES" Binding="{Binding ModuleCount}" Width="80" />
                                <DataGridTextColumn Header="SỐ LỚP" Binding="{Binding ClassCount}" Width="80" FontWeight="Bold" />
                                <DataGridTextColumn Header="PHIÊN BẢN" Binding="{Binding Version, StringFormat='v{0}'}" Width="90" />
                                <DataGridTemplateColumn Header="TRẠNG THÁI" Width="135">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:StatusPill Text="{Binding Status}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SUB-TAB 2: LỚP HỌC -->
            <TabItem x:Name="TabItemClasses" Header="Lớp học" FontWeight="SemiBold">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- FILTER BANNER (WHEN FILTERED BY SPECIFIC COURSE) -->
                    <Border Grid.Row="0" x:Name="CscaCourseFilterBanner" Visibility="Collapsed" Background="{DynamicResource SurfaceAccentBgBrush}" BorderBrush="{DynamicResource SurfaceAccentBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#4F46E5" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="LỌC" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <TextBlock x:Name="CscaCourseFilterText" Text="Đang lọc các lớp thuộc khóa học: ..." FontWeight="SemiBold" Foreground="{DynamicResource SurfaceAccentTextBrush}" FontSize="12.5" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕ Xem tất cả các lớp" Click="ClearCscaCourseFilter_Click" Style="{StaticResource OutlineButton}" Height="30" FontSize="11" Padding="10,2" />
                        </Grid>
                    </Border>

                    <!-- Segmented class-mode switcher (Live / Học thử / Record / Tất cả) + compact metrics -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                        <Border Background="{DynamicResource CardAltBgBrush}" CornerRadius="10" Padding="4" Margin="0,0,12,4" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="CscaTabLiveButton" GroupName="CscaClassModeGroup" Style="{StaticResource ClassModeSegmentRadioButton}" IsChecked="True" Checked="CscaClassModeTab_Checked" ToolTip="Các lớp Live chính thức có học phí">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Lớp Live chính thức" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource SurfaceSuccessBgBrush}" BorderBrush="{DynamicResource SurfaceSuccessBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="6,1" Margin="6,0,0,0">
                                            <TextBlock x:Name="CscaLiveCountText" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SurfaceSuccessTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="CscaTabTrialButton" GroupName="CscaClassModeGroup" Style="{StaticResource ClassModeSegmentRadioButton}" Checked="CscaClassModeTab_Checked" ToolTip="Các lớp Học thử miễn phí (0đ)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Lớp Học thử (Miễn phí)" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource SurfaceWarningBgBrush}" BorderBrush="{DynamicResource SurfaceWarningBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="6,1" Margin="6,0,0,0">
                                            <TextBlock x:Name="CscaTrialCountText" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SurfaceWarningTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="CscaTabRecordButton" GroupName="CscaClassModeGroup" Style="{StaticResource ClassModeSegmentRadioButton}" Checked="CscaClassModeTab_Checked" ToolTip="Các lớp Record (kế thừa hoặc video độc lập)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Lớp Record" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource SurfaceInfoBgBrush}" BorderBrush="{DynamicResource SurfaceInfoBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="6,1" Margin="6,0,0,0">
                                            <TextBlock x:Name="CscaRecordCountText" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SurfaceInfoTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="CscaTabAllButton" GroupName="CscaClassModeGroup" Style="{StaticResource ClassModeSegmentRadioButton}" Margin="0" Checked="CscaClassModeTab_Checked" ToolTip="Hiển thị tất cả dạng lớp">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Tất cả" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource PillSlateBgBrush}" CornerRadius="9" Padding="6,1" Margin="6,0,0,0">
                                            <TextBlock x:Name="CscaAllCountText" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PillSlateTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                            </WrapPanel>
                        </Border>

                        <Border Width="168" Height="42" Background="{DynamicResource CardBgBrush}" CornerRadius="9" Padding="10,6" Margin="0,0,8,4" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" Background="{DynamicResource CardAltBgBrush}" CornerRadius="6" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE7BE;" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Số lớp xem" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="7,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" x:Name="MetricCscaClassCount" Text="0" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Width="178" Height="42" Background="{DynamicResource CardBgBrush}" CornerRadius="9" Padding="10,6" Margin="0,0,0,4" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" Background="{DynamicResource SurfaceInfoBgBrush}" CornerRadius="6" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE716;" FontSize="11" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Tổng học viên" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="7,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" x:Name="MetricCscaStudentCount" Text="0" FontSize="17" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </WrapPanel>

                    <!-- TOOLBAR -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <DockPanel LastChildFill="False">
                            <!-- VÙNG TÌM KIẾM & BỘ LỌC (BÊN TRÁI) -->
                            <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Search Box -->
                                <Grid Width="210" Height="36" Margin="0,2,8,2">
                                    <TextBox x:Name="CscaSearchBox" Style="{StaticResource ModernTextBox}" Height="36" Padding="32,0,10,0" VerticalContentAlignment="Center" FontSize="12.5" TextChanged="CscaSearch_TextChanged" />
                                    <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE721;" Foreground="#94A3B8" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                    <TextBlock x:Name="CscaSearchPlaceholder" Text="Tìm mã lớp, tên lớp..." Foreground="#94A3B8" FontSize="12" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>
                                <!-- Course Filter ComboBox -->
                                <ComboBox x:Name="CscaCourseFilterComboBox" Width="195" Height="36" Margin="0,2,8,2" VerticalContentAlignment="Center" DisplayMemberPath="Title" SelectedValuePath="Id" SelectionChanged="CscaCourseFilterComboBox_SelectionChanged" />
                                <ComboBox x:Name="CscaClassTypeFilterComboBox" Visibility="Collapsed" Width="150" Height="36" Margin="0,2,8,2" VerticalContentAlignment="Center" SelectionChanged="CscaClassTypeFilterComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Tất cả dạng lớp" />
                                    <ComboBoxItem Content="Lớp Live chính thức" IsSelected="True" />
                                    <ComboBoxItem Content="Lớp Record" />
                                    <ComboBoxItem Content="Lớp học thử (0đ)" />
                                </ComboBox>
                            </WrapPanel>

                            <!-- VÙNG THAO TÁC (BÊN PHẢI) -->
                            <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button Click="RefreshCsca_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="10,0" Margin="0,2,6,2" ToolTip="Tải lại danh sách lớp"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Tải lại" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Click="EditCscaClass_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="10,0" Margin="0,2,6,2" ToolTip="Chỉnh sửa thông tin lớp đã chọn"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Sửa" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Click="DeleteCscaClass_Click" Style="{StaticResource DangerOutlineButton}" Height="36" Padding="10,0" Margin="0,2,6,2" ToolTip="Xóa lớp đã chọn"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Xóa" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Click="ViewCscaClassDetails_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="10,0" Margin="0,2,8,2" ToolTip="Xem chi tiết lớp học"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Chi tiết" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Click="CreateCscaClassDialog_Click" Style="{StaticResource PrimaryGradientButton}" Height="36" Padding="14,0" Margin="0,2,0,2"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Tạo lớp mới" VerticalAlignment="Center"/></StackPanel></Button>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <!-- CSCA CLASSES DATAGRID -->
                    <Border Grid.Row="3" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <DataGrid x:Name="CscaClassesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource TableLinesBrush}" Background="{DynamicResource TableBgBrush}" BorderThickness="0" MinRowHeight="48" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="CscaClassesDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MÃ LỚP" Binding="{Binding Code}" Width="105" FontWeight="Bold" />
                                <DataGridTemplateColumn Header="LOẠI LỚP" Width="135">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceSuccessBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceSuccessBorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ClassType}" Value="RECORDING">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceInfoBgBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SurfaceInfoBorderBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsTrialEffective}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceWarningBgBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SurfaceWarningBorderBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ClassTypeDisplay}" FontWeight="SemiBold" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SurfaceSuccessTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ClassType}" Value="RECORDING">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SurfaceInfoTextBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsTrialEffective}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SurfaceWarningTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="TÊN LỚP &amp; KHÓA HỌC" Width="1.7*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="2,4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextDarkBrush}" TextWrapping="Wrap" LineHeight="16" />
                                                <TextBlock Text="{Binding CourseTitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ĐỢT" Binding="{Binding Batch}" Width="105" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                <DataGridTextColumn Header="LỊCH HỌC" Binding="{Binding Schedule}" Width="1.3*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                <DataGridTextColumn Header="SĨ SỐ" Binding="{Binding StudentCount}" Width="65" />
                                <DataGridTemplateColumn Header="TRẠNG THÁI" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:StatusPill Text="{Binding Status}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SUB-TAB 3: TÀI CHÍNH LỚP HỌC -->
            <TabItem x:Name="TabItemClassFinance" Header="Tài chính lớp học" FontWeight="SemiBold">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="TÀI CHÍNH THEO LỚP" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" FontSize="13" />
                                <TextBlock x:Name="CscaFinanceScopeText" Text="Tất cả lớp học  •  Double-click một lớp để xem chi tiết học viên &amp; số tiền đóng" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="CscaFinanceCourseFilterComboBox" DockPanel.Dock="Right" Width="230" Height="36" Margin="12,0,0,0" VerticalContentAlignment="Center" DisplayMemberPath="Title" SelectedValuePath="Id" SelectionChanged="CscaFinanceCourseFilterComboBox_SelectionChanged" />
                            <Button DockPanel.Dock="Right" Content="👁 Xem chi tiết học viên" Height="36" Padding="12,0" Margin="12,0,0,0" Style="{StaticResource OutlineButton}" Click="ViewCscaFinanceDetails_Click" ToolTip="Xem danh sách chi tiết học viên và số tiền đóng của lớp đang chọn" />
                        </DockPanel>
                    </Border>
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
                        <!-- Card 3: Doanh thu đã thu -->
                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="DOANH THU ĐÃ THU" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource SurfaceSuccessBgBrush}" CornerRadius="6" Width="26" Height="26" HorizontalAlignment="Right">
                                    <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE8D4;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="MetricCscaRevenue" Text="0 đ" FontSize="20" FontWeight="Bold" Foreground="#059669" Margin="0,3,0,1" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Thực thu ghi nhận" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0" />
                            </Grid>
                        </Border>

                        <!-- Card 4: Số tiền còn nợ -->
                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="SỐ TIỀN CÒN NỢ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource SurfaceWarningBgBrush}" CornerRadius="6" Width="26" Height="26" HorizontalAlignment="Right">
                                    <TextBlock Text="⏳" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="MetricCscaDebt" Text="0 đ" FontSize="20" FontWeight="Bold" Foreground="#D97706" Margin="0,3,0,1" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Cần đối soát công nợ" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0" />
                            </Grid>
                        </Border>

                        <!-- Card 5: Lợi nhuận ròng -->
                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,10" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="THU TRỪ THÙ LAO GIÁO VIÊN" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource SurfaceAccentBgBrush}" CornerRadius="6" Width="26" Height="26" HorizontalAlignment="Right">
                                    <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE9F9;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="MetricCscaNetProfit" Text="0 đ" FontSize="20" FontWeight="Bold" Foreground="#4F46E5" Margin="0,3,0,1" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Doanh thu trừ thù lao" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0" />
                            </Grid>
                        </Border>
                    </UniformGrid>
                    <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <DataGrid x:Name="CscaFinanceDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource TableLinesBrush}" Background="{DynamicResource TableBgBrush}" BorderThickness="0" MinRowHeight="48" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="CscaFinanceDataGrid_MouseDoubleClick" KeyDown="CscaFinanceDataGrid_KeyDown">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MÃ LỚP" Binding="{Binding Code}" Width="105" FontWeight="Bold" />
                                <DataGridTemplateColumn Header="LOẠI LỚP" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceSuccessBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceSuccessBorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ClassType}" Value="RECORDING">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceInfoBgBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SurfaceInfoBorderBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsTrialEffective}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceWarningBgBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SurfaceWarningBorderBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ClassTypeDisplay}" FontWeight="SemiBold" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SurfaceSuccessTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ClassType}" Value="RECORDING">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SurfaceInfoTextBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsTrialEffective}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SurfaceWarningTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="TÊN LỚP" Binding="{Binding Name}" Width="1.5*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                <DataGridTextColumn Header="HỌC PHÍ" Binding="{Binding TuitionFee, StringFormat='{}{0:N0} đ'}" Width="110" />
                                <DataGridTextColumn Header="SĨ SỐ" Binding="{Binding StudentCount}" Width="65" />
                                <DataGridTextColumn Header="ĐÃ THU" Binding="{Binding TotalRevenue, StringFormat='{}{0:N0} đ'}" Width="120" FontWeight="Bold" ElementStyle="{StaticResource DataGridEmeraldTextCellStyle}" />
                                <DataGridTextColumn Header="CÒN NỢ" Binding="{Binding DebtAmount, StringFormat='{}{0:N0} đ'}" Width="115" FontWeight="Bold" ElementStyle="{StaticResource DataGridAmberTextCellStyle}" />
                                <DataGridTextColumn Header="THÙ LAO GV" Binding="{Binding TotalStaffExpense, StringFormat='{}{0:N0} đ'}" Width="115" ElementStyle="{StaticResource DataGridRedTextCellStyle}" />
                                <DataGridTextColumn Header="SAU THÙ LAO GV" Binding="{Binding NetProfit, StringFormat='{}{0:N0} đ'}" Width="135" FontWeight="Bold" ElementStyle="{StaticResource DataGridIndigoTextCellStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SUB-TAB 4: CSCA MOLY -->
            <TabItem x:Name="TabItemCscaMoly" Header="CSCA Moly" FontWeight="SemiBold">
                <TabControl x:Name="CscaMolyTabControl" Margin="0,12,0,0" Background="Transparent" BorderThickness="0" SelectionChanged="CscaMolyTabControl_SelectionChanged">
            <!-- CSCA MOLY: TÀI LIỆU -->
            <TabItem x:Name="TabItemMaterials" Header="Tài liệu" FontWeight="SemiBold">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- HEADER CARD -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Kho tài liệu bài giảng &amp; Giáo trình trực tuyến" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" />
                                <TextBlock Text="Đồng bộ tự động từ hệ thống CSCA Web dành cho học viên và cộng đồng." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource SurfaceAccentBgBrush}" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#4F46E5"><Run FontFamily="Segoe MDL2 Assets" Text="&#xE774;"/><Run Text=" CSCA Web Resource Hub"/></TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <DataGrid x:Name="CscaMaterialsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource TableLinesBrush}" Background="{DynamicResource TableBgBrush}" BorderThickness="0" MinRowHeight="44">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TIÊU ĐỀ" Binding="{Binding Title}" Width="2*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="MÔN" Binding="{Binding Subject}" Width="120" />
                                <DataGridTextColumn Header="CHỦ ĐỀ" Binding="{Binding Topic}" Width="150" />
                                <DataGridTextColumn Header="LOẠI FILE" Binding="{Binding FileType}" Width="90" />
                                <DataGridCheckBoxColumn Header="PREMIUM" Binding="{Binding IsPremium}" Width="85" />
                                <DataGridTextColumn Header="LƯỢT XEM" Binding="{Binding ViewCount}" Width="85" />
                                <DataGridTextColumn Header="LƯỢT TẢI" Binding="{Binding DownloadCount}" Width="85" />
                                <DataGridTextColumn Header="CẬP NHẬT" Binding="{Binding UpdatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- CSCA MOLY: TỪ VỰNG -->
            <TabItem x:Name="TabItemVocabulary" Header="Từ vựng" FontWeight="SemiBold">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- HEADER CARD -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Kho từ vựng chuyên ngành CSCA" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" />
                                <TextBlock Text="Bộ từ điển thuật ngữ HSK, Thương mại và Giao tiếp đa ngôn ngữ phục vụ học tập." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#F0FDF4" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                                <TextBlock Text="🈴 Flashcard Dictionary" FontSize="11" FontWeight="Bold" Foreground="#16A34A" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <DataGrid x:Name="CscaVocabularyDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource TableLinesBrush}" Background="{DynamicResource TableBgBrush}" BorderThickness="0" MinRowHeight="42">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="中文" Binding="{Binding WordChinese}" Width="100" FontWeight="Bold" />
                                <DataGridTextColumn Header="PINYIN" Binding="{Binding Pinyin}" Width="120" />
                                <DataGridTextColumn Header="TIẾNG VIỆT" Binding="{Binding WordVietnamese}" Width="1.4*" />
                                <DataGridTextColumn Header="ENGLISH" Binding="{Binding WordEnglish}" Width="1.2*" />
                                <DataGridTextColumn Header="MÔN" Binding="{Binding Subject}" Width="110" />
                                <DataGridTextColumn Header="CHỦ ĐỀ" Binding="{Binding Topic}" Width="150" />
                                <DataGridCheckBoxColumn Header="PREMIUM" Binding="{Binding IsPremium}" Width="85" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- CSCA MOLY: CỘNG ĐỒNG -->
            <TabItem x:Name="TabItemCommunity" Header="Cộng đồng" FontWeight="SemiBold">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- HEADER CARD -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Cộng đồng hỏi đáp &amp; Thảo luận" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" />
                                <TextBlock Text="Kiểm duyệt và quản lý các bài viết hỏi đáp, tương tác từ người học trên cổng CSCA." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource PillOrangeBgBrush}" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#B45309"><Run FontFamily="Segoe MDL2 Assets" Text="&#xE8F2;"/><Run Text=" Forum Moderation"/></TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <DataGrid x:Name="CscaPostsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource TableLinesBrush}" Background="{DynamicResource TableBgBrush}" BorderThickness="0" MinRowHeight="46">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NỘI DUNG" Binding="{Binding Content}" Width="2.5*" />
                                <DataGridTextColumn Header="TÁC GIẢ" Binding="{Binding AuthorName}" Width="150" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="LOẠI" Binding="{Binding PostType}" Width="100" />
                                <DataGridTextColumn Header="DUYỆT" Binding="{Binding ModerationStatus}" Width="100" />
                                <DataGridTextColumn Header="LIKE" Binding="{Binding LikeCount}" Width="65" />
                                <DataGridTextColumn Header="BÌNH LUẬN" Binding="{Binding CommentCount}" Width="90" />
                                <DataGridTextColumn Header="NGÀY" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
                </TabControl>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>

<UserControl x:Class="InternalManagement.Desktop.Views.CostBreakEvenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- COMPACT FILTER BAR -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,12"
                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Effect="{DynamicResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Từ" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker x:Name="FromDatePicker" Grid.Column="1" Height="32" VerticalContentAlignment="Center" SelectedDateChanged="CostBreakEvenFilter_Changed" />
                <TextBlock Text="Đến" Grid.Column="2" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,6,0" />
                <DatePicker x:Name="ToDatePicker" Grid.Column="3" Height="32" VerticalContentAlignment="Center" SelectedDateChanged="CostBreakEvenFilter_Changed" />
                <TextBlock Text="Lớp" Grid.Column="4" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox x:Name="ClassSelector" Grid.Column="5" Height="32" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CostBreakEvenFilter_Changed" />
                <Button Grid.Column="6" Click="ClearCostBreakEvenClass_Click" Style="{StaticResource OutlineButton}" Content="×" Width="30" Height="32" Margin="5,0,0,0" Padding="0" ToolTip="Xem tất cả lớp" />
                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,10,0">
                    <Border Background="{DynamicResource SurfaceInfoBgBrush}" BorderBrush="{DynamicResource SurfaceInfoBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock x:Name="LmsStatusText" Text="LMS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SurfaceInfoTextBrush}" />
                    </Border>
                    <TextBlock x:Name="RefreshStatusText" Text="" FontSize="10" Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="FilterScopeText" Visibility="Collapsed" />
                </StackPanel>
                <Button Grid.Column="8" Click="RefreshCostBreakEven_Click" Style="{StaticResource ModernPrimaryButton}" Height="32" Padding="13,0" Content="Tải lại" />
            </Grid>
        </Border>

        <!-- 4 CLEAN KPI CARDS -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,11" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="DOANH THU THỰC NHẬN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="RevenueMetricText" Text="0 đ" FontSize="19" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,11" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CHI PHÍ GIÁO VIÊN (LMS)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="TeacherCostMetricText" Text="0 đ" FontSize="19" FontWeight="Bold" Foreground="#EF4444" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,11" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CHI PHÍ KHÁC" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="OtherCostMetricText" Text="0 đ" FontSize="19" FontWeight="Bold" Foreground="#F59E0B" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,11" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ĐIỂM HÒA VỐN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="BreakEvenMetricText" Text="—" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- CLEAN ANALYSIS RESULT CARD -->
        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="16,14" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Kết quả phân tích hòa vốn" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,8" />
                <Border Background="{DynamicResource CardAltBgBrush}" CornerRadius="8" Padding="14,12" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                    <TextBlock x:Name="AnalysisNoteText" Text="Chọn một lớp ở thanh lọc phía trên để xem phân tích điểm hòa vốn chi tiết." TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextDarkBrush}" LineHeight="20" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

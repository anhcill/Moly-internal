<UserControl x:Class="InternalManagement.Desktop.Views.CostBreakEvenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,14"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Chi phí &amp; Hòa vốn" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                        <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                            <TextBlock Text="Khung phân tích" FontSize="11" FontWeight="SemiBold" Foreground="#C2410C" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Tập trung doanh thu thực nhận, chi phí giáo viên lấy từ CSCA Course/LMS và các khoản chi khác để tính điểm hòa vốn." FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="10,6" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#2563EB" Margin="0,0,6,0" />
                            <TextBlock x:Name="LmsStatusText" Text="Chưa đồng bộ dữ liệu LMS" FontSize="11" FontWeight="SemiBold" Foreground="#1D4ED8" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="RefreshStatusText" Text="Chưa tải dữ liệu" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,4,2,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="12,8" Margin="0,0,0,12"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Từ ngày" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker x:Name="FromDatePicker" Grid.Column="1" Height="32" VerticalContentAlignment="Center" SelectedDateChanged="CostBreakEvenFilter_Changed" />
                <TextBlock Text="Đến ngày" Grid.Column="2" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" Margin="12,0,6,0" />
                <DatePicker x:Name="ToDatePicker" Grid.Column="3" Height="32" VerticalContentAlignment="Center" SelectedDateChanged="CostBreakEvenFilter_Changed" />
                <TextBlock Text="Lớp" Grid.Column="4" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox x:Name="ClassSelector" Grid.Column="5" Height="32" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CostBreakEvenFilter_Changed" />
                <Button Grid.Column="6" Click="ClearCostBreakEvenClass_Click" Content="×" Width="30" Height="30" Margin="5,0,0,0" Padding="0" ToolTip="Xem tất cả lớp" />
                <TextBlock x:Name="FilterScopeText" Grid.Column="7" Text="Tất cả lớp học" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,8,0" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="8" Click="RefreshCostBreakEven_Click" Style="{StaticResource ModernPrimaryButton}" Height="32" Padding="13,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="Tải lại" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,14">
            <Border Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="DOANH THU KHÓA HỌC" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock x:Name="RevenueMetricText" Text="Chưa có dữ liệu" FontSize="18" FontWeight="Bold" Foreground="#059669" Margin="0,5,0,2" />
                    <TextBlock Text="Lấy từ các khoản đã thu thực tế" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="CHI PHÍ GIÁO VIÊN" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock x:Name="TeacherCostMetricText" Text="Chờ dữ liệu LMS" FontSize="18" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,2" />
                    <TextBlock Text="Không nhập lương thủ công" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="CHI PHÍ KHÁC" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock x:Name="OtherCostMetricText" Text="Chưa cấu hình" FontSize="18" FontWeight="Bold" Foreground="#B45309" Margin="0,5,0,2" />
                    <TextBlock Text="Lấy từ sổ chi phí được phân loại" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" Padding="14,10" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="ĐIỂM HÒA VỐN" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock x:Name="BreakEvenMetricText" Text="Chờ cấu hình" FontSize="18" FontWeight="Bold" Foreground="#4F46E5" Margin="0,5,0,2" />
                    <TextBlock Text="Theo học viên hoặc doanh thu" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18,16" Margin="0,0,10,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="Công thức dự kiến" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                    <TextBlock Text="Điểm hòa vốn = Chi phí cố định / (Doanh thu bình quân mỗi học viên - Chi phí biến đổi mỗi học viên)" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextDarkBrush}" Margin="0,12,0,8" />
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1">
                        <TextBlock x:Name="AnalysisNoteText" Text="Chọn một lớp để xem kết quả hòa vốn thực tế từ API." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18,16" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="Nguồn dữ liệu" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                    <TextBlock Text="• Doanh thu: khoản học phí đã thu trong lớp CSCA" FontSize="12" Foreground="{StaticResource TextDarkBrush}" Margin="0,12,0,4" />
                    <TextBlock Text="• Giáo viên: snapshot lương/thù lao thực tế từ CSCA Course/LMS" FontSize="12" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="• Chi phí khác: sổ chi phí nội bộ đã phân loại" FontSize="12" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="• Không cho nhập lương tay trong màn hình này" FontSize="12" Foreground="#B45309" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

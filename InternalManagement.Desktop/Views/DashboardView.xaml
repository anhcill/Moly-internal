<UserControl x:Class="InternalManagement.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DashboardScopeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" Background="Transparent" BorderThickness="0" CornerRadius="7" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource GhostHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextDarkBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,16">
            <!-- Report header and scope -->
            <Border CornerRadius="12" Padding="20,16" Margin="0,0,0,14" Background="{DynamicResource HeroBannerBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="9" Width="36" Height="36" Margin="0,0,12,0">
                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="BÁO CÁO ĐIỀU HÀNH" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding UpdatedAt}" FontSize="10.5" Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding ScopeTitle}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding ScopeDescription}" Margin="48,4,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="9" Padding="3" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="CompanyScopeButton" GroupName="DashboardScope" Tag="company" Content="Toàn công ty" IsChecked="True" Checked="Scope_Checked" Style="{StaticResource DashboardScopeRadio}" />
                                <RadioButton x:Name="EducationScopeButton" GroupName="DashboardScope" Tag="education" Content="Giáo dục" Checked="Scope_Checked" Style="{StaticResource DashboardScopeRadio}" />
                                <RadioButton x:Name="FashionScopeButton" GroupName="DashboardScope" Tag="fashion" Content="Thời trang" Checked="Scope_Checked" Style="{StaticResource DashboardScopeRadio}" />
                            </StackPanel>
                        </Border>
                        <Button Click="Refresh_Click" Style="{StaticResource OutlineButton}" Height="32" Padding="12,0" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Cập nhật báo cáo" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- KPI grid -->
            <ItemsControl ItemsSource="{Binding Kpis}" Margin="-6,0,-6,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="16,14" Margin="6,0,6,12" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold" Foreground="{Binding Accent}" Margin="0,5,0,3" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="{Binding Background}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Accent}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Charts -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.12*" />
                    <ColumnDefinition Width="0.88*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource DashboardSectionCard}" Margin="0,0,7,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="So sánh tài chính theo mảng" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" />
                                <TextBlock Text="{Binding FinanceNote}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Ellipse Width="8" Height="8" Fill="#14B8A6" Margin="0,0,5,0" />
                                <TextBlock Text="Thu" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,10,0" />
                                <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,5,0" />
                                <TextBlock Text="Chi" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding FinanceBars}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="FinanceRow" CornerRadius="10" Padding="11" Margin="0,0,0,8" Background="{DynamicResource CardAltBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="105" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Profit, StringFormat='{}Lợi nhuận: {0}'}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,14,0">
                                                <Border Height="12" Width="{Binding IncomeWidth}" Background="#14B8A6" CornerRadius="6" HorizontalAlignment="Left" />
                                                <Border Height="12" Width="{Binding ExpenseWidth}" Background="#F59E0B" CornerRadius="6" HorizontalAlignment="Left" Margin="0,7,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Income}" FontSize="10.5" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding Expense}" FontSize="10.5" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,5,0,0" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="FinanceRow" Property="BorderBrush" Value="{DynamicResource SecondaryBrush}" />
                                            <Setter TargetName="FinanceRow" Property="Background" Value="{DynamicResource SurfaceInfoBgBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource DashboardSectionCard}" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Cơ cấu hoạt động" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" />
                        <TextBlock Text="Quy mô thực tế trong phạm vi đang xem" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,14" />
                        <ItemsControl ItemsSource="{Binding OperationBars}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,13">
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding Value}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Height="10">
                                            <Border Background="{DynamicResource CardAltBgBrush}" CornerRadius="5" />
                                            <Border Width="{Binding Width}" Background="{Binding Color}" CornerRadius="5" HorizontalAlignment="Left" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- People and alerts -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.75*" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource DashboardSectionCard}" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="Nhân sự &amp; chấm công" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" />
                        <TextBlock Text="Theo phạm vi báo cáo đang chọn" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,16" />
                        <Border Background="{DynamicResource SurfaceSuccessBgBrush}" BorderBrush="{DynamicResource SurfaceSuccessBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" Background="{DynamicResource PillGreenBgBrush}" CornerRadius="9" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SurfaceSuccessTextBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Nhân sự" FontSize="10" Foreground="{DynamicResource SurfaceSuccessTextBrush}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding PeopleSummary}" FontSize="12" Foreground="{DynamicResource TextDarkBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceInfoBgBrush}" BorderBrush="{DynamicResource SurfaceInfoBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" Background="{DynamicResource PillBlueBgBrush}" CornerRadius="9" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SurfaceInfoTextBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Chấm công tháng này" FontSize="10" Foreground="{DynamicResource SurfaceInfoTextBrush}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding AttendanceSummary}" FontSize="11.5" Foreground="{DynamicResource TextDarkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource DashboardSectionCard}" Margin="7,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Cảnh báo &amp; điểm cần chú ý" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" />
                                <TextBlock Text="Ưu tiên xử lý theo dữ liệu vận hành mới nhất" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource CardAltBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="10" Padding="9,3">
                                <TextBlock Text="LIVE REPORT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SurfaceSuccessTextBrush}" />
                            </Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Alerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Background}" CornerRadius="9" Padding="11,9" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground}" FontSize="14" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="{Binding Foreground}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
    </StackPanel>
</UserControl>

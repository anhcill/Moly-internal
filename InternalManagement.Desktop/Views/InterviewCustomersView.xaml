<UserControl x:Class="InternalManagement.Desktop.Views.InterviewCustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- TOOLBAR & FILTERS -->
                        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="InterviewSearchBox" Width="280" Height="36" Style="{StaticResource ModernTextBox}" Margin="0,0,12,0" TextChanged="InterviewSearch_TextChanged" />
                                    <TextBlock Text="Tìm ứng viên, gói mock..." IsHitTestVisible="False" Foreground="#94A3B8" Margin="-270,0,0,0" VerticalAlignment="Center" x:Name="InterviewSearchPlaceholder" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Click="SyncInterviewFromWebsite_Click" Style="{StaticResource OutlineButton}" Height="36" Margin="0,0,8,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE774;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Đồng bộ website" VerticalAlignment="Center"/></StackPanel></Button>
                                    <Button Click="RefreshInterview_Click" Style="{StaticResource OutlineButton}" Height="36" Margin="0,0,8,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Tải Lại" VerticalAlignment="Center"/></StackPanel></Button>
                                    <Button Content="+ Đặt Lịch Mock Mới" Click="CreateInterviewCustomerDialog_Click" Style="{StaticResource PrimaryGradientButton}" Height="36" Padding="16,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- METRICS STATS BAR (SaaS Modern KPI Cards) -->
                        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
                            <!-- Card 1: Tổng số ứng viên -->
                            <Border Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="TỔNG SỐ ỨNG VIÊN" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Row="0" Grid.Column="1" Background="#EFF6FF" CornerRadius="6" Width="26" Height="26" HorizontalAlignment="Right">
                                        <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE716;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding CustomerCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,3,0,1" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Khách hàng đăng ký" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </Grid>
                            </Border>

                            <!-- Card 2: Tổng số buổi phỏng vấn -->
                            <Border Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="TỔNG SỐ BUỔI PHỎNG VẤN" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Row="0" Grid.Column="1" Background="#EEF2FF" CornerRadius="6" Width="26" Height="26" HorizontalAlignment="Right">
                                        <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE787;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding SessionCount}" FontSize="20" FontWeight="Bold" Foreground="#2563EB" Margin="0,3,0,1" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Lịch mock phỏng vấn" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </Grid>
                            </Border>

                            <!-- Card 3: Doanh thu đã thu -->
                            <Border Background="White" CornerRadius="10" Padding="14,10" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DOANH THU ĐÃ THU" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Row="0" Grid.Column="1" Background="#ECFDF5" CornerRadius="6" Width="26" Height="26" HorizontalAlignment="Right">
                                        <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE8D4;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding RevenueText}" FontSize="20" FontWeight="Bold" Foreground="#059669" Margin="0,3,0,1" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Thực thu ghi nhận" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <!-- INTERVIEW DATAGRID -->
                        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <DataGrid x:Name="InterviewCustomersDataGrid" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="46">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MÃ NGUỒN" Binding="{Binding SourceId}" Width="120" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding FullName}" Width="1.8*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="1.8*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="SỐ ĐIỆN THOẠI" Binding="{Binding Phone}" Width="130" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="GÓI DỊCH VỤ" Binding="{Binding PackageName}" Width="2*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    <DataGridTextColumn Header="SỐ BUỔI" Binding="{Binding SessionCount}" Width="85" />
                                    <DataGridTextColumn Header="TIỀN ĐÃ THU" Binding="{Binding PaidAmount, StringFormat='{}{0:N0} đ'}" Width="140" FontWeight="Bold" ElementStyle="{StaticResource DataGridEmeraldTextCellStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
</UserControl>

<UserControl x:Class="InternalManagement.Desktop.Views.FinanceWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- COMPACT TOP ACTION BAR -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,12"
                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Effect="{DynamicResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Kỳ xem" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker x:Name="ForecastFromMonthPicker" Width="126" Height="32" VerticalContentAlignment="Center" />
                    <ComboBox x:Name="ForecastHorizonCombo" Width="82" Height="32" Margin="6,0,0,0" VerticalContentAlignment="Center" ToolTip="Số tháng hiển thị" />
                    <Button Content="Tải lại" Click="Refresh_Click" Style="{StaticResource OutlineButton}" Height="32" Padding="12,0" Margin="8,0,0,0" />
                    <TextBlock x:Name="FreshnessText" Text="" FontSize="10.5" Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </WrapPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="+ Phiếu Thu" Click="RecordManualIncome_Click" Tag="FinanceWrite" Style="{StaticResource ModernPrimaryButton}" Height="32" Padding="12,0" Margin="0,0,6,0" ToolTip="Ghi nhận khoản thu thực tế vào sổ quỹ" />
                    <Button Content="- Phiếu Chi" Click="RecordManualExpense_Click" Tag="FinanceWrite" Style="{StaticResource DangerOutlineButton}" Height="32" Padding="12,0" Margin="0,0,6,0" ToolTip="Ghi nhận chi phí vận hành thực tế (mặt bằng, quảng cáo, phần mềm...)" />
                    <Button Content="In / PDF" Click="ExportPnlPdf_Click" Style="{StaticResource OutlineButton}" Height="32" Padding="11,0" Margin="0,0,6,0" ToolTip="Xuất báo cáo Tài chính &amp; Lãi/Lỗ chuẩn A4 để in / lưu PDF" />
                    <Button Content="Xuất Excel" Click="ExportCsv_Click" Style="{StaticResource OutlineButton}" Height="32" Padding="11,0" ToolTip="Xuất sổ báo cáo Excel nhiều sheet chuẩn kế toán (.xlsx) hoặc CSV UTF-8" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 5 EXECUTIVE KPI CARDS (THU · CHI · LÃI RÒNG · CÔNG NỢ · CÒN TRẢ GV) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <UniformGrid Columns="5">
                <!-- 1. Tổng Thu -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="13,10" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TỔNG THU" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock x:Name="PeriodInflowMetric" Text="0 đ" FontSize="17" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,2" />
                        <TextBlock x:Name="CurrentCashMetric" Text="Quỹ: 0 đ" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <!-- 2. Tổng Chi -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="13,10" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TỔNG CHI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock x:Name="PeriodOutflowMetric" Text="0 đ" FontSize="17" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,2" />
                        <TextBlock x:Name="ForecastClosingMetric" Text="Cuối kỳ: 0 đ" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <!-- 3. Lợi nhuận ròng (Lãi / Lỗ) -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="13,10" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="LỢI NHUẬN RÒNG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock x:Name="NetProfitMetric" Text="0 đ" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,2" />
                        <TextBlock x:Name="ProfitMarginMetric" Text="Biên lãi: 0%" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <!-- 4. Công nợ học viên -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="13,10" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CÔNG NỢ HỌC VIÊN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock x:Name="StudentDebtMetric" Text="0 đ" FontSize="17" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,2" />
                        <TextBlock x:Name="OverdueDebtMetric" Text="Quá hạn: 0 đ" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <!-- 5. Còn phải trả giáo viên -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="13,10" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CÒN TRẢ GIÁO VIÊN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock x:Name="TeacherPayableMetric" Text="0 đ" FontSize="17" FontWeight="Bold" Foreground="#EC4899" Margin="0,4,0,2" />
                        <TextBlock x:Name="TeacherAdvanceOpenMetric" Text="Ứng còn dư: 0 đ" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border x:Name="DebtAlertBanner" Visibility="Collapsed" Margin="0,8,0,0" Padding="12,7" CornerRadius="9"
                    Background="{DynamicResource SurfaceWarningBgBrush}" BorderBrush="{DynamicResource SurfaceWarningBorderBrush}" BorderThickness="1">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Xem công nợ" Click="JumpToOverdueDebt_Click" Style="{StaticResource OutlineButton}" Height="26" Padding="10,0" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="DebtAlertText" Foreground="{DynamicResource SurfaceWarningTextBrush}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <TextBlock x:Name="ReportWarningsText" Visibility="Collapsed" Foreground="{DynamicResource SurfaceWarningTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,6,2,0" />
        </StackPanel>

        <!-- 6 CLEAN WORKSPACE TABS -->
        <TabControl Grid.Row="2" x:Name="WorkspaceTabs" Background="Transparent" BorderThickness="0" SelectionChanged="WorkspaceTabs_SelectionChanged">

            <!-- TAB 1: BIỂU ĐỒ & LỢI NHUẬN -->
            <TabItem Header="Biểu đồ &amp; Lợi nhuận" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="285" />
                        <RowDefinition Height="245" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="0.75*" />
                    </Grid.ColumnDefinitions>

                    <!-- Chart 1: Monthly Thu / Chi Bars + Balance Line -->
                    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,10,10" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Thu – Chi &amp; Số dư theo tháng" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" VerticalAlignment="Center" />
                                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="■ Thu" Foreground="#10B981" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,10,0" />
                                    <TextBlock Text="■ Chi" Foreground="#EF4444" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,10,0" />
                                    <TextBlock Text="● Số dư" Foreground="{DynamicResource PrimaryBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                </WrapPanel>
                            </DockPanel>
                            <Canvas x:Name="FinanceChartCanvas" Grid.Row="1" Background="{DynamicResource CardAltBgBrush}" SizeChanged="ChartsCanvas_SizeChanged" />
                        </Grid>
                    </Border>

                    <!-- Chart 2: Profit & Cost Structure (P&L) -->
                    <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Cơ cấu Lãi / Lỗ &amp; Chi phí" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,8" />
                            <Canvas x:Name="ProfitBreakdownCanvas" Grid.Row="1" Background="{DynamicResource CardAltBgBrush}" SizeChanged="ChartsCanvas_SizeChanged" />
                        </Grid>
                    </Border>

                    <!-- Chart 3: Teacher Salary & Advance Progress -->
                    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Tiến độ Trả lương &amp; Ứng Giáo viên" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" VerticalAlignment="Center" />
                                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="■ Đã trả" Foreground="#10B981" FontSize="10" FontWeight="SemiBold" Margin="0,0,8,0" />
                                    <TextBlock Text="■ Đã ứng" Foreground="#F59E0B" FontSize="10" FontWeight="SemiBold" Margin="0,0,8,0" />
                                    <TextBlock Text="■ Còn chuyển" Foreground="#EF4444" FontSize="10" FontWeight="SemiBold" />
                                </WrapPanel>
                            </DockPanel>
                            <Canvas x:Name="TeacherPayrollCanvas" Grid.Row="1" Background="{DynamicResource CardAltBgBrush}" SizeChanged="ChartsCanvas_SizeChanged" />
                        </Grid>
                    </Border>

                    <!-- Chart 4: Receivables Collection Donut -->
                    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="14,12" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Tỷ lệ Thu học phí &amp; Công nợ" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,8" />
                            <Canvas x:Name="ReceivablesDonutCanvas" Grid.Row="1" Background="{DynamicResource CardAltBgBrush}" SizeChanged="ChartsCanvas_SizeChanged" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: DÒNG TIỀN THÁNG & KỊCH BẢN -->
            <TabItem Header="Dòng tiền tháng" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Kịch bản dự báo:" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Thu nợ (%)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox x:Name="CollectionPercentBox" Width="64" Height="30" Text="85" VerticalContentAlignment="Center" />
                            <TextBlock Text="Hệ số chi" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,5,0" />
                            <TextBox x:Name="CostFactorBox" Width="64" Height="30" Text="1" VerticalContentAlignment="Center" />
                            <TextBlock Text="Quỹ đầu kỳ" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,5,0" />
                            <TextBox x:Name="OpeningCashBox" Width="115" Height="30" Text="0" VerticalContentAlignment="Center" />
                            <Button Content="Tính lại" Click="Refresh_Click" Style="{StaticResource ModernPrimaryButton}" Height="30" Padding="12,0" Margin="12,0,0,0" />
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <DataGrid x:Name="MonthlyRowsGrid" MinHeight="340" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="42" ScrollViewer.HorizontalScrollBarVisibility="Auto" MouseDoubleClick="MonthlyRowsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="THÁNG" Binding="{Binding MonthLabel}" Width="95" FontWeight="Bold" />
                                <DataGridTextColumn Header="LOẠI" Binding="{Binding KindLabel}" Width="95" />
                                <DataGridTextColumn Header="ĐẦU KỲ" Binding="{Binding OpeningCash, StringFormat='{}{0:N0} đ'}" Width="130" />
                                <DataGridTextColumn Header="TỔNG THU" Binding="{Binding TotalInflow, StringFormat='{}{0:N0} đ'}" Width="135" ElementStyle="{StaticResource DataGridEmeraldTextCellStyle}" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="TỔNG CHI" Binding="{Binding TotalOutflow, StringFormat='{}{0:N0} đ'}" Width="135" ElementStyle="{StaticResource DataGridRedTextCellStyle}" FontWeight="SemiBold" />
                                <DataGridTemplateColumn Header="LÃI / LỖ THÁNG" Width="145">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NetProfitDisplay}" FontWeight="Bold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#10B981" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProfitable}" Value="False">
                                                                <Setter Property="Foreground" Value="#EF4444" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="THU HỌC VIÊN" Binding="{Binding StudentCollections, StringFormat='{}{0:N0} đ'}" Width="135" />
                                <DataGridTextColumn Header="CHI GIÁO VIÊN" Binding="{Binding TeacherPayments, StringFormat='{}{0:N0} đ'}" Width="135" />
                                <DataGridTextColumn Header="CUỐI KỲ" Binding="{Binding ClosingCash, StringFormat='{}{0:N0} đ'}" Width="140" FontWeight="Bold" ElementStyle="{StaticResource DataGridIndigoTextCellStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: GIÁO VIÊN · ỨNG & CHUYỂN LƯƠNG -->
            <TabItem Header="Giáo viên · Ứng &amp; Lương" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Clean 4-pill Teacher Payroll Summary -->
                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
                        <Border Background="{DynamicResource CardAltBgBrush}" CornerRadius="9" Padding="11,8" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="CÔNG THỰC TẾ" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock x:Name="TeacherTotalEarnedText" Text="0 đ" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardAltBgBrush}" CornerRadius="9" Padding="11,8" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ĐÃ ỨNG CÒN DƯ" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock x:Name="TeacherTotalAdvanceText" Text="0 đ" FontSize="15" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardAltBgBrush}" CornerRadius="9" Padding="11,8" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ĐÃ QUYẾT TOÁN" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock x:Name="TeacherTotalSettledText" Text="0 đ" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardAltBgBrush}" CornerRadius="9" Padding="11,8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="CÒN PHẢI CHUYỂN" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock x:Name="TeacherTotalUnpaidText" Text="0 đ" FontSize="15" FontWeight="Bold" Foreground="#EF4444" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Action Bar -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
                        <Grid DockPanel.Dock="Left" Width="210" Height="32" Margin="0,0,10,0">
                            <TextBox x:Name="TeacherSearchBox" Style="{StaticResource ModernTextBox}" Height="32" Padding="28,0,8,0" FontSize="12" VerticalContentAlignment="Center" TextChanged="TeacherSearchBox_TextChanged" />
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="#94A3B8" FontSize="11" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBlock x:Name="TeacherSearchPlaceholder" Text="Tìm tên giáo viên..." Foreground="#94A3B8" FontSize="11.5" Margin="28,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button Content="Chuyển lương" Click="PayTeacher_Click" Tag="FinanceWrite" Style="{StaticResource ModernPrimaryButton}" Height="32" Padding="13,0" Margin="0,0,6,0" ToolTip="Thanh toán lương &amp; tự động cấn trừ ứng cho giáo viên đang chọn" />
                            <Button Content="Ứng tiền" Click="IssueAdvance_Click" Tag="FinanceWrite" Style="{StaticResource OutlineButton}" Height="32" Padding="12,0" Margin="0,0,6,0" />
                            <Button Content="Hoàn ứng" Click="ReturnAdvance_Click" Tag="FinanceWrite" Style="{StaticResource OutlineButton}" Height="32" Padding="12,0" Margin="0,0,6,0" />
                            <Button Content="In phiếu lương" Click="PrintTeacherStatement_Click" Style="{StaticResource OutlineButton}" Height="32" Padding="11,0" Margin="0,0,6,0" ToolTip="Mở phiếu quyết toán thù lao &amp; sao kê tạm ứng chuẩn A4 để in / lưu PDF" />
                            <Button Content="↻ Đồng bộ LMS" Click="SyncMolyCoursePayroll_Click" Tag="FinanceWrite" Style="{StaticResource OutlineButton}" Height="32" Padding="11,0" />
                        </WrapPanel>
                    </DockPanel>

                    <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <DataGrid x:Name="TeacherCostsGrid" MinHeight="320" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" RowHeight="42" ScrollViewer.HorizontalScrollBarVisibility="Auto" MouseDoubleClick="TeacherCostsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="GIÁO VIÊN" Binding="{Binding TeacherName}" Width="1.5*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="CÔNG THỰC TẾ" Binding="{Binding EarnedAmount, StringFormat='{}{0:N0} đ'}" Width="125" />
                                <DataGridTextColumn Header="DỰ KIẾN THÊM" Binding="{Binding FutureProjectedAmount, StringFormat='{}{0:N0} đ'}" Width="125" ElementStyle="{StaticResource DataGridMutedTextCellStyle}" />
                                <DataGridTextColumn Header="ĐÃ QUYẾT TOÁN" Binding="{Binding SettledAmount, StringFormat='{}{0:N0} đ'}" Width="130" ElementStyle="{StaticResource DataGridEmeraldTextCellStyle}" />
                                <DataGridTextColumn Header="ĐÃ ỨNG" Binding="{Binding AdvancesIssued, StringFormat='{}{0:N0} đ'}" Width="115" />
                                <DataGridTextColumn Header="ỨNG CÒN DƯ" Binding="{Binding RemainingAdvance, StringFormat='{}{0:N0} đ'}" Width="115" ElementStyle="{StaticResource DataGridWrapAmberTextCellStyle}" />
                                <DataGridTextColumn Header="CÒN CHUYỂN" Binding="{Binding UnpaidEarned, StringFormat='{}{0:N0} đ'}" Width="135" FontWeight="Bold" ElementStyle="{StaticResource DataGridRedTextCellStyle}" />
                                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding PaymentStatusLabel}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: CÔNG NỢ HỌC VIÊN -->
            <TabItem Header="Công nợ học viên" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                        <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Grid Width="200" Height="32" Margin="0,0,8,0">
                                <TextBox x:Name="ReceivableSearchBox" Style="{StaticResource ModernTextBox}" Height="32" Padding="28,0,8,0" FontSize="12" VerticalContentAlignment="Center" TextChanged="ReceivableFilter_Changed" />
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="#94A3B8" FontSize="11" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBlock x:Name="ReceivableSearchPlaceholder" Text="Tìm học viên, lớp..." Foreground="#94A3B8" FontSize="11.5" Margin="28,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <ComboBox x:Name="ReceivableStatusFilter" Width="135" Height="32" VerticalContentAlignment="Center" SelectionChanged="ReceivableFilter_Changed">
                                <ComboBoxItem Content="Tất cả" IsSelected="True" />
                                <ComboBoxItem Content="Còn nợ" />
                                <ComboBoxItem Content="Quá hạn" />
                            </ComboBox>
                        </WrapPanel>
                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button Content="Thu tiền" Click="ReceiveStudentDebt_Click" Tag="FinanceWrite" Style="{StaticResource ModernPrimaryButton}" Height="32" Padding="13,0" Margin="0,0,6,0" />
                            <Button Content="Hẹn thu" Click="ScheduleStudentDebt_Click" Tag="FinanceWrite" Style="{StaticResource OutlineButton}" Height="32" Padding="11,0" Margin="0,0,6,0" />
                            <Button Content="Copy nhắc Zalo" Click="CopyZaloReminder_Click" Style="{StaticResource OutlineButton}" Height="32" Padding="11,0" Margin="0,0,6,0" ToolTip="Sao chép tin nhắn nhắc học phí lịch sự để dán gửi Zalo" />
                            <Button Content="In phiếu thu" Click="PrintStudentReceipt_Click" Style="{StaticResource OutlineButton}" Height="32" Padding="11,0" Margin="0,0,6,0" ToolTip="Mở phiếu thu / sao kê học phí chuẩn A4 để in / lưu PDF" />
                            <Button Content="Hoàn tiền" Click="RefundStudent_Click" Tag="FinanceWrite" Style="{StaticResource OutlineButton}" Height="32" Padding="11,0" Margin="0,0,6,0" />
                            <Button Content="Hủy nợ" Click="CancelStudentDebt_Click" Tag="FinanceWrite" Style="{StaticResource DangerOutlineButton}" Height="32" Padding="11,0" />
                        </WrapPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <DataGrid x:Name="ReceivablesGrid" MinHeight="340" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" RowHeight="42" ScrollViewer.HorizontalScrollBarVisibility="Auto" MouseDoubleClick="ReceivablesGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="HỌC VIÊN" Binding="{Binding StudentName}" Width="1.4*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="LỚP" Binding="{Binding ClassName}" Width="1.2*" />
                                <DataGridTextColumn Header="CẦN THU" Binding="{Binding PayableAmount, StringFormat='{}{0:N0} đ'}" Width="120" />
                                <DataGridTextColumn Header="ĐÃ THU" Binding="{Binding PaidAmount, StringFormat='{}{0:N0} đ'}" Width="120" ElementStyle="{StaticResource DataGridEmeraldTextCellStyle}" />
                                <DataGridTextColumn Header="CÒN NỢ" Binding="{Binding OutstandingAmount, StringFormat='{}{0:N0} đ'}" Width="120" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapAmberTextCellStyle}" />
                                <DataGridTextColumn Header="HẠN THU" Binding="{Binding LocalDueDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="105" />
                                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusLabel}" Width="110" />
                                <DataGridTextColumn Header="CẢNH BÁO" Binding="{Binding CollectionAlert}" Width="135" ElementStyle="{StaticResource DataGridRedTextCellStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 5: KẾ HOẠCH THU CHI -->
            <TabItem Header="Kế hoạch thu chi" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button Content="+ Thêm kế hoạch" Click="AddPlanItem_Click" Tag="FinanceWrite" Style="{StaticResource ModernPrimaryButton}" Height="32" Padding="13,0" Margin="0,0,6,0" />
                        <Button Content="Ghi nhận đã thu/chi" Click="SettlePlanItem_Click" Tag="FinanceWrite" Style="{StaticResource OutlineButton}" Height="32" Padding="12,0" Margin="0,0,6,0" />
                        <Button Content="Hủy kế hoạch" Click="CancelPlanItem_Click" Tag="FinanceWrite" Style="{StaticResource DangerOutlineButton}" Height="32" Padding="12,0" />
                    </WrapPanel>
                    <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <DataGrid x:Name="PlanItemsGrid" MinHeight="340" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" RowHeight="42" ScrollViewer.HorizontalScrollBarVisibility="Auto" MouseDoubleClick="PlanItemsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NGÀY DỰ KIẾN" Binding="{Binding LocalPlannedDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="115" />
                                <DataGridTextColumn Header="LOẠI" Binding="{Binding TypeLabel}" Width="80" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="NỘI DUNG" Binding="{Binding Title}" Width="1.7*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="SỐ TIỀN" Binding="{Binding Amount, StringFormat='{}{0:N0} đ'}" Width="130" FontWeight="Bold" />
                                <DataGridTextColumn Header="LẶP LẠI" Binding="{Binding RecurrenceLabel}" Width="105" />
                                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusLabel}" Width="105" />
                                <DataGridTextColumn Header="GHI CHÚ" Binding="{Binding Notes}" Width="1.3*" ElementStyle="{StaticResource DataGridMutedTextCellStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 6: SỔ THU CHI (NHẬT KÝ) -->
            <TabItem Header="Sổ Thu Chi" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                        <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Grid Width="210" Height="32" Margin="0,0,8,0">
                                <TextBox x:Name="LedgerSearchBox" Style="{StaticResource ModernTextBox}" Height="32" Padding="28,0,8,0" FontSize="12" VerticalContentAlignment="Center" TextChanged="LedgerFilter_Changed" />
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="#94A3B8" FontSize="11" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBlock x:Name="LedgerSearchPlaceholder" Text="Tìm nội dung thu chi..." Foreground="#94A3B8" FontSize="11.5" Margin="28,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <ComboBox x:Name="LedgerTypeFilter" Width="120" Height="32" VerticalContentAlignment="Center" SelectionChanged="LedgerFilter_Changed">
                                <ComboBoxItem Content="Tất cả" IsSelected="True" />
                                <ComboBoxItem Content="Chỉ Thu" />
                                <ComboBoxItem Content="Chỉ Chi" />
                            </ComboBox>
                        </WrapPanel>
                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button Content="+ Phiếu Thu" Click="RecordManualIncome_Click" Tag="FinanceWrite" Style="{StaticResource ModernPrimaryButton}" Height="32" Padding="12,0" Margin="0,0,6,0" />
                            <Button Content="- Phiếu Chi" Click="RecordManualExpense_Click" Tag="FinanceWrite" Style="{StaticResource DangerOutlineButton}" Height="32" Padding="12,0" />
                        </WrapPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <DataGrid x:Name="CashMovementsGrid" MinHeight="340" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="42" ScrollViewer.HorizontalScrollBarVisibility="Auto" MouseDoubleClick="CashMovementsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="THỜI GIAN" Binding="{Binding LocalOccurredAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140" />
                                <DataGridTextColumn Header="LOẠI" Binding="{Binding TypeLabel}" Width="80" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="NỘI DUNG" Binding="{Binding Description}" Width="1.9*" />
                                <DataGridTextColumn Header="THU" Binding="{Binding Inflow, StringFormat='{}{0:N0} đ'}" Width="125" ElementStyle="{StaticResource DataGridEmeraldTextCellStyle}" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="CHI" Binding="{Binding Outflow, StringFormat='{}{0:N0} đ'}" Width="125" ElementStyle="{StaticResource DataGridRedTextCellStyle}" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="NGUỒN" Binding="{Binding ReferenceLabel}" Width="1.1*" ElementStyle="{StaticResource DataGridMutedTextCellStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

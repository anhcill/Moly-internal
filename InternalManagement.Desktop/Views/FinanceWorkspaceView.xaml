<UserControl x:Class="InternalManagement.Desktop.Views.FinanceWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FinanceDangerButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="Foreground" Value="#B91C1C" />
            <Setter Property="BorderBrush" Value="#FECACA" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="14,10" Margin="0,0,0,12"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Bảng tính tài chính" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="9" Padding="8,2" Margin="9,0,0,0">
                            <TextBlock Text="Thực tế + Kịch bản" FontSize="10.5" FontWeight="SemiBold" Foreground="#1D4ED8" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Số thực tế không bị thay đổi bởi tham số kịch bản. Dự báo chỉ dùng để mô phỏng dòng tiền tương lai." FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                    <TextBlock x:Name="ReportWarningsText" Foreground="#9A3412" FontSize="10.5" TextWrapping="Wrap" MaxWidth="1050" Margin="0,5,10,0" />
                </StackPanel>
                <TextBlock x:Name="FreshnessText" Grid.Column="1" Text="Chưa tải dữ liệu" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="WorkspaceTabs" Background="Transparent" BorderThickness="0">
            <TabItem Header="Tổng quan &amp; Dự báo" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid Margin="0,10,0,0" MinWidth="960">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="300" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="12,9" Margin="0,0,0,10" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Tháng bắt đầu" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <DatePicker x:Name="ForecastFromMonthPicker" Width="130" Height="31" VerticalContentAlignment="Center" />
                                <TextBlock Text="Số tháng" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,5,0" />
                                <ComboBox x:Name="ForecastHorizonCombo" Width="70" Height="31" VerticalContentAlignment="Center" />
                                <TextBlock Text="Thu được (%)" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,5,0" />
                                <TextBox x:Name="CollectionPercentBox" Width="70" Height="31" Text="85" VerticalContentAlignment="Center" />
                                <TextBlock Text="Hệ số chi phí" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,5,0" />
                                <TextBox x:Name="CostFactorBox" Width="70" Height="31" Text="1" VerticalContentAlignment="Center" />
                                <TextBlock Text="Tiền đầu kỳ" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,5,0" />
                                <TextBox x:Name="OpeningCashBox" Width="120" Height="31" Text="0" VerticalContentAlignment="Center" />
                                <Button Content="Tải báo cáo" Click="Refresh_Click" Style="{StaticResource ModernPrimaryButton}" Height="31" Padding="12,0" Margin="12,0,5,0" />
                                <Button Content="Xuất CSV" Click="ExportCsv_Click" Style="{StaticResource OutlineButton}" Height="31" Padding="12,0" />
                            </WrapPanel>
                        </Border>

                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
                            <Border Background="White" CornerRadius="10" Padding="12,9" Margin="0,0,8,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <StackPanel><TextBlock Text="SỐ DƯ THEO SỔ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="CurrentCashMetric" Text="—" FontSize="18" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/></StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="10" Padding="12,9" Margin="0,0,8,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <StackPanel><TextBlock Text="CÔNG NỢ HỌC VIÊN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="StudentDebtMetric" Text="—" FontSize="18" FontWeight="Bold" Foreground="#B45309" Margin="0,4,0,0"/></StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="10" Padding="12,9" Margin="0,0,8,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <StackPanel><TextBlock Text="PHẢI TRẢ GIÁO VIÊN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="TeacherPayableMetric" Text="—" FontSize="18" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/></StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="10" Padding="12,9" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <StackPanel><TextBlock Text="SỐ DƯ CUỐI KỊCH BẢN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="ForecastClosingMetric" Text="—" FontSize="18" FontWeight="Bold" Foreground="#4F46E5" Margin="0,4,0,0"/></StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="12" Margin="0,0,0,10" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <WrapPanel Margin="0,0,0,6">
                                    <TextBlock Text="Dòng tiền theo tháng" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,18,0" />
                                    <TextBlock Text="■ Thu" Foreground="#059669" FontSize="10.5" Margin="0,0,12,0" />
                                    <TextBlock Text="■ Chi" Foreground="#DC2626" FontSize="10.5" Margin="0,0,12,0" />
                                    <TextBlock Text="● Số dư đóng kỳ" Foreground="#4F46E5" FontSize="10.5" />
                                    <TextBlock Text="  TT: thực tế · DB: dự báo · nét đứt: kỳ có dự báo" Foreground="#64748B" FontSize="10" Margin="10,0,0,0" />
                                </WrapPanel>
                                <Canvas x:Name="FinanceChartCanvas" Grid.Row="1" Background="#FAFCFF" SizeChanged="FinanceChartCanvas_SizeChanged" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <DataGrid x:Name="MonthlyRowsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" RowHeight="42" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="THÁNG" Binding="{Binding MonthLabel}" Width="95" />
                                    <DataGridTextColumn Header="LOẠI" Binding="{Binding KindLabel}" Width="90" />
                                    <DataGridTextColumn Header="ĐẦU KỲ" Binding="{Binding OpeningCash, StringFormat='{}{0:N0} đ'}" Width="125" />
                                    <DataGridTextColumn Header="THU" Binding="{Binding TotalInflow, StringFormat='{}{0:N0} đ'}" Width="125" />
                                    <DataGridTextColumn Header="CHI" Binding="{Binding TotalOutflow, StringFormat='{}{0:N0} đ'}" Width="125" />
                                    <DataGridTextColumn Header="THU THỰC TẾ" Binding="{Binding ActualInflow, StringFormat='{}{0:N0} đ'}" Width="130" />
                                    <DataGridTextColumn Header="CHI THỰC TẾ" Binding="{Binding ActualOutflow, StringFormat='{}{0:N0} đ'}" Width="130" />
                                    <DataGridTextColumn Header="THU DỰ BÁO" Binding="{Binding ForecastInflow, StringFormat='{}{0:N0} đ'}" Width="130" />
                                    <DataGridTextColumn Header="CHI DỰ BÁO" Binding="{Binding ForecastOutflow, StringFormat='{}{0:N0} đ'}" Width="130" />
                                    <DataGridTextColumn Header="THU HỌC VIÊN" Binding="{Binding StudentCollections, StringFormat='{}{0:N0} đ'}" Width="135" />
                                    <DataGridTextColumn Header="TRẢ GIÁO VIÊN" Binding="{Binding TeacherPayments, StringFormat='{}{0:N0} đ'}" Width="140" />
                                    <DataGridTextColumn Header="KẾ HOẠCH THU" Binding="{Binding PlannedIncome, StringFormat='{}{0:N0} đ'}" Width="130" />
                                    <DataGridTextColumn Header="KẾ HOẠCH CHI" Binding="{Binding PlannedExpense, StringFormat='{}{0:N0} đ'}" Width="130" />
                                    <DataGridTextColumn Header="CUỐI KỲ" Binding="{Binding ClosingCash, StringFormat='{}{0:N0} đ'}" Width="135" FontWeight="Bold" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Công nợ học viên" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="Ghi nhận thu" Click="ReceiveStudentDebt_Click" Tag="FinanceWrite" Style="{StaticResource ModernPrimaryButton}" Height="31" Padding="12,0" Margin="0,0,6,0" />
                        <Button Content="Hoàn/điều chỉnh" Click="RefundStudent_Click" Tag="FinanceWrite" Style="{StaticResource OutlineButton}" Height="31" Padding="12,0" />
                        <Button Content="Hẹn ngày thu" Click="ScheduleStudentDebt_Click" Tag="FinanceWrite" Style="{StaticResource OutlineButton}" Height="31" Padding="12,0" Margin="6,0,0,0" />
                        <Button Content="Hủy công nợ" Click="CancelStudentDebt_Click" Tag="FinanceWrite" Style="{StaticResource FinanceDangerButton}" Height="31" Padding="12,0" Margin="6,0,0,0" />
                        <TextBlock Text="Chỉ ghi giao dịch thực tế; khoản chưa thu vẫn là công nợ." FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </WrapPanel>
                    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <DataGrid x:Name="ReceivablesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" RowHeight="42" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="HỌC VIÊN" Binding="{Binding StudentName}" Width="1.4*" />
                                <DataGridTextColumn Header="LỚP" Binding="{Binding ClassName}" Width="1.2*" />
                                <DataGridTextColumn Header="CẦN THU" Binding="{Binding PayableAmount, StringFormat='{}{0:N0} đ'}" Width="120" />
                                <DataGridTextColumn Header="ĐÃ THU" Binding="{Binding PaidAmount, StringFormat='{}{0:N0} đ'}" Width="120" />
                                <DataGridTextColumn Header="CÒN NỢ" Binding="{Binding OutstandingAmount, StringFormat='{}{0:N0} đ'}" Width="120" FontWeight="Bold" />
                                <DataGridTextColumn Header="HẠN THU" Binding="{Binding LocalDueDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="105" />
                                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusLabel}" Width="110" />
                                <DataGridTextColumn Header="LƯU Ý" Binding="{Binding CollectionAlert}" Width="155" Foreground="#B45309" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Giáo viên &amp; Ứng tiền" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Ứng tiền" Click="IssueAdvance_Click" Tag="FinanceWrite" Style="{StaticResource ModernPrimaryButton}" Height="31" Padding="12,0" Margin="0,0,6,0" />
                        <Button Content="Hoàn ứng" Click="ReturnAdvance_Click" Tag="FinanceWrite" Style="{StaticResource OutlineButton}" Height="31" Padding="12,0" Margin="0,0,6,0" />
                        <Button Content="Thanh toán công" Click="PayTeacher_Click" Tag="FinanceWrite" Style="{StaticResource OutlineButton}" Height="31" Padding="12,0" />
                    </WrapPanel>
                    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <DataGrid x:Name="TeacherCostsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" RowHeight="42" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="GIÁO VIÊN" Binding="{Binding TeacherName}" Width="1.4*" />
                                <DataGridTextColumn Header="ĐÃ KIẾM" Binding="{Binding EarnedAmount, StringFormat='{}{0:N0} đ'}" Width="120" />
                                <DataGridTextColumn Header="DỰ KIẾN" Binding="{Binding ProjectedAmount, StringFormat='{}{0:N0} đ'}" Width="120" />
                                <DataGridTextColumn Header="ĐÃ THANH TOÁN" Binding="{Binding SettledAmount, StringFormat='{}{0:N0} đ'}" Width="135" />
                                <DataGridTextColumn Header="ĐÃ ỨNG" Binding="{Binding AdvancesIssued, StringFormat='{}{0:N0} đ'}" Width="115" />
                                <DataGridTextColumn Header="ĐÃ HOÀN" Binding="{Binding AdvancesReturned, StringFormat='{}{0:N0} đ'}" Width="115" />
                                <DataGridTextColumn Header="ĐÃ CẤN TRỪ" Binding="{Binding AdvancesApplied, StringFormat='{}{0:N0} đ'}" Width="115" />
                                <DataGridTextColumn Header="CÒN ỨNG" Binding="{Binding RemainingAdvance, StringFormat='{}{0:N0} đ'}" Width="115" />
                                <DataGridTextColumn Header="CÒN PHẢI TRẢ" Binding="{Binding UnpaidEarned, StringFormat='{}{0:N0} đ'}" Width="135" FontWeight="Bold" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Kế hoạch thu chi" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="+ Thêm kế hoạch" Click="AddPlanItem_Click" Tag="FinanceWrite" Style="{StaticResource ModernPrimaryButton}" Height="31" Padding="12,0" Margin="0,0,6,0" />
                        <Button Content="Đánh dấu đã thu/chi" Click="SettlePlanItem_Click" Tag="FinanceWrite" Style="{StaticResource OutlineButton}" Height="31" Padding="12,0" Margin="0,0,6,0" />
                        <Button Content="Hủy kế hoạch" Click="CancelPlanItem_Click" Tag="FinanceWrite" Style="{StaticResource FinanceDangerButton}" Height="31" Padding="12,0" />
                    </WrapPanel>
                    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <DataGrid x:Name="PlanItemsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" RowHeight="42" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NGÀY DỰ KIẾN" Binding="{Binding LocalPlannedDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="115" />
                                <DataGridTextColumn Header="LOẠI" Binding="{Binding TypeLabel}" Width="85" />
                                <DataGridTextColumn Header="NỘI DUNG" Binding="{Binding Title}" Width="1.7*" />
                                <DataGridTextColumn Header="SỐ TIỀN" Binding="{Binding Amount, StringFormat='{}{0:N0} đ'}" Width="125" />
                                <DataGridTextColumn Header="LẶP LẠI" Binding="{Binding RecurrenceLabel}" Width="110" />
                                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusLabel}" Width="110" />
                                <DataGridTextColumn Header="GHI CHÚ" Binding="{Binding Notes}" Width="1.4*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Nhật ký" FontWeight="SemiBold">
                <Border Margin="0,10,0,0" Background="White" CornerRadius="12" Padding="8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                    <DataGrid x:Name="CashMovementsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="42" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="THỜI GIAN" Binding="{Binding LocalOccurredAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="145" />
                            <DataGridTextColumn Header="LOẠI" Binding="{Binding TypeLabel}" Width="90" />
                            <DataGridTextColumn Header="NỘI DUNG" Binding="{Binding Description}" Width="1.8*" />
                            <DataGridTextColumn Header="THU" Binding="{Binding Inflow, StringFormat='{}{0:N0} đ'}" Width="120" />
                            <DataGridTextColumn Header="CHI" Binding="{Binding Outflow, StringFormat='{}{0:N0} đ'}" Width="120" />
                            <DataGridTextColumn Header="THAM CHIẾU" Binding="{Binding ReferenceLabel}" Width="1.2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>


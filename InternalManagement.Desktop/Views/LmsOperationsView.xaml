<UserControl x:Class="InternalManagement.Desktop.Views.LmsOperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ROW 0: THẺ ĐIỀU HÀNH & CHỈ SỐ ĐỒNG BỘ -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE774;" FontSize="11" Foreground="White" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="CSCA LMS" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Đồng bộ tự động" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 4 Chỉ số tóm tắt responsive WrapPanel -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,10,0">
                    <Border Background="{DynamicResource SurfaceInfoBgBrush}" BorderBrush="{DynamicResource SurfaceInfoBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,2,8,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Khóa liên kết: " FontSize="11" Foreground="{DynamicResource SurfaceInfoTextBrush}" />
                            <TextBlock x:Name="LmsReadyMappingsMetricText" Text="—" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SurfaceInfoTextBrush}" />
                            <TextBlock Text=" " FontSize="11" />
                            <TextBlock x:Name="LmsTotalCoursesMetricText" Text="trên — khóa học" FontSize="10.5" Foreground="{DynamicResource SurfaceInfoTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SurfaceSuccessBgBrush}" BorderBrush="{DynamicResource SurfaceSuccessBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,2,8,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Học viên Web: " FontSize="11" Foreground="{DynamicResource SurfaceSuccessTextBrush}" />
                            <TextBlock x:Name="LmsActiveGrantsMetricText" Text="—" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SurfaceSuccessTextBrush}" />
                            <TextBlock Text=" đang học" FontSize="10.5" Foreground="{DynamicResource SurfaceSuccessTextBrush}" Margin="2,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SurfaceWarningBgBrush}" BorderBrush="{DynamicResource SurfaceWarningBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,2,8,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Chờ gửi: " FontSize="11" Foreground="{DynamicResource SurfaceWarningTextBrush}" />
                            <TextBlock x:Name="LmsPendingOutboxMetricText" Text="—" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SurfaceWarningTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SurfaceDangerBgBrush}" BorderBrush="{DynamicResource SurfaceDangerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,2,0,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="11" Foreground="{DynamicResource SurfaceDangerTextBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Cần xử lý: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SurfaceDangerTextBrush}" />
                            <TextBlock x:Name="LmsFailedOutboxMetricText" Text="—" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SurfaceDangerTextBrush}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Button Grid.Column="2" Click="RefreshLmsIntegration_Click" Style="{StaticResource OutlineButton}"
                        Height="32" Padding="10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Cập nhật trạng thái" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ROW 1: PHẦN NỘI DUNG CHÍNH -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- KHỐI 1: LIÊN KẾT KHÓA HỌC -->
            <Expander Grid.Row="0" IsExpanded="True" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,2">
                <Expander.Header>
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="1. Liên kết khóa học cần đồng bộ" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" />
                            <TextBlock Text="· Chọn khóa, cấu hình đường dẫn và bấm Đồng bộ ngay" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource SurfaceSuccessBgBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Tự động sau khi liên kết" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SurfaceSuccessTextBrush}" />
                        </Border>
                    </Grid>
                </Expander.Header>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.05*" />
                    </Grid.ColumnDefinitions>

                    <!-- Bảng khóa học -->
                    <DataGrid Grid.Column="0" x:Name="LmsCourseMappingsDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="LmsCourseMappingsDataGrid_SelectionChanged"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="{DynamicResource TableBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Height="210" MinRowHeight="32" RowHeight="36"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KHÓA HỌC" Binding="{Binding CourseTitle}" Width="1.15*" MinWidth="120"
                                                FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapBoldTextCellStyle}" />
                            <DataGridTextColumn Header="CÁC LỚP" Binding="{Binding ClassSummary}" Width="1.45*" MinWidth="150"
                                                ElementStyle="{StaticResource DataGridWrapMutedTextCellStyle}" />
                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusLabel}" Width="115"
                                                FontWeight="SemiBold" ElementStyle="{StaticResource DataGridTextCellStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Khung cấu hình khóa đang chọn -->
                    <Border Grid.Column="2" Background="{DynamicResource CardAltBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Hàng 1: Tên khóa + Trạng thái -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="KHÓA: " FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LmsSelectedCourseText" Text="Chọn một khóa ở bảng bên trái" FontSize="12.5"
                                               FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" TextTrimming="CharacterEllipsis" MaxWidth="260"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="1" x:Name="LmsSelectedCourseStatusBadgeBorder" Background="{DynamicResource PillSlateBgBrush}" CornerRadius="6"
                                        Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="LmsSelectedCourseStatusBadge" Text="Chưa chọn" FontSize="10"
                                               FontWeight="Bold" Foreground="{DynamicResource PillSlateTextBrush}" />
                                </Border>
                            </Grid>

                            <!-- Hàng 2: Báo lỗi nếu có -->
                            <Border Grid.Row="1" x:Name="LmsSelectedCourseErrorBorder" Visibility="Collapsed" Background="{DynamicResource SurfaceDangerBgBrush}"
                                    BorderBrush="{DynamicResource SurfaceDangerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="CẦN SỬA TRƯỚC KHI GỬI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SurfaceDangerTextBrush}" />
                                    <TextBlock x:Name="LmsSelectedCourseErrorText" FontSize="11" Foreground="{DynamicResource SurfaceDangerTextBrush}"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Hàng 3: Ô nhập Đường dẫn Web & Mã khóa Web -->
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="0.8*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ĐƯỜNG DẪN WEB" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" x:Name="AutoGenerateSlugButton" Content="Tự tạo" Click="AutoGenerateSlug_Click"
                                                Style="{StaticResource OutlineButton}" Height="22" Padding="8,0" FontSize="10" />
                                    </Grid>
                                    <TextBox x:Name="LmsCourseSlugBox" Height="32" FontSize="12"
                                             ToolTip="Ví dụ: toan-csca-thang-10" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="MÃ KHÓA TRÊN WEB" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="LmsCourseIdBox" Height="32" FontSize="12"
                                             ToolTip="Có thể để trống" />
                                    <TextBox x:Name="LmsExternalCourseIdBox" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>

                            <!-- Hàng 4: Checkbox và các nút thao tác -->
                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="LmsEnableAccessCheckBox" IsChecked="False"
                                          Content="Tự cấp quyền học" FontSize="11.5" FontWeight="SemiBold"
                                          Foreground="{DynamicResource SurfaceSuccessTextBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" x:Name="SaveLmsMappingButton" Click="SaveLmsMapping_Click" Style="{StaticResource OutlineButton}"
                                        Height="32" Padding="12,0" Margin="0,0,8,0" Content="Lưu cấu hình" FontSize="11.5" />
                                <Button Grid.Column="2" x:Name="DispatchLmsOutboxButton" Click="DispatchLmsOutbox_Click"
                                        Style="{StaticResource PrimaryGradientButton}" Height="32" Padding="14,0"
                                        Content="⚡ Đồng bộ ngay" FontSize="11.5" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Expander>

            <!-- KHỐI 2: NHẬT KÝ & TIẾN TRÌNH GỬI -->
            <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="2. Nhật ký &amp; Trạng thái gửi Web LMS" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" />
                            <TextBlock Text="· Tự động gửi trong nền. Chọn dòng lỗi để thử lại" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="RetryLmsOutboxButton" Click="RetryLmsOutbox_Click"
                                Style="{StaticResource OutlineButton}" Height="32" Padding="12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Thử lại dòng đã chọn" FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="LmsOutboxDataGrid" MinHeight="340" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="{DynamicResource TableBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                              RowHeight="36" MinRowHeight="32"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NỘI DUNG" Binding="{Binding EventDisplayName}" Width="190" MinWidth="150"
                                                FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusLabel}" Width="130" MinWidth="110"
                                                FontWeight="SemiBold" ElementStyle="{StaticResource DataGridTextCellStyle}" />
                            <DataGridTextColumn Header="CHI TIẾT LỖI / KẾT QUẢ" Binding="{Binding ResultSummary}" Width="*" MinWidth="260"
                                                ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                            <DataGridTextColumn Header="LẦN GỬI" Binding="{Binding DisplayAttempt}" Width="75"
                                                ElementStyle="{StaticResource DataGridTextCellStyle}" />
                            <DataGridTextColumn Header="TẠO LÚC" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM HH:mm}'}" Width="100"
                                                ElementStyle="{StaticResource DataGridMutedTextCellStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

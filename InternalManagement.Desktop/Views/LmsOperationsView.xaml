<UserControl x:Class="InternalManagement.Desktop.Views.LmsOperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Compact toolbar: keep the course mapping controls in the first viewport. -->
        <Border Grid.Row="0" Background="#EFF6FF" CornerRadius="10" Padding="12,8" Margin="0,0,0,8" BorderBrush="#BFDBFE" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top: Title and Refresh -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE774;" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="Liên kết khóa học với CSCA Course" FontSize="14" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center" />
                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#065F46"><Run FontFamily="Segoe MDL2 Assets" Text="&#xE73E;"/><Run Text=" Đã kết nối LMS"/></TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Click="RefreshLmsIntegration_Click" Style="{StaticResource OutlineButton}" Height="30" Padding="10,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Làm mới" VerticalAlignment="Center"/></StackPanel></Button>
                </Grid>
            </Grid>
        </Border>

        <!-- 4 METRIC STATS CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Khóa học đã liên kết -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10,6" Margin="0,0,8,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="KHÓA HỌC ĐÃ LIÊN KẾT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <Border Grid.Row="0" Grid.Column="1" Background="#EFF6FF" CornerRadius="6" Width="22" Height="22" HorizontalAlignment="Right">
                        <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE774;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="LmsReadyMappingsMetricText" Text="—" FontSize="18" FontWeight="Bold" Foreground="#2563EB" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="LmsTotalCoursesMetricText" Text="trên — khóa học" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
            </Border>

            <!-- Card 2: Học viên đã mở quyền -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="10,6" Margin="0,0,8,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="HỌC VIÊN ĐANG HỌC WEB" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <Border Grid.Row="0" Grid.Column="1" Background="#ECFDF5" CornerRadius="6" Width="22" Height="22" HorizontalAlignment="Right">
                        <TextBlock FontFamily="Segoe MDL2 Assets, Segoe UI" Text="&#xE7BE;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="LmsActiveGrantsMetricText" Text="—" FontSize="18" FontWeight="Bold" Foreground="#059669" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="học viên đã mở quyền học" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
            </Border>

            <!-- Card 3: Lệnh chờ đồng bộ -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="10,6" Margin="0,0,8,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="LỆNH CHỜ ĐỒNG BỘ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <Border Grid.Row="0" Grid.Column="1" Background="#FFFBEB" CornerRadius="6" Width="22" Height="22" HorizontalAlignment="Right">
                        <TextBlock Text="⏳" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="LmsPendingOutboxMetricText" Text="—" FontSize="18" FontWeight="Bold" Foreground="#D97706" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="lệnh đang chuẩn bị gửi" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
            </Border>

            <!-- Card 4: Cần kiểm tra -->
            <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="10,6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CẦN KIỂM TRA LẠI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <Border Grid.Row="0" Grid.Column="1" Background="#FEF2F2" CornerRadius="6" Width="22" Height="22" HorizontalAlignment="Right">
                        <TextBlock Text="⚠️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="LmsFailedOutboxMetricText" Text="—" FontSize="18" FontWeight="Bold" Foreground="#DC2626" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="lệnh lỗi hoặc thử lại" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
            </Border>
        </Grid>

        <!-- MAPPING & OUTBOX SPLIT VIEW -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" MinWidth="500" />
                <ColumnDefinition Width="1*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- Left: Course Mapping -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="10" Margin="0,0,10,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Khóa học &amp; mã liên kết Web" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                        <TextBlock Text="Chọn khóa học trong bảng, kiểm tra mã và lưu liên kết." FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <!-- FORM CONFIGURATION CARD -->
                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" Padding="9,7" Margin="0,0,0,7" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <!-- Selected Course Banner -->
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center" Margin="0,0,8,0"><Run FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;"/><Run Text=" ĐANG CHỌN:"/></TextBlock>
                                        <TextBlock Grid.Column="1" x:Name="LmsSelectedCourseText" Text="Chọn một khóa học từ bảng bên dưới" FontSize="11" FontWeight="Bold" Foreground="#1E3A8A" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="Tên khóa học được chọn" />
                                    </Grid>
                                    <Border Grid.Column="1" x:Name="LmsSelectedCourseStatusBadgeBorder" Background="#F1F5F9" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock x:Name="LmsSelectedCourseStatusBadge" Text="Chưa chọn khóa học" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="LmsSelectedCourseErrorBorder" Visibility="Collapsed" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="7" Padding="8,6" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="LỖI ĐỒNG BỘ GẦN NHẤT" FontSize="10.5" FontWeight="Bold" Foreground="#991B1B" />
                                    <TextBlock x:Name="LmsSelectedCourseErrorText" TextWrapping="Wrap" FontSize="11" Foreground="#7F1D1D" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Input Fields Grid -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!-- Field 1: Web Course Slug -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                        <TextBlock Text="ĐƯỜNG DẪN WEB (SLUG)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <Button x:Name="AutoGenerateSlugButton" Content="✨ Tạo Slug" Click="AutoGenerateSlug_Click" Style="{StaticResource OutlineButton}" Height="22" Padding="6,0" FontSize="10" HorizontalAlignment="Right" ToolTip="Tự động tạo đường dẫn slug chuẩn từ tên khóa học" />
                                    </DockPanel>
                                    <TextBox x:Name="LmsCourseSlugBox" Height="28" Style="{StaticResource ModernTextBox}" ToolTip="Đường dẫn trên website, ví dụ: toan-csca-thang-10" />
                                </StackPanel>

                                <!-- Field 2: LMS Course ID -->
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="MÃ ID WEB (TÙY CHỌN)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="LmsCourseIdBox" Height="28" Style="{StaticResource ModernTextBox}" ToolTip="Mã số ID trên Web nếu có (VD: 1, 2...). Có thể để trống nếu dùng Slug." />
                                </StackPanel>

                                <!-- Field 3: External ID -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="MÃ NỘI BỘ (EXTERNAL ID)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="LmsExternalCourseIdBox" Height="28" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Background="#F1F5F9" Foreground="#64748B" ToolTip="Mã nhận diện nội bộ của hệ thống quản lý" />
                                </StackPanel>
                            </Grid>

                            <!-- Activation Card with Save Button -->
                            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="7" Padding="9,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <CheckBox x:Name="LmsEnableAccessCheckBox" Content="Bật đồng bộ và cấp quyền học" FontSize="11" FontWeight="Bold" Foreground="#166534" VerticalAlignment="Center" ToolTip="Gửi giáo viên, khóa học, lớp và học viên có email sang Web; cấp quyền sau khi đồng bộ thành công và đủ học phí." />
                                    </StackPanel>
                                    <Button x:Name="SaveLmsMappingButton" Grid.Column="1" Click="SaveLmsMapping_Click" Style="{StaticResource PrimaryGradientButton}" Height="30" Padding="10,0" VerticalAlignment="Center" Margin="8,0,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Lưu liên kết" VerticalAlignment="Center"/></StackPanel></Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Course Table -->
                    <DataGrid Grid.Row="2" x:Name="LmsCourseMappingsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="LmsCourseMappingsDataGrid_SelectionChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KHÓA HỌC" Binding="{Binding CourseTitle}" Width="1.4*" MinWidth="120" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapBoldTextCellStyle}" />
                            <DataGridTextColumn Header="MÃ NỘI BỘ" Binding="{Binding CourseSourceId}" Width="1*" MinWidth="100" ElementStyle="{StaticResource DataGridWrapMutedTextCellStyle}" />
                            <DataGridTextColumn Header="CÁC LỚP" Binding="{Binding ClassSummary}" Width="1.5*" MinWidth="140" ElementStyle="{StaticResource DataGridWrapMutedTextCellStyle}" />
                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusLabel}" Width="125" MinWidth="115" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridTextCellStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right: LMS Outbox -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="14" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Tiến trình đồng bộ sang Web CSCA Course" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
                            <TextBlock Text="Theo dõi tài khoản học viên và dữ liệu được đồng bộ sang Web." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="RetryLmsOutboxButton"  Click="RetryLmsOutbox_Click" Style="{StaticResource OutlineButton}" Height="32" Padding="10,0" Margin="0,0,6,0" ToolTip="Đưa các lệnh bị lỗi trở lại hàng chờ để gửi lại"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Thử lại" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button x:Name="DispatchLmsOutboxButton" Content="↻ Đồng bộ khóa đã chọn" Click="DispatchLmsOutbox_Click" Style="{StaticResource PrimaryGradientButton}" Height="32" Padding="12,0" ToolTip="Lưu và bật liên kết của khóa đã chọn, sau đó gửi khóa học và các lớp sang Web Course" />
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="LmsOutboxDataGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="HÀNH ĐỘNG" Binding="{Binding EventDisplayName}" Width="1.3*" MinWidth="120" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusLabel}" Width="100" MinWidth="90" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridTextCellStyle}" />
                            <DataGridTextColumn Header="LẦN GỬI" Binding="{Binding DisplayAttempt}" Width="70" MinWidth="60" ElementStyle="{StaticResource DataGridTextCellStyle}" />
                            <DataGridTextColumn Header="KẾT QUẢ / CHI TIẾT" Binding="{Binding ResultSummary}" Width="1.4*" MinWidth="110" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                            <DataGridTextColumn Header="THỜI GIAN" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM HH:mm}'}" Width="85" MinWidth="75" ElementStyle="{StaticResource DataGridMutedTextCellStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

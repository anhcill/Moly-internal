<UserControl x:Class="InternalManagement.Desktop.Views.LmsOperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F7F9FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F2A43" CornerRadius="12" Padding="16,11" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Đồng bộ CSCA Course" FontSize="17" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Liên kết một lần, sau đó học viên, giáo viên và lịch học tự cập nhật giữa hai hệ thống."
                               FontSize="11" Foreground="#C9D8E6" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Click="RefreshLmsIntegration_Click" Style="{StaticResource OutlineButton}"
                        Height="32" Padding="12,0" Background="White" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Cập nhật trạng thái" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="12,8" Margin="0,0,8,0"
                    BorderBrush="#DCE5EE" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="KHÓA ĐÃ LIÊN KẾT" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock x:Name="LmsReadyMappingsMetricText" Text="—" FontSize="20" FontWeight="Bold" Foreground="#1663C7" />
                        <TextBlock x:Name="LmsTotalCoursesMetricText" Text="trên — khóa học" FontSize="10" Foreground="#64748B" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="30" Height="30" Background="#EAF3FF" CornerRadius="8">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE774;" FontSize="15" Foreground="#1663C7"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="12,8" Margin="0,0,8,0"
                    BorderBrush="#DCE5EE" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="HỌC VIÊN TRÊN WEB" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock x:Name="LmsActiveGrantsMetricText" Text="—" FontSize="20" FontWeight="Bold" Foreground="#07845B" />
                        <TextBlock Text="đang có quyền học" FontSize="10" Foreground="#64748B" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="30" Height="30" Background="#E8F8F1" CornerRadius="8">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BE;" FontSize="15" Foreground="#07845B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="12,8" Margin="0,0,8,0"
                    BorderBrush="#DCE5EE" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ĐANG CHỜ GỬI" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock x:Name="LmsPendingOutboxMetricText" Text="—" FontSize="20" FontWeight="Bold" Foreground="#C66A09" />
                        <TextBlock Text="tự xử lý trong nền" FontSize="10" Foreground="#64748B" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="30" Height="30" Background="#FFF5DE" CornerRadius="8">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE823;" FontSize="15" Foreground="#C66A09"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="3" Background="White" CornerRadius="10" Padding="12,8"
                    BorderBrush="#DCE5EE" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="CẦN XỬ LÝ" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock x:Name="LmsFailedOutboxMetricText" Text="—" FontSize="20" FontWeight="Bold" Foreground="#C93636" />
                        <TextBlock Text="lệnh lỗi cần xem lại" FontSize="10" Foreground="#64748B" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="30" Height="30" Background="#FEECEC" CornerRadius="8">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="15" Foreground="#C93636"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.08*" MinHeight="275" />
                <RowDefinition Height="10" />
                <RowDefinition Height="0.92*" MinHeight="220" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="12" BorderBrush="#DCE5EE" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="1. Chọn khóa học cần liên kết" FontSize="14" FontWeight="Bold" Foreground="#18324A" />
                            <TextBlock Text="Lần đầu cần chọn khóa và bấm Đồng bộ ngay. Các thay đổi sau đó được gửi tự động."
                                       FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#EAF7F1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="Tự động sau khi liên kết" FontSize="10.5" FontWeight="Bold" Foreground="#087451" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0" x:Name="LmsCourseMappingsDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionChanged="LmsCourseMappingsDataGrid_SelectionChanged"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F5"
                                  Background="White" BorderBrush="#E2E8F0" BorderThickness="1" MinRowHeight="38"
                                  HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="KHÓA HỌC" Binding="{Binding CourseTitle}" Width="1.15*" MinWidth="130"
                                                    FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapBoldTextCellStyle}" />
                                <DataGridTextColumn Header="CÁC LỚP" Binding="{Binding ClassSummary}" Width="1.45*" MinWidth="170"
                                                    ElementStyle="{StaticResource DataGridWrapMutedTextCellStyle}" />
                                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusLabel}" Width="125"
                                                    FontWeight="SemiBold" ElementStyle="{StaticResource DataGridTextCellStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Column="2" Background="#F6F9FC" BorderBrush="#DCE5EE" BorderThickness="1" CornerRadius="10" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="KHÓA ĐANG CHỌN" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="LmsSelectedCourseText" Text="Chọn một khóa ở bảng bên trái" FontSize="13"
                                               FontWeight="Bold" Foreground="#18324A" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <Border x:Name="LmsSelectedCourseStatusBadgeBorder" Background="#E8EEF5" CornerRadius="8"
                                            Padding="8,3" HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <TextBlock x:Name="LmsSelectedCourseStatusBadge" Text="Chưa chọn" FontSize="10.5"
                                                   FontWeight="Bold" Foreground="#526579" />
                                    </Border>
                                </StackPanel>

                                <Border Grid.Row="1" x:Name="LmsSelectedCourseErrorBorder" Visibility="Collapsed" Background="#FEECEC"
                                        BorderBrush="#F7B9B9" BorderThickness="1" CornerRadius="8" Padding="9,7" Margin="0,9,0,0">
                                    <StackPanel>
                                        <TextBlock Text="CẦN SỬA TRƯỚC KHI GỬI" FontSize="10" FontWeight="Bold" Foreground="#A32222" />
                                        <TextBlock x:Name="LmsSelectedCourseErrorText" FontSize="11" Foreground="#7F1D1D"
                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="ĐƯỜNG DẪN TRÊN WEB" FontSize="10.5" FontWeight="Bold" Foreground="#526579" />
                                        <Button x:Name="AutoGenerateSlugButton" Content="Tạo tự động" Click="AutoGenerateSlug_Click"
                                                Style="{StaticResource OutlineButton}" Height="23" Padding="7,0" FontSize="10"
                                                HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <TextBox x:Name="LmsCourseSlugBox" Height="30" Style="{StaticResource ModernTextBox}"
                                             ToolTip="Ví dụ: toan-csca-thang-10" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Margin="0,9,0,0">
                                    <TextBlock Text="MÃ KHÓA TRÊN WEB (CÓ THỂ ĐỂ TRỐNG)" FontSize="10.5" FontWeight="Bold"
                                               Foreground="#526579" Margin="0,0,0,4" />
                                    <TextBox x:Name="LmsCourseIdBox" Height="30" Style="{StaticResource ModernTextBox}" />
                                    <TextBox x:Name="LmsExternalCourseIdBox" Visibility="Collapsed" />
                                </StackPanel>

                                <CheckBox Grid.Row="4" x:Name="LmsEnableAccessCheckBox" IsChecked="False"
                                          Content="Kích hoạt liên kết và tự cấp quyền học" FontSize="11" FontWeight="SemiBold"
                                          Foreground="#166443" VerticalAlignment="Center" Margin="0,10,0,8" />

                                <Grid Grid.Row="5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="SaveLmsMappingButton" Click="SaveLmsMapping_Click" Style="{StaticResource OutlineButton}"
                                            Height="34" Padding="11,0" Margin="0,0,8,0" Content="Lưu cấu hình" />
                                    <Button Grid.Column="1" x:Name="DispatchLmsOutboxButton" Click="DispatchLmsOutbox_Click"
                                            Style="{StaticResource PrimaryGradientButton}" Height="34" Padding="14,0"
                                            HorizontalAlignment="Stretch" Content="Đồng bộ ngay" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#DCE5EE" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="2. Theo dõi trạng thái gửi" FontSize="14" FontWeight="Bold" Foreground="#18324A" />
                            <TextBlock Text="Hệ thống tự gửi trong nền. Chỉ dùng Thử lại khi một dòng báo Cần xử lý."
                                       FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="RetryLmsOutboxButton" Click="RetryLmsOutbox_Click"
                                Style="{StaticResource OutlineButton}" Height="32" Padding="11,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Thử lại dòng đã chọn" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="LmsOutboxDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EDF1F5" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                              MinRowHeight="38" HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NỘI DUNG" Binding="{Binding EventDisplayName}" Width="210" MinWidth="170"
                                                FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusLabel}" Width="125" MinWidth="105"
                                                FontWeight="SemiBold" ElementStyle="{StaticResource DataGridTextCellStyle}" />
                            <DataGridTextColumn Header="CHI TIẾT" Binding="{Binding ResultSummary}" Width="*" MinWidth="260"
                                                ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                            <DataGridTextColumn Header="LẦN GỬI" Binding="{Binding DisplayAttempt}" Width="80"
                                                ElementStyle="{StaticResource DataGridTextCellStyle}" />
                            <DataGridTextColumn Header="TẠO LÚC" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM HH:mm}'}" Width="105"
                                                ElementStyle="{StaticResource DataGridMutedTextCellStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

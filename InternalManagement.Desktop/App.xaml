        <!-- Modern Indeterminate Gradient Progress Bar Style -->
        <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource PrimaryGradient}" />
            <Setter Property="Background" Value="#EEF2FF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
                            <Grid x:Name="TemplateRoot">
                                <Border x:Name="IndeterminateIndicator" HorizontalAlignment="Left" Width="100" CornerRadius="2">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#4F46E5" Offset="0" />
                                            <GradientStop Color="#06B6D4" Offset="0.5" />
                                            <GradientStop Color="#3B82F6" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="IndicatorTransform" X="-100" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="IndicatorTransform"
                                                             Storyboard.TargetProperty="X"
                                                             From="-100" To="360"
                                                             Duration="0:0:1.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Top Slim Progress Bar Style for Fluid Screen Transitions -->
        <Style x:Key="TopProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" ClipToBounds="True">
                            <Grid x:Name="RootGrid">
                                <Border x:Name="TopIndicator" HorizontalAlignment="Left" Width="420" CornerRadius="1.5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#004F46E5" Offset="0" />
                                            <GradientStop Color="#4F46E5" Offset="0.35" />
                                            <GradientStop Color="#06B6D4" Offset="0.75" />
                                            <GradientStop Color="#0038BDF8" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="TopTransform" X="-420" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="TopTransform"
                                                             Storyboard.TargetProperty="X"
                                                             From="-420" To="1600"
                                                             Duration="0:0:1.5" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Solid Primary Blue Button (Matching Image 1, 2, 3) -->
        <Style x:Key="ModernPrimaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />

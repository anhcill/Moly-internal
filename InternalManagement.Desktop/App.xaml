                            <!-- Selected Tab Content -->
                            <Border Grid.Row="1" Background="{TemplateBinding Background}" Margin="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

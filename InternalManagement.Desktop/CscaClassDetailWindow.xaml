<Window x:Class="InternalManagement.Desktop.CscaClassDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InternalManagement.Desktop"
        Title="Chi tiết lớp CSCA"
        Icon="Assets/app-icon.ico"
        Width="1420"
        Height="860"
        MinWidth="1120"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="BorderBrush" Value="#4F46E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Foreground" Value="#B91C1C" />
            <Setter Property="BorderBrush" Value="#FECACA" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="Transparent" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563EB" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#1D4ED8" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ClassTitleText" Text="Chi tiết lớp" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock x:Name="ClassSubtitleText" Text="Đang tải dữ liệu..." FontSize="12" Foreground="#64748B" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EEF2FF" CornerRadius="8" Padding="12,8" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Học viên: " Foreground="#6366F1" FontWeight="SemiBold" />
                            <TextBlock x:Name="StudentCountText" Text="0" Foreground="#312E81" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Button Content="Đóng" Click="Close_Click" Width="86" Height="34" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="DetailTabs" SelectionChanged="DetailTabs_SelectionChanged">
            <TabItem Header="Thông tin lớp" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="42" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Mã lớp" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="ClassCodeText" Grid.Column="1" Style="{StaticResource FieldValue}" />
                                <TextBlock Text="Tên lớp" Grid.Column="2" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="ClassNameText" Grid.Column="3" Style="{StaticResource FieldValue}" />
                                <TextBlock Text="Đợt / khóa" Grid.Row="1" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="ClassBatchText" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" />
                                <TextBlock Text="Lịch học" Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="ClassScheduleText" Grid.Row="1" Grid.Column="3" Style="{StaticResource FieldValue}" />
                                <TextBlock Text="Trạng thái" Grid.Row="2" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="ClassStatusText" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" />
                                <TextBlock Text="Ngày bắt đầu" Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="ClassStartDateText" Grid.Row="2" Grid.Column="3" Style="{StaticResource FieldValue}" />
                                <TextBlock Text="Ngày kết thúc" Grid.Row="3" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="ClassEndDateText" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}" />
                                <TextBlock Text="Khóa học" Grid.Row="3" Grid.Column="2" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="ClassCourseText" Grid.Row="3" Grid.Column="3" Style="{StaticResource FieldValue}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="✎ Sửa thông tin lớp" Click="EditClass_Click" Style="{StaticResource PrimaryButton}" />
                            <Button Content="Xóa lớp" Click="DeleteClass_Click" Style="{StaticResource DangerButton}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Học viên" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ Thêm học viên" Click="AddStudent_Click" Style="{StaticResource PrimaryButton}" />
                        <Button Content="✎ Sửa học viên" Click="EditStudent_Click" Style="{StaticResource ToolbarButton}" />
                        <Button Content="Xóa học viên" Click="RemoveStudent_Click" Style="{StaticResource DangerButton}" />
                        <TextBlock Text="Double-click một dòng để chỉnh sửa nhanh." VerticalAlignment="Center" Foreground="#64748B" FontSize="12" Margin="8,0,0,0" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="StudentsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" RowHeight="42" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" MouseDoubleClick="StudentsDataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding StudentName}" Width="1.6*" />
                            <DataGridTextColumn Header="TUỔI" Binding="{Binding Age}" Width="60" />
                            <DataGridTextColumn Header="QUÊ QUÁN" Binding="{Binding Hometown}" Width="1.2*" />
                            <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="1.5*" />
                            <DataGridTextColumn Header="ĐIỆN THOẠI" Binding="{Binding PhoneNumber}" Width="120" />
                            <DataGridTextColumn Header="NGÀY VÀO" Binding="{Binding JoinedAt, StringFormat='{}{0:dd/MM/yyyy}'}" Width="105" />
                            <DataGridTextColumn Header="GHI CHÚ" Binding="{Binding Notes}" Width="1.4*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Tài chính" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,8" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Học phí / học viên: " Foreground="#475569" FontWeight="SemiBold" />
                                <TextBlock x:Name="ClassTuitionText" Foreground="#0F172A" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Background="#ECFDF5" CornerRadius="8" Padding="12,8" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Đã thu: " Foreground="#059669" FontWeight="SemiBold" />
                                <TextBlock x:Name="RevenueText" Text="0 đ" Foreground="#065F46" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Background="#FEF3C7" CornerRadius="8" Padding="12,8" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Còn nợ: " Foreground="#D97706" FontWeight="SemiBold" />
                                <TextBlock x:Name="DebtText" Text="0 đ" Foreground="#92400E" FontWeight="Bold" />
                            </StackPanel>
                    </Border>
                    </StackPanel>
                    <TextBlock Grid.Row="1" x:Name="FinancialSummaryText" TextWrapping="Wrap" Foreground="#475569" FontSize="13" Margin="0,0,0,12" />
                    <GroupBox Grid.Row="2" Header="Học phí và công nợ học viên" Margin="0,0,0,10">
                        <DataGrid x:Name="StudentFinanceDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding StudentName}" Width="1.5*" />
                                <DataGridTextColumn Header="HỌC PHÍ GỐC" Binding="{Binding TuitionFee, StringFormat='{}{0:N0} đ'}" Width="115" />
                                <DataGridTextColumn Header="GIẢM GIÁ" Binding="{Binding DiscountAmount, StringFormat='{}{0:N0} đ'}" Width="105" />
                                <DataGridTextColumn Header="CẦN THU" Binding="{Binding PayableAmount, StringFormat='{}{0:N0} đ'}" Width="115" />
                                <DataGridTextColumn Header="ĐÃ ĐÓNG" Binding="{Binding PaidAmount, StringFormat='{}{0:N0} đ'}" Width="115" />
                                <DataGridTextColumn Header="CÒN NỢ" Binding="{Binding DebtAmount, StringFormat='{}{0:N0} đ'}" Width="115" />
                                <DataGridTextColumn Header="HẸN TRẢ" Binding="{Binding DebtDueDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="105" />
                                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding PaymentStatusLabel}" Width="105" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <GroupBox Grid.Row="3" Header="Thù lao giáo viên">
                        <DataGrid x:Name="TeacherFinanceDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding EmployeeName}" Width="1.5*" />
                                <DataGridTextColumn Header="VAI TRÒ" Binding="{Binding RoleInClass}" Width="1.2*" />
                                <DataGridTextColumn Header="THÙ LAO" Binding="{Binding CompensationRate, StringFormat='{}{0:N0} đ'}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Giáo viên &amp; Nhân sự" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ Phân công giáo viên" Click="AddTeacher_Click" Style="{StaticResource PrimaryButton}" />
                        <Button Content="✎ Sửa phân công" Click="EditTeacher_Click" Style="{StaticResource ToolbarButton}" />
                        <Button Content="Hủy phân công" Click="RemoveTeacher_Click" Style="{StaticResource DangerButton}" />
                        <TextBlock Text="Bấm đúp vào dòng giáo viên để sửa vai trò, thù lao và ghi chú." VerticalAlignment="Center" Foreground="#64748B" FontSize="12" Margin="8,0,0,0" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="TeachersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" RowHeight="44" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" MouseDoubleClick="TeachersDataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding EmployeeName}" Width="1.7*" />
                            <DataGridTextColumn Header="MÃ NHÂN SỰ" Binding="{Binding EmployeeCode}" Width="130" />
                            <DataGridTextColumn Header="VAI TRÒ" Binding="{Binding RoleInClass}" Width="1.2*" />
                            <DataGridTextColumn Header="GHI CHÚ" Binding="{Binding Notes}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Thời khóa biểu" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Lịch học cố định" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="Chọn khung giờ hằng tuần, sau đó đặt ngày bắt đầu và kết thúc để tạo các buổi học." FontSize="12" Foreground="#64748B" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="+ Thêm khung giờ" Click="AddSchedule_Click" Style="{StaticResource ToolbarButton}" />
                            <Button Content="Thiết lập kỳ học" Click="SetupCourseSchedule_Click" Style="{StaticResource PrimaryButton}" />
                            <Button Content="Quản lý phòng" Click="ManageClassrooms_Click" Style="{StaticResource ToolbarButton}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ScheduleSummaryText" FontWeight="SemiBold" Foreground="#312E81" />
                                <TextBlock x:Name="ScheduleCoverageText" Foreground="#475569" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="‹" Width="34" Click="PreviousScheduleWeek_Click" Style="{StaticResource ToolbarButton}" ToolTip="Tuần trước" />
                                <Button Content="Hôm nay" Click="CurrentScheduleWeek_Click" Style="{StaticResource ToolbarButton}" />
                                <Button Content="›" Width="34" Click="NextScheduleWeek_Click" Style="{StaticResource ToolbarButton}" ToolTip="Tuần sau" />
                                <TextBlock x:Name="ScheduleWeekLabel" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#312E81" Margin="10,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10" ClipToBounds="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="ScheduleCalendarGrid" MinWidth="1110" />
                        </ScrollViewer>
                    </Border>

                    <Expander Grid.Row="3" Header="Danh sách khung giờ cố định · Chọn dòng để sửa hoặc xóa" IsExpanded="False" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8">
                    <DataGrid x:Name="SchedulesDataGrid" Height="180" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="42" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MouseDoubleClick="SchedulesDataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="THỨ" Binding="{Binding DayLabel}" Width="110" />
                            <DataGridTextColumn Header="KHUNG GIỜ" Binding="{Binding TimeLabel}" Width="150" />
                            <DataGridTextColumn Header="THỜI LƯỢNG" Binding="{Binding DurationLabel}" Width="105" />
                            <DataGridTextColumn Header="PHÒNG / HÌNH THỨC" Binding="{Binding LocationLabel}" Width="1.5*" />
                            <DataGridTextColumn Header="GHI CHÚ" Binding="{Binding Notes}" Width="1.6*" />
                            <DataGridTemplateColumn Header="THAO TÁC" Width="245">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Sửa" Click="EditScheduleRow_Click" Style="{StaticResource ToolbarButton}" Height="28" Padding="9,0" Margin="0,0,5,0" />
                                            <Button Content="Xóa" Click="RemoveScheduleRow_Click" Style="{StaticResource DangerButton}" Height="28" Padding="9,0" Margin="0,0,5,0" />
                                            <Button Content="Vào lớp" Click="OpenScheduleMeeting_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                                        <Setter Property="Height" Value="28" />
                                                        <Setter Property="Padding" Value="9,0" />
                                                        <Setter Property="Margin" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMeetingUrl}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Expander>
                </Grid>
            </TabItem>

            <TabItem x:Name="AttendanceReportTab" Header="Báo cáo điểm danh" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="BÁO CÁO ĐIỂM DANH TỪ CSCA COURSE" FontWeight="Bold" Foreground="#1E40AF" />
                                <TextBlock Text="Dữ liệu chỉ đọc, được đồng bộ sau khi giáo viên chốt điểm danh trên web. Lớp và học viên cần liên kết với web trước khi có báo cáo." TextWrapping="Wrap" Foreground="#475569" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Tải lại báo cáo" Click="RefreshAttendanceReport_Click" Style="{StaticResource ToolbarButton}" Height="34" Padding="12,0" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Từ ngày" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#475569" />
                        <DatePicker x:Name="AttendanceReportFromDatePicker" Width="135" Height="34" Margin="0,0,14,0" />
                        <TextBlock Text="Đến ngày" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#475569" />
                        <DatePicker x:Name="AttendanceReportToDatePicker" Width="135" Height="34" Margin="0,0,14,0" />
                        <TextBlock x:Name="AttendanceReportStatusText" Text="Mở tab để tải dữ liệu điểm danh." VerticalAlignment="Center" Foreground="#64748B" TextWrapping="Wrap" />
                    </StackPanel>
                    <UniformGrid Grid.Row="2" Columns="6" Margin="0,0,0,12">
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="HỌC VIÊN" Foreground="#64748B" FontSize="11"/><TextBlock x:Name="ReportStudentCountText" Text="0" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="BUỔI ĐÃ CHỐT" Foreground="#64748B" FontSize="11"/><TextBlock x:Name="ReportSessionCountText" Text="0" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="CÓ MẶT + ĐI MUỘN" Foreground="#64748B" FontSize="11"/><TextBlock x:Name="ReportPresentCountText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#059669"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="VẮNG" Foreground="#64748B" FontSize="11"/><TextBlock x:Name="ReportAbsentCountText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#DC2626"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="CÓ PHÉP" Foreground="#64748B" FontSize="11"/><TextBlock x:Name="ReportExcusedCountText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#D97706"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="TỶ LỆ THAM GIA" Foreground="#64748B" FontSize="11"/><TextBlock x:Name="ReportAttendanceRateText" Text="0%" FontSize="20" FontWeight="Bold" Foreground="#4F46E5"/></StackPanel></Border>
                    </UniformGrid>
                    <GroupBox Grid.Row="3" Header="Thống kê theo buổi học từ web" Margin="0,0,0,10">
                        <DataGrid x:Name="AttendanceReportSessionsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NGÀY HỌC" Binding="{Binding DateLabel}" Width="120" />
                                <DataGridTextColumn Header="GIỜ HỌC" Binding="{Binding TimeLabel}" Width="130" />
                                <DataGridTextColumn Header="ĐÃ GHI NHẬN" Binding="{Binding TotalRecords}" Width="120" />
                                <DataGridTextColumn Header="CÓ MẶT" Binding="{Binding PresentCount}" Width="100" />
                                <DataGridTextColumn Header="ĐI MUỘN" Binding="{Binding LateCount}" Width="100" />
                                <DataGridTextColumn Header="VẮNG" Binding="{Binding AbsentCount}" Width="90" />
                                <DataGridTextColumn Header="CÓ PHÉP" Binding="{Binding ExcusedCount}" Width="100" />
                                <DataGridTextColumn Header="ĐỒNG BỘ LÚC" Binding="{Binding SyncLabel}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <GroupBox Grid.Row="4" Header="Thống kê theo học viên">
                        <DataGrid x:Name="AttendanceReportStudentsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding StudentName}" Width="2*" />
                                <DataGridTextColumn Header="SỐ BUỔI" Binding="{Binding TotalRecords}" Width="100" />
                                <DataGridTextColumn Header="CÓ MẶT" Binding="{Binding PresentCount}" Width="100" />
                                <DataGridTextColumn Header="ĐI MUỘN" Binding="{Binding LateCount}" Width="100" />
                                <DataGridTextColumn Header="VẮNG" Binding="{Binding AbsentCount}" Width="90" />
                                <DataGridTextColumn Header="CÓ PHÉP" Binding="{Binding ExcusedCount}" Width="100" />
                                <DataGridTextColumn Header="TỶ LỆ THAM GIA" Binding="{Binding AttendanceRatePercent, StringFormat='{}{0:0.#}%'}" Width="135" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" x:Name="LoadingText" Text="" Foreground="#64748B" FontSize="12" Margin="2,10,0,0" />

        <!-- SLEEK MODAL BUSY OVERLAY -->
        <Border x:Name="CscaBusyOverlay" Grid.RowSpan="3" Background="#66090E1D" Visibility="Collapsed" Panel.ZIndex="100" Margin="-22">
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="280" MaxWidth="380" Effect="{StaticResource FloatingShadow}">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Animated Dual-Orbit Spinner with Brand Badge (Mẫu 3) -->
                    <local:MolyDualOrbitSpinner Width="52" Height="52" HorizontalAlignment="Center" Margin="0,0,0,14" />
                    <TextBlock x:Name="CscaBusyText" Text="Đang xử lý dữ liệu..." HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4" />
                    <TextBlock Text="Vui lòng đợi trong giây lát..." HorizontalAlignment="Center" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,14" />
                    <ProgressBar IsIndeterminate="True" Width="200" Height="3.5" Style="{StaticResource ModernProgressBarStyle}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>

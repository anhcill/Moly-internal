<Window x:Class="InternalManagement.Desktop.CscaClassroomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InternalManagement.Desktop"
        xmlns:controls="clr-namespace:InternalManagement.Desktop.Controls"
        Title="Danh mục phòng học CSCA"
        Icon="Assets/app-icon.ico"
        Width="980" Height="620" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource LightBgBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryGradientButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource SurfaceDangerTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceDangerBorderBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="DANH MỤC PHÒNG HỌC" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" />
            <TextBlock Text="Chỉ các phòng đang hoạt động mới được chọn cho lịch học. Phòng đã phát sinh lịch chỉ có thể ngừng dùng, không thể xóa." Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,10">
            <Button Content="+ Thêm phòng" Style="{StaticResource PrimaryButton}" Click="AddClassroom_Click" />
            <Button Content="✎ Sửa phòng" Style="{StaticResource ToolButton}" Click="EditClassroom_Click" />
            <Button Content="Xóa phòng" Style="{StaticResource DangerButton}" Click="RemoveClassroom_Click" />
            <Button Content="↻ Tải lại" Style="{StaticResource ToolButton}" Click="Refresh_Click" />
        </StackPanel>
        <DataGrid Grid.Row="2" x:Name="ClassroomsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  RowHeight="44" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MouseDoubleClick="ClassroomsDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="MÃ PHÒNG" Binding="{Binding Code}" Width="140" />
                <DataGridTextColumn Header="TÊN PHÒNG" Binding="{Binding Name}" Width="1.5*" />
                <DataGridTextColumn Header="SỨC CHỨA" Binding="{Binding CapacityLabel}" Width="110" />
                <DataGridTextColumn Header="VỊ TRÍ" Binding="{Binding Location}" Width="1.6*" />
                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusLabel}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="2,10,0,0" />

        <!-- MINIMALIST ROLLING 'M' BUSY OVERLAY -->
        <Border x:Name="ClassroomBusyOverlay" Grid.RowSpan="4" Background="{DynamicResource OverlayBackdropBrush}" Visibility="Collapsed" Panel.ZIndex="100" Margin="-22">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <controls:MolyLoader Width="52" Height="52" HorizontalAlignment="Center" />
                <TextBlock x:Name="ClassroomBusyText" Text="Đang xử lý..." HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

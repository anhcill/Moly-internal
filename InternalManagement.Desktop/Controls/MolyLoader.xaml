<UserControl x:Class="InternalManagement.Desktop.Controls.MolyLoader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48" Height="48"
             IsHitTestVisible="False">
    <UserControl.Resources>
        <!-- Soft splayed folded-ribbon 'M' matching the app icon silhouette:
             smooth rounded arches, gentle outward legs, soft U-valley, and Round caps/joins.
             Arc length ~96.4px (~11.34 dash units at thickness 8.5).
             StrokeDashArray="6.5 6.5" (period = 13) yields a silky, seamless continuous glide. -->
        <PathGeometry x:Key="MolyMGeometry"
                      Figures="M 9,42 L 13.6,18.8 C 14.8,12.6 18.2,12.4 20.2,18.6 L 25.6,27.2 C 26.8,31.2 29.2,31.2 30.4,27.2 L 35.8,18.6 C 37.8,12.4 41.2,12.6 42.4,18.8 L 47,42" />

        <LinearGradientBrush x:Key="MolyBrandRibbonBrush" StartPoint="0,0.35" EndPoint="1,0.65">
            <GradientStop Color="#00F0FF" Offset="0" />
            <GradientStop Color="#00C4FF" Offset="0.32" />
            <GradientStop Color="#0084FF" Offset="0.68" />
            <GradientStop Color="#0052FF" Offset="1" />
        </LinearGradientBrush>

        <Storyboard x:Key="RollStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RollingMStroke"
                             Storyboard.TargetProperty="StrokeDashOffset"
                             From="13" To="0"
                             Duration="0:0:1.25" />
        </Storyboard>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="56" Height="56">
            <!-- Soft translucent ribbon 'M' base track -->
            <Path Data="{StaticResource MolyMGeometry}"
                  Stroke="{StaticResource MolyBrandRibbonBrush}"
                  Opacity="0.22"
                  StrokeThickness="8.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />

            <!-- Continuous silky rolling ribbon along the soft 'M' curve -->
            <Path x:Name="RollingMStroke"
                  Data="{StaticResource MolyMGeometry}"
                  Stroke="{StaticResource MolyBrandRibbonBrush}"
                  StrokeThickness="8.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  StrokeDashArray="6.5 6.5"
                  StrokeDashOffset="13">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#00B4FF" Opacity="0.28" />
                </Path.Effect>
            </Path>
        </Grid>
    </Viewbox>
</UserControl>

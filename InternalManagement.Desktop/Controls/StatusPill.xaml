<UserControl x:Class="InternalManagement.Desktop.Controls.StatusPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left"
             VerticalAlignment="Center">
    <Border x:Name="PillBorder"
            CornerRadius="11"
            Padding="9,3"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="DotIndicator" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock x:Name="LabelBlock"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>

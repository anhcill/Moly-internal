<UserControl x:Class="InternalManagement.Desktop.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,32">
        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource CardAltBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBlock x:Name="IconGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;" FontSize="18" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock x:Name="TitleBlock" Text="Chưa có dữ liệu" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextDarkBrush}" HorizontalAlignment="Center" />
        <TextBlock x:Name="SubtitleBlock" Text="Thử đổi bộ lọc hoặc thêm bản ghi mới để bắt đầu." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" MaxWidth="360" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>

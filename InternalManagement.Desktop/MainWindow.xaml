                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="🔄 Tải Lại" Click="RefreshQuestions_Click" Style="{StaticResource OutlineButton}" Height="36" Margin="0,0,8,0" />

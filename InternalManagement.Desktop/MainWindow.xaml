                                    <DataGrid Grid.Row="1" x:Name="LmsOutboxDataGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="38">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="SỰ KIỆN" Binding="{Binding EventType}" Width="1.3*" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusLabel}" Width=".85*" />
                                            <DataGridTextColumn Header="THỬ" Binding="{Binding AttemptCount}" Width=".45*" />
                                            <DataGridTextColumn Header="LỖI GẦN NHẤT" Binding="{Binding LastError}" Width="1.8*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                            <DataGridTextColumn Header="TẠO LÚC" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM HH:mm}'}" Width=".85*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ── TAB 8: PAYROLL & CALCULATION VIEW (DAY 12) ── -->
                    <Grid x:Name="ViewPayrollContainer" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- PAYROLL KPIS -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=PayrollFunctionTabs}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 0: Tổng kỳ lương -->
                            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,10,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="TỔNG KỲ LƯƠNG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                    <Border Grid.Row="0" Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Width="30" Height="30" HorizontalAlignment="Right">
                                        <TextBlock Text="📅" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="MetricPayrollTotalPeriods" Text="0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Đã thiết lập trong hệ thống" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </Grid>
                            </Border>

                            <!-- Card 1: Quỹ lương Gross -->
                            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,10,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="QUỸ LƯƠNG GROSS (KỲ HIỆN TẠI)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                    <Border Grid.Row="0" Grid.Column="1" Background="#EFF6FF" CornerRadius="8" Width="30" Height="30" HorizontalAlignment="Right">
                                        <TextBlock Text="💼" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="MetricPayrollTotalGross" Text="0 đ" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Tổng chi phí lương trước giảm trừ" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </Grid>
                            </Border>

                            <!-- Card 2: Thực chi lương Net -->
                            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,10,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="THỰC CHI LƯƠNG NET" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                    <Border Grid.Row="0" Grid.Column="1" Background="#ECFDF5" CornerRadius="8" Width="30" Height="30" HorizontalAlignment="Right">
                                        <TextBlock Text="💰" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="MetricPayrollTotalNet" Text="0 đ" FontSize="22" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Tổng thực chi tài khoản nhân sự" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </Grid>
                            </Border>

                            <!-- Card 3: Số phiếu lương đã tính -->
                            <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="16,14" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="SỐ PHIẾU LƯƠNG ĐÃ TÍNH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                    <Border Grid.Row="0" Grid.Column="1" Background="#FAF5FF" CornerRadius="8" Width="30" Height="30" HorizontalAlignment="Right">
                                        <TextBlock Text="📑" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="MetricPayrollPayslipsCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Bản ghi phiếu lương snapshot" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- PAYROLL TOOLBAR & PERIOD SELECTOR -->
                        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,0,16" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">

                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="MetricCompanyProfit" Text="0 đ" FontSize="26" FontWeight="Bold" Foreground="#7C3AED" Margin="0,8,0,6" />
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                                        <Border Background="#FAF5FF" CornerRadius="10" Padding="8,2" BorderBrush="#E9D5FF" BorderThickness="1">
                                            <TextBlock Text="Hiệu quả kinh doanh" FontSize="11" FontWeight="SemiBold" Foreground="#7C3AED" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <!-- DATA GRID -->
                        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <DataGrid x:Name="CompanyFinanceAreasDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="48">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="MẢNG HOẠT ĐỘNG" Binding="{Binding AreaName}" Width="1.8*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapBoldTextCellStyle}" />
                                        <DataGridTextColumn Header="TỔNG THU" Binding="{Binding TotalIncome, StringFormat='{}{0:N0} đ'}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapGreenTextCellStyle}" />
                                        <DataGridTextColumn Header="TỔNG CHI" Binding="{Binding TotalExpense, StringFormat='{}{0:N0} đ'}" Width="1.2*" ElementStyle="{StaticResource DataGridRedTextCellStyle}" />
                                        <DataGridTextColumn Header="DÒNG TIỀN RÒNG" Binding="{Binding NetCashFlow, StringFormat='{}{0:N0} đ'}" Width="1.2*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapBoldTextCellStyle}" />
                                        <DataGridTextColumn Header="LỢI NHUẬN" Binding="{Binding OperatingProfit, StringFormat='{}{0:N0} đ'}" Width="1.2*" FontWeight="Bold" ElementStyle="{StaticResource DataGridPurpleTextCellStyle}" />
                                        <DataGridTextColumn Header="TRẠNG THÁI DỮ LIỆU" Binding="{Binding ProfitDataStatusName}" Width="1.4*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                        <DataGridTextColumn Header="SỐ GIAO DỊCH" Binding="{Binding CashTransactionCount}" Width="0.9*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="CompanyFinanceEmptyText" Text="Chưa có dữ liệu tài chính trong khoảng thời gian đã chọn." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="14" />
                            </Grid>
                        </Border>

                        <!-- UNCLASSIFIED WARNING -->
                        <Border x:Name="UnclassifiedFinanceWarning" Grid.Row="3" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="UnclassifiedFinanceWarningText" TextWrapping="Wrap" Foreground="#92400E" FontSize="12.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- KHÁCH HÀNG / TÀI LIỆU NỘI BỘ DÙNG CHUNG, LUÔN LỌC THEO MẢNG -->
                    <Grid x:Name="ViewInternalDataContainer" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- TOOLBAR -->
                        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,16" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="InternalDataTitleText" Text="Danh mục khách hàng" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" TextWrapping="Wrap" TextTrimming="None" />
                                    <TextBlock x:Name="InternalDataHelpText" Text="Dữ liệu chỉ thuộc mảng đang xem và không trộn với mảng còn lại." FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="250" Height="36">
                                        <TextBox x:Name="InternalDataSearchBox" Height="36" Style="{StaticResource ModernTextBox}" TextChanged="InternalDataSearch_TextChanged" />
                                        <TextBlock Text="🔍 Tìm kiếm..." IsHitTestVisible="False" Foreground="#94A3B8" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=InternalDataSearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Content="🔄 Tải lại" Click="RefreshInternalData_Click" Style="{StaticResource OutlineButton}" Height="36" Margin="8,0,0,0" />
                                    <Button x:Name="EditInternalDataButton" Content="✎ Sửa" Click="EditInternalData_Click" Style="{StaticResource OutlineButton}" Height="36" Margin="8,0,0,0" />
                                    <Button x:Name="DeleteInternalDataButton" Content="🗑 Xóa" Click="DeleteInternalData_Click" Style="{StaticResource OutlineButton}" Foreground="#DC2626" Height="36" Margin="8,0,0,0" />
                                    <Button x:Name="CreateInternalDataButton" Content="+ Thêm mới" Click="CreateInternalData_Click" Style="{StaticResource ModernPrimaryButton}" Height="36" Padding="16,0" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <!-- CUSTOMERS PANEL -->
                            <Border x:Name="InternalCustomersPanel" Background="White" CornerRadius="12" Padding="8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <DataGrid x:Name="InternalCustomersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="46">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="MÃ KHÁCH HÀNG" Binding="{Binding Code}" Width="1.1*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapBoldTextCellStyle}" />
                                            <DataGridTextColumn Header="TÊN KHÁCH HÀNG" Binding="{Binding Name}" Width="2.2*" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                            <DataGridTextColumn Header="NGƯỜI LIÊN HỆ" Binding="{Binding ContactPerson}" Width="1.3*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                            <DataGridTextColumn Header="ĐIỆN THOẠI" Binding="{Binding Phone}" Width="1.1*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                            <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="1.8*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                            <DataGridTextColumn Header="NGUỒN" Binding="{Binding Source}" Width="1*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusName}" Width="1.1*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="InternalCustomersEmptyText" Text="Chưa có khách hàng trong mảng này. Bấm “Thêm mới” để bắt đầu." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="14" />
                                </Grid>
                            </Border>

                            <!-- RESOURCES PANEL -->
                            <Border x:Name="InternalResourcesPanel" Visibility="Collapsed" Background="White" CornerRadius="12" Padding="8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <DataGrid x:Name="InternalResourcesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="46" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="MÃ" Binding="{Binding Code}" Width="0.9*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                            <DataGridTextColumn Header="TÊN TÀI LIỆU / MẪU" Binding="{Binding Title}" Width="1.8*" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                            <DataGridTextColumn Header="LOẠI" Binding="{Binding ResourceTypeName}" Width="1.15*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                            <DataGridTextColumn Header="PHIÊN BẢN" Binding="{Binding Version}" Width="0.8*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                            <DataGridTextColumn Header="VỊ TRÍ LƯU" Binding="{Binding StorageUri}" Width="1.8*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                            <DataGridTextColumn Header="THẺ" Binding="{Binding TagsDisplay}" Width="1.35*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusName}" Width="1.05*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="InternalResourcesEmptyText" Text="Chưa có tài liệu trong mảng này. Bấm “Thêm mới” để lưu thông tin." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="14" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- MODERN GLOBAL LOADING OVERLAY (ENTERPRISE GLASSMORPHISM)             -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <Border x:Name="GlobalBusyOverlay" Grid.ColumnSpan="2" Background="#66090E1D" Visibility="Collapsed" Panel.ZIndex="100">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="32,28" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="340" MaxWidth="440" Effect="{StaticResource FloatingShadow}">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Animated Dual-Ring Gradient Spinner with Brand Badge -->
                        <Grid Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <!-- Background Subtle Ring -->
                            <Ellipse Width="64" Height="64" Stroke="#F1F5F9" StrokeThickness="4" />
                            
                            <!-- Rotating Gradient Arc Ring -->
                            <Ellipse Width="64" Height="64" StrokeThickness="4" StrokeDashArray="2.6 1.4" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4F46E5" Offset="0" />
                                        <GradientStop Color="#06B6D4" Offset="0.5" />
                                        <GradientStop Color="#3B82F6" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:1.1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>

                            <!-- Center MOLY Logo Badge -->
                            <Border Width="28" Height="28" Background="{StaticResource LogoBadgeGradient}" CornerRadius="14" Effect="{StaticResource LogoGlowShadow}">
                                <TextBlock Text="M" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                            </Border>
                        </Grid>

                        <!-- Dynamic Operation Title -->
                        <TextBlock x:Name="GlobalBusyText" Text="Đang tải dữ liệu..." HorizontalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4" />

                        <!-- Subtitle Context Information -->
                        <TextBlock x:Name="GlobalBusySubText" Text="Hệ thống đang đồng bộ dữ liệu, vui lòng đợi trong giây lát..." HorizontalAlignment="Center" TextAlignment="Center" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" MaxWidth="290" Margin="0,0,0,16" />

                        <!-- Modern Gradient Indeterminate Progress Bar -->
                        <ProgressBar IsIndeterminate="True" Width="260" Height="4" Style="{StaticResource ModernProgressBarStyle}" />
                    </StackPanel>
                </Border>
            </Border>

            <Border x:Name="GlobalToastBanner" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24" MaxWidth="480" Visibility="Collapsed" Panel.ZIndex="101" CornerRadius="10" Padding="16,12" Background="#0F172A">
                <TextBlock x:Name="GlobalToastText" TextWrapping="Wrap" FontSize="13" Foreground="White" />
            </Border>
        </Grid>
    </Grid>
</Window>

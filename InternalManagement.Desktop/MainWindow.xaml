                                                <DataGridTextColumn Header="KHO XUẤT" Binding="{Binding WarehouseLabel}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                                <DataGridTextColumn Header="MÃ ĐƠN NGOÀI" Binding="{Binding SourceOrderId}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                                <DataGridTextColumn Header="KHÁCH HÀNG" Binding="{Binding CustomerName}" Width="1.5*" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                                <DataGridTextColumn Header="SỐ SP" Binding="{Binding ItemCount}" Width="0.65*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                                <DataGridTextColumn Header="TỔNG THANH TOÁN" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} đ'}" Width="1.15*" ElementStyle="{StaticResource DataGridWrapBlueTextCellStyle}" />
                                                <DataGridTextColumn Header="LỢI NHUẬN" Binding="{Binding Profit, StringFormat='{}{0:N0} đ'}" Width="1.1*" ElementStyle="{StaticResource DataGridWrapGreenTextCellStyle}" />
                                                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusLabel}" Width="1.1*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                                <DataGridTextColumn Header="NGÀY ĐƠN" Binding="{Binding OrderDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="1.2*" ElementStyle="{StaticResource DataGridWrapMutedTextCellStyle}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>

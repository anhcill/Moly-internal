                                                <TextBlock Text="Dead-Letter Queue — Bản ghi cần xử lý" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="Các bản ghi đồng bộ lỗi được giữ lại để kiểm tra và retry có kiểm soát." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="🔄 Tải Dead-Letter" Click="RefreshDeadLetters_Click" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Height="34" Padding="12,0" />
                                            <Button Content="↻ Retry bản ghi đã chọn" Click="RetryDeadLetter_Click" Style="{StaticResource PrimaryGradientButton}" Height="34" Padding="14,0" />
                                        </StackPanel>
                                    </Grid>
                                    <DataGrid Grid.Row="1" x:Name="DeadLettersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="38">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="NGUỒN" Binding="{Binding SourceSystem}" Width="120" FontWeight="Bold" />
                                            <DataGridTextColumn Header="LOẠI" Binding="{Binding EntityType}" Width="110" />
                                            <DataGridTextColumn Header="MÃ NGUỒN" Binding="{Binding SourceId}" Width="130" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                            <DataGridTextColumn Header="MÃ LỖI" Binding="{Binding ErrorCode}" Width="100" ElementStyle="{StaticResource DataGridRedTextCellStyle}" FontWeight="Bold" />
                                            <DataGridTextColumn Header="NỘI DUNG LỖI" Binding="{Binding ErrorMessage}" Width="2*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                            <DataGridTextColumn Header="SỐ LẦN RETRY" Binding="{Binding RetryCount}" Width="100" />
                                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding ResolvedLabel}" Width="110" />
                                            <DataGridTextColumn Header="TẠO LÚC" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="130" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ── TAB 6: CSCA COURSE LMS ACCESS OPERATIONS ── -->
                    <Grid x:Name="ViewLmsContainer" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- HEADER BANNER -->
                        <Border Grid.Row="0" Background="#EFF6FF" CornerRadius="12" Padding="18,14" Margin="0,0,0,14" BorderBrush="#BFDBFE" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Quyền học CSCA LMS" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A" />

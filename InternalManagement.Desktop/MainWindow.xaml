<Window x:Class="InternalManagement.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InternalManagement.Desktop"
        xmlns:views="clr-namespace:InternalManagement.Desktop.Views"
        Title="MOLY — Không gian điều hành nội bộ"
        Icon="Assets/app-icon.ico"
        Height="820"
        Width="1360"
        MinHeight="680"
        MinWidth="1080"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource MainFont}"
        Background="{StaticResource LightBgBrush}">

    <Grid>
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- VIEW 1: ENTERPRISE LOGIN PORTAL                                     -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <views:LoginView x:Name="LoginContainer" Visibility="Visible" Background="#060B18" />

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- VIEW 2: AUTHENTICATED MAIN APPLICATION SHELL                        -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="AppShellContainer" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── LEFT SIDEBAR ── -->
            <Border x:Name="SidebarPanel" Grid.Column="0" Background="{StaticResource SidebarGradient}" Padding="13,16,12,14" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- BRAND & BU SELECTOR -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <Grid x:Name="SidebarBrandHeader" VerticalAlignment="Center" Margin="2,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="SidebarBrandContainer" Orientation="Horizontal" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                <Image x:Name="SidebarBrandLogo" Source="Assets/app-icon.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <StackPanel x:Name="SidebarBrandDetails" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="MOLY" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="INTERNAL MANAGEMENT" FontSize="8.5" FontWeight="SemiBold" Foreground="#818CF8" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="SidebarToggleButton" Grid.Row="0" Grid.Column="1" Content="‹" Style="{StaticResource SidebarToggleButtonStyle}" Margin="8,0,0,0" ToolTip="Thu gọn thanh chức năng" Click="SidebarToggleButton_Click" />
                        </Grid>

                        <Border x:Name="ActiveSegmentCard" Background="#0F172A" CornerRadius="8" Padding="10,6" BorderBrush="#1E293B" BorderThickness="1" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="7" Height="7" CornerRadius="3.5" Background="#10B981" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="MẢNG ĐANG XEM" FontSize="8" FontWeight="SemiBold" Foreground="#64748B" />
                                    <TextBlock x:Name="ActiveSegmentText" Text="TỔNG HỢP TOÀN CÔNG TY" FontSize="10" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="SegmentSwitcher" Background="#0B1120" CornerRadius="8" Padding="3" BorderBrush="#1E293B" BorderThickness="1" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="SegmentTechnologyButton" Grid.Column="0" GroupName="SegmentSwitcher" Style="{StaticResource SegmentPillRadioButton}" Tag="cong-nghe-giao-duc" Checked="SegmentSelector_Checked" ToolTip="Phân hệ Công nghệ - Giáo dục" Margin="0,0,2,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🎓" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Công nghệ" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SegmentFashionButton" Grid.Column="1" GroupName="SegmentSwitcher" Style="{StaticResource SegmentPillRadioButton}" Tag="thoi-trang" Checked="SegmentSelector_Checked" ToolTip="Phân hệ Thời trang" Margin="2,0,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="👗" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Thời trang" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- GROUPED NAVIGATION: chỉ hiện chức năng của phân hệ đang chọn -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <StackPanel>
                            <StackPanel x:Name="CompanyNavigationGroup">
                                <TextBlock x:Name="CompanyNavigationLabel" Text="TỔNG HỢP TOÀN CÔNG TY" Style="{StaticResource SidebarSectionLabel}" Margin="8,2,0,4" />
                                <RadioButton x:Name="NavDashboard" GroupName="MainNavigation" Content="⌂   Tổng quan" Style="{StaticResource NavRadioButton}" IsChecked="True" Checked="Nav_Checked" />
                                <RadioButton x:Name="NavCompanyFinance" GroupName="MainNavigation" Content="₫   Dòng tiền &amp; lợi nhuận" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                <RadioButton x:Name="NavSync" GroupName="MainNavigation" Content="◌   Nhật ký hệ thống" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                            </StackPanel>

                            <StackPanel x:Name="TechnologyNavigationGroup" Visibility="Collapsed">
                                <TextBlock x:Name="TechnologyNavigationLabel" Text="CÔNG NGHỆ - GIÁO DỤC" Style="{StaticResource SidebarSectionLabel}" />
                                <RadioButton x:Name="NavCustomers" GroupName="MainNavigation" Content="♧   Học viên &amp; khách hàng" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                <RadioButton x:Name="NavCourses" GroupName="MainNavigation" Content="▤   Khóa học &amp; lớp học" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                <RadioButton x:Name="NavCsca" GroupName="MainNavigation" Content="▦   Lớp học CSCA" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" Visibility="Collapsed" />
                                <RadioButton x:Name="NavLms" GroupName="MainNavigation" Content="◈   Đồng bộ Web CSCA" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                <RadioButton x:Name="NavInterview" GroupName="MainNavigation" Content="◉   Mock Interview" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                <RadioButton x:Name="NavQuestions" GroupName="MainNavigation" Content="☷   Ngân hàng đề &amp; câu hỏi" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                <RadioButton x:Name="NavTechResources" GroupName="MainNavigation" Content="▤   Kho đề &amp; tài liệu" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                <RadioButton x:Name="NavTechInternalCustomers" GroupName="MainNavigation" Content="♧   Đối tác &amp; khách hàng nội bộ" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                <RadioButton x:Name="NavTechEmployees" GroupName="MainNavigation" Content="♙   Nhân sự &amp; CV" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" Click="EmployeesNavigationParent_Click" />
                                <StackPanel x:Name="TechnologyEmployeesSubmenu" Margin="14,0,0,5" Visibility="Collapsed">
                                    <RadioButton x:Name="NavTechEmployeesWorking" GroupName="TechnologyEmployeesNavigation" Content="1   Đang làm việc" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavTechEmployeesProfiles" GroupName="TechnologyEmployeesNavigation" Content="2   Hồ sơ &amp; CV" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavTechEmployeesMissingCv" GroupName="TechnologyEmployeesNavigation" Content="3   Thiếu CV" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavTechEmployeesResigned" GroupName="TechnologyEmployeesNavigation" Content="4   Đã nghỉ việc" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavTechEmployeesBlacklist" GroupName="TechnologyEmployeesNavigation" Content="5   Blacklist" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                </StackPanel>
                                <RadioButton x:Name="NavTechAttendance" GroupName="MainNavigation" Content="◷   Chấm công" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                <RadioButton x:Name="NavTechPayroll" GroupName="MainNavigation" Content="▣   Bảng lương" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" Click="PayrollNavigationParent_Click" />
                                <StackPanel x:Name="TechnologyPayrollSubmenu" Margin="14,0,0,5" Visibility="Collapsed">
                                    <RadioButton x:Name="NavTechPayrollCreate" GroupName="TechnologyPayrollNavigation" Content="1   Tạo kỳ lương" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavTechPayrollTable" GroupName="TechnologyPayrollNavigation" Content="2   Tính &amp; phiếu lương" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavTechPayrollAdjustments" GroupName="TechnologyPayrollNavigation" Content="3   Chỉnh lương · thưởng/phạt" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavTechPayrollReview" GroupName="TechnologyPayrollNavigation" Content="4   Xem xét &amp; gửi duyệt" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavTechPayrollWorkflow" GroupName="TechnologyPayrollNavigation" Content="5   Duyệt · chi · phát hành" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavTechPayrollMonthly" GroupName="TechnologyPayrollNavigation" Content="6   Tổng hợp theo tháng" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="FashionNavigationGroup" Visibility="Collapsed">
                                <TextBlock x:Name="FashionNavigationLabel" Text="THỜI TRANG" Style="{StaticResource SidebarSectionLabel}" />
                                <RadioButton x:Name="NavFashionResources" GroupName="MainNavigation" Content="✎   Kế hoạch &amp; mẫu thiết kế" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                <RadioButton x:Name="NavFashion" GroupName="MainNavigation" Content="▧   Sản phẩm · kho · đơn hàng" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" Click="FashionNavigationParent_Click" Visibility="Collapsed" />
                                <StackPanel x:Name="FashionInventorySubmenu" Margin="14,0,0,5" Visibility="Collapsed">
                                    <RadioButton x:Name="NavFashionProducts" GroupName="FashionInventoryNavigation" Content="1   Sản phẩm" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavFashionVariants" GroupName="FashionInventoryNavigation" Content="2   Biến thể &amp; SKU" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavFashionSuppliers" GroupName="FashionInventoryNavigation" Content="3   Nhà cung cấp" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavFashionReceipts" GroupName="FashionInventoryNavigation" Content="4   Phiếu nhập kho" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavFashionManufacturing" GroupName="FashionInventoryNavigation" Content="5   Sản xuất &amp; giá thành" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavFashionBalances" GroupName="FashionInventoryNavigation" Content="6   Tồn kho" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavFashionMovements" GroupName="FashionInventoryNavigation" Content="7   Nhật ký kho" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavFashionWarehouses" GroupName="FashionInventoryNavigation" Content="8   Danh mục kho" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavFashionOrders" GroupName="FashionInventoryNavigation" Content="9   Đơn hàng" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                </StackPanel>
                                <RadioButton x:Name="NavFashionInternalCustomers" GroupName="MainNavigation" Content="♧   Khách hàng &amp; đối tác nội bộ" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                <RadioButton x:Name="NavFashionEmployees" GroupName="MainNavigation" Content="♙   Nhân sự &amp; CV" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" Click="EmployeesNavigationParent_Click" />
                                <StackPanel x:Name="FashionEmployeesSubmenu" Margin="14,0,0,5" Visibility="Collapsed">
                                    <RadioButton x:Name="NavFashionEmployeesWorking" GroupName="FashionEmployeesNavigation" Content="1   Đang làm việc" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavFashionEmployeesProfiles" GroupName="FashionEmployeesNavigation" Content="2   Hồ sơ &amp; CV" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavFashionEmployeesMissingCv" GroupName="FashionEmployeesNavigation" Content="3   Thiếu CV" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavFashionEmployeesResigned" GroupName="FashionEmployeesNavigation" Content="4   Đã nghỉ việc" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavFashionEmployeesBlacklist" GroupName="FashionEmployeesNavigation" Content="5   Blacklist" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                </StackPanel>
                                <RadioButton x:Name="NavFashionAttendance" GroupName="MainNavigation" Content="◷   Chấm công" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                <RadioButton x:Name="NavFashionPayroll" GroupName="MainNavigation" Content="▣   Bảng lương" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" Click="PayrollNavigationParent_Click" />
                                <StackPanel x:Name="FashionPayrollSubmenu" Margin="14,0,0,5" Visibility="Collapsed">
                                    <RadioButton x:Name="NavFashionPayrollCreate" GroupName="FashionPayrollNavigation" Content="1   Tạo kỳ lương" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavFashionPayrollTable" GroupName="FashionPayrollNavigation" Content="2   Tính &amp; phiếu lương" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavFashionPayrollAdjustments" GroupName="FashionPayrollNavigation" Content="3   Chỉnh lương · thưởng/phạt" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavFashionPayrollReview" GroupName="FashionPayrollNavigation" Content="4   Xem xét &amp; gửi duyệt" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavFashionPayrollWorkflow" GroupName="FashionPayrollNavigation" Content="5   Duyệt · chi · phát hành" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                    <RadioButton x:Name="NavFashionPayrollMonthly" GroupName="FashionPayrollNavigation" Content="6   Tổng hợp theo tháng" Style="{StaticResource NavRadioButton}" Checked="Nav_Checked" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- USER PROFILE & LOGOUT FOOTER -->
                    <Border x:Name="UserProfileCard" Grid.Row="2" Background="#131C31" CornerRadius="10" Padding="12" BorderBrush="#1E293B" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="UserAvatarBadge" Grid.Row="0" Grid.Column="0" Background="{StaticResource PrimaryBrush}" CornerRadius="18" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock x:Name="UserAvatarText" Text="AD" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel x:Name="UserProfileDetails" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="UserFullNameText" Text="Admin Tổng MOLY" FontSize="12.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                <Border Background="#312E81" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,2,0,0">
                                    <TextBlock x:Name="UserRoleBadge" Text="SystemAdmin" FontSize="9.5" FontWeight="Bold" Foreground="#C7D2FE" />
                                </Border>
                            </StackPanel>
                            <Button x:Name="LogoutButton" Grid.Row="0" Grid.Column="2" Content="🚪" ToolTip="Đăng xuất" Click="LogoutButton_Click" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontSize="16" Cursor="Hand" Padding="6" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ── RIGHT CONTENT AREA ── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- TOP BAR HEADER -->
                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="28,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- BREADCRUMB & TITLE -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ViewHeaderTitle" Text="Tổng Quan Hệ Thống" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" />
                                <Border x:Name="ActiveSegmentBadge" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ActiveSegmentBadgeText" Text="TOÀN CÔNG TY" FontSize="9.5" FontWeight="SemiBold" Foreground="#2563EB" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="ViewHeaderSubtitle" Text="Không gian làm việc MOLY Internal Management" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            <TextBlock x:Name="ViewHeaderStatusText" Text="Sẵn sàng" FontSize="11" Foreground="#64748B" Margin="0,1,0,0" />
                        </StackPanel>

                        <!-- QUICK ACTIONS & HEALTH -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="⚡ Đồng Bộ Website Ngay" Click="QuickSync_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="14,0" Margin="0,0,12,0" />
                            <Border x:Name="ApiHealthBorder" Background="#F8FAFC" CornerRadius="16" Padding="12,6" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="ApiHealthDot" Width="8" Height="8" Fill="#94A3B8" Margin="0,0,6,0" />
                                    <TextBlock x:Name="ApiHealthText" Text="Đang kiểm tra API" FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SLIM TOP CONTENT PROGRESS BAR FOR FLUID TAB TRANSITIONS -->
                <ProgressBar x:Name="TopContentProgressBar" Grid.Row="0" VerticalAlignment="Bottom" Height="3" IsIndeterminate="True" Visibility="Collapsed" Style="{StaticResource TopProgressBarStyle}" Panel.ZIndex="50" Margin="0,0,0,-1" />

                <!-- TAB CONTENT VIEWS -->
                <Grid Grid.Row="1" Background="{StaticResource LightBgBrush}" Margin="24">

                    <!-- ── TAB 1: DASHBOARD VIEW ── -->
                    <views:DashboardView x:Name="ViewDashboardContainer" Visibility="Visible" />

                    <!-- ── TAB 2: COURSES & CLASSES VIEW (KHÓA HỌC & LỚP HỌC) ── -->
                    <views:CourseManagementView x:Name="ViewCoursesContainer" Visibility="Collapsed" />

                    <!-- ── TAB 3: QUESTIONS & PUBLICATION (NGÀY 9 CORE) ── -->
                    <views:QuestionBankView x:Name="ViewQuestionsContainer" Visibility="Collapsed" />

                    <!-- ── TAB: MOCK INTERVIEW & KHÁCH HÀNG (NGÀY 10) ── -->
                    <views:InterviewCustomersView x:Name="ViewInterviewContainer" Visibility="Collapsed" />

                    <!-- ── TAB: EMPLOYEES & CV VIEW (NGÀY 11 + PHÂN HỆ 5 NGHIỆP VỤ) ── -->
                    <views:EmployeesView x:Name="ViewEmployeesContainer" Visibility="Collapsed" />

                    <!-- ── TAB: ATTENDANCE & EXCEL IMPORT VIEW (NGÀY 11) ── -->
                    <views:AttendanceView x:Name="ViewAttendanceContainer" Visibility="Collapsed" />

                    <!-- ── TAB 4: STUDENTS & CUSTOMERS VIEW ── -->
                    <views:CustomersView x:Name="ViewCustomersContainer" Visibility="Collapsed" />

                    <!-- ── TAB 5: SYNC RUNS VIEW ── -->
                    <views:SyncRunsView x:Name="ViewSyncContainer" Visibility="Collapsed" />

                    <!-- ── TAB 6: CSCA COURSE LMS ACCESS OPERATIONS ── -->
                    <views:LmsOperationsView x:Name="ViewLmsContainer" Visibility="Collapsed" />

                    <!-- ── TAB 8: PAYROLL & CALCULATION VIEW (DAY 12) ── -->
                    <views:PayrollView x:Name="ViewPayrollContainer" Visibility="Collapsed" />

                    <!-- ── TAB: FASHION & INVENTORY VIEW (NGÀY 14) ── -->
                    <views:FashionView x:Name="ViewFashionContainer" Visibility="Collapsed" />

                    <!-- BẢNG TỔNG TÀI CHÍNH TOÀN CÔNG TY -->
                    <views:CompanyFinanceView x:Name="ViewCompanyFinanceContainer" Visibility="Collapsed" />

                    <!-- KHÁCH HÀNG / TÀI LIỆU NỘI BỘ DÙNG CHUNG, LUÔN LỌC THEO MẢNG -->
                    <views:InternalDataView x:Name="ViewInternalDataContainer" Visibility="Collapsed" />

                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- MODERN GLOBAL LOADING OVERLAY (ENTERPRISE GLASSMORPHISM)             -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <Border x:Name="GlobalBusyOverlay" Grid.ColumnSpan="2" Background="#66090E1D" Visibility="Collapsed" Panel.ZIndex="100">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="32,28" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="340" MaxWidth="440" Effect="{StaticResource FloatingShadow}">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Animated Dual-Orbit Spinner with Brand Badge (Mẫu 3) -->
                        <local:MolyDualOrbitSpinner Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,18" />

                        <!-- Dynamic Operation Title -->
                        <TextBlock x:Name="GlobalBusyText" Text="Đang tải dữ liệu..." HorizontalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4" />

                        <!-- Subtitle Context Information -->
                        <TextBlock x:Name="GlobalBusySubText" Text="Hệ thống đang đồng bộ dữ liệu, vui lòng đợi trong giây lát..." HorizontalAlignment="Center" TextAlignment="Center" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" MaxWidth="290" Margin="0,0,0,16" />

                        <!-- Modern Gradient Indeterminate Progress Bar -->
                        <ProgressBar IsIndeterminate="True" Width="260" Height="4" Style="{StaticResource ModernProgressBarStyle}" />
                    </StackPanel>
                </Border>
            </Border>

            <Border x:Name="GlobalToastBanner" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24" MaxWidth="480" Visibility="Collapsed" Panel.ZIndex="101" CornerRadius="10" Padding="16,12" Background="#0F172A">
                <TextBlock x:Name="GlobalToastText" TextWrapping="Wrap" FontSize="13" Foreground="White" />
            </Border>
        </Grid>
    </Grid>
</Window>

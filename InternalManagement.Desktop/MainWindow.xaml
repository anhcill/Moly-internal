                                </Border>
                                <Button x:Name="BtnCalculatePayrollShortcut" Grid.Column="3" Content="⚡ Tính lương" Click="CalculatePayroll_Click" Style="{StaticResource PrimaryGradientButton}" Height="36" Padding="14,0" Visibility="Collapsed" />

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="TỔNG CHI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Row="0" Grid.Column="1" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Width="32" Height="32">
                                        <TextBlock Text="📉" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="MetricCompanyExpense" Text="0 đ" FontSize="26" FontWeight="Bold" Foreground="#DC2626" Margin="0,8,0,6" />
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                                        <Border Background="#FEF2F2" CornerRadius="10" Padding="8,2" BorderBrush="#FECACA" BorderThickness="1">
                                            <TextBlock Text="Chi phí hoạt động" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 3: Net Cash Flow -->
                            <Border Background="White" CornerRadius="12" Padding="18,16" Margin="0,0,12,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DÒNG TIỀN RÒNG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />

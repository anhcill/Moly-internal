                                        <TextBlock Text="💰" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="MetricCompanyIncome" Text="0 đ" FontSize="26" FontWeight="Bold" Foreground="#059669" Margin="0,8,0,6" />
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                                        <Border Background="#ECFDF5" CornerRadius="10" Padding="8,2" BorderBrush="#A7F3D0" BorderThickness="1">
                                            <TextBlock Text="Doanh thu ghi nhận" FontSize="11" FontWeight="SemiBold" Foreground="#059669" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>


                                                <DataGridTextColumn Header="SỐ ĐIỆN THOẠI" Binding="{Binding PhoneNumber}" Width="130" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                                <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="1.8*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                                <DataGridTextColumn Header="GÓI / KHÓA ĐĂNG KÝ" Binding="{Binding SubscriptionCount}" Width="150" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                                <DataGridTextColumn Header="TỔNG ĐÃ ĐÓNG" Binding="{Binding TotalPaidAmount, StringFormat='{}{0:N0} đ'}" Width="145" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapGreenTextCellStyle}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>
                            </TabControl>

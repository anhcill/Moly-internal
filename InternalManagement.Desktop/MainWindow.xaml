                                    </Grid>
                                </TabItem>
                                <TabItem Header="Khách hàng đăng ký" FontWeight="SemiBold">
                                    <Grid Margin="0,8,0,0">
                                        <DataGrid x:Name="CustomersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="46">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="MÃ KHÁCH HÀNG" Binding="{Binding SourceId}" Width="140" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapBoldTextCellStyle}" />

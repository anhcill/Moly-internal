                                    <Button x:Name="BtnCancelPayroll" Content="Hủy bản nháp" Click="CancelPayroll_Click" Style="{StaticResource OutlineButton}" Foreground="#DC2626" Height="36" Padding="12,0" Margin="8,0,0,0" Visibility="Collapsed" />
                                    <Button x:Name="BtnExportPayroll" Content="⬇ Xuất Excel" Click="ExportPayrollExcel_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="12,0" Margin="8,0,0,0" Visibility="Collapsed" />
                                </StackPanel>
                                <Button Grid.Column="5" Content="🔄 Tải lại" Click="RefreshPayroll_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="12,0" />

                                <Border Grid.Row="1" Grid.ColumnSpan="6" Background="#F8FAFC" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Lọc phiếu lương" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Grid Grid.Column="1" Height="32" Margin="0,0,10,0">
                                            <TextBox x:Name="PayrollSearchBox" Height="32" Style="{StaticResource ModernTextBox}" TextChanged="PayrollSearch_TextChanged" AutomationProperties.Name="Tìm phiếu lương theo mã nhân viên hoặc họ tên" />
                                            <TextBlock x:Name="PayrollSearchPlaceholder" Text="🔍 Tìm mã nhân viên, họ tên..." IsHitTestVisible="False" Foreground="#94A3B8" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                        <ComboBox x:Name="PayrollDeptFilterCombo" Grid.Column="2" Height="32" VerticalContentAlignment="Center" SelectionChanged="PayrollDeptFilter_SelectionChanged" AutomationProperties.Name="Lọc phiếu lương theo phòng ban">
                                            <ComboBoxItem Content="-- Tất cả phòng ban --" IsSelected="True" />
                                        </ComboBox>
                                        <TextBlock Grid.Column="3" Text="Nhấp đúp một dòng để xem chi tiết hoặc điều chỉnh." FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- PAYROLL FUNCTION TABS -->
                        <TabControl x:Name="PayrollFunctionTabs" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="PayrollFunctionTabs_SelectionChanged">
                            <TabItem Header="Kỳ lương &amp; Tính lương" FontWeight="SemiBold">
                                <Grid Margin="0,14,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- SECTION TITLE (IMAGE 1) -->
                                    <TextBlock Grid.Row="0" x:Name="PayrollPeriodHeaderTitle" Text="Kỳ lương hiện tại — Mảng Thời trang &amp; Giáo dục" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,12" />

                                    <!-- 5-STAGE WORKFLOW PIPELINE STEPPER (IMAGE 1) -->
                                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Step 1 -->
                                            <Border Grid.Column="0" x:Name="PayrollStep1Border" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="8,8" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="PayrollStep1Icon" Text="✓ " FontWeight="Bold" Foreground="#16A34A" />
                                                    <TextBlock Text="1. Tính toán" FontWeight="SemiBold" Foreground="#15803D" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Step 2 -->
                                            <Border Grid.Column="1" x:Name="PayrollStep2Border" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="8,8" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="PayrollStep2Icon" Text="✓ " FontWeight="Bold" Foreground="#16A34A" />
                                                    <TextBlock Text="2. Gửi duyệt" FontWeight="SemiBold" Foreground="#15803D" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Step 3 -->
                                            <Border Grid.Column="2" x:Name="PayrollStep3Border" Background="#CCFBF1" BorderBrush="#5EEAD4" BorderThickness="1" CornerRadius="6" Padding="8,8" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="PayrollStep3Icon" Text="" FontWeight="Bold" Foreground="#0F766E" />
                                                    <TextBlock Text="3. Phê duyệt" FontWeight="Bold" Foreground="#0F766E" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Step 4 -->
                                            <Border Grid.Column="3" x:Name="PayrollStep4Border" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,8" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="PayrollStep4Icon" Text="" FontWeight="Bold" Foreground="#64748B" />
                                                    <TextBlock Text="4. Đã chi" FontWeight="Medium" Foreground="#64748B" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Step 5 -->
                                            <Border Grid.Column="4" x:Name="PayrollStep5Border" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,8">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="PayrollStep5Icon" Text="" FontWeight="Bold" Foreground="#64748B" />
                                                    <TextBlock Text="5. Phát hành" FontWeight="Medium" Foreground="#64748B" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- ACTION BAR (IMAGE 1: Phê duyệt kỳ lương, Xuất Excel, Xem phiếu chi tiết) -->
                                    <Grid Grid.Row="2" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Danh sách phiếu lương chi tiết" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="BtnApprovePayrollMain" Content="Phê duyệt kỳ lương" Click="ApprovePayroll_Click" Style="{StaticResource ModernPrimaryButton}" Height="36" Padding="16,0" Margin="0,0,8,0" Visibility="Collapsed" />
                                            <Button x:Name="BtnExportPayrollMain" Content="📄 Xuất Excel" Click="ExportPayrollExcel_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="14,0" Margin="0,0,8,0" />
                                            <Button x:Name="BtnViewPayslipDetailMain" Content="Xem phiếu chi tiết" Click="ViewPayslipDetail_Click" Style="{StaticResource OutlineButton}" Height="36" Padding="14,0" />
                                        </StackPanel>
                                    </Grid>

                                     <!-- DATA TABLE (IMAGE 1) -->
                                    <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                        <Grid>
                                            <DataGrid x:Name="PayslipsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="44" ScrollViewer.HorizontalScrollBarVisibility="Auto" MouseDoubleClick="PayslipsDataGrid_MouseDoubleClick">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="MÃ NV" Binding="{Binding EmployeeCode}" Width="105" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapBoldTextCellStyle}" />
                                                    <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding EmployeeName}" Width="1.5*" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                                    <DataGridTextColumn Header="HÌNH THỨC" Binding="{Binding EmploymentTypeNameVi}" Width="110" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                                    <DataGridTextColumn Header="NGÀY CÔNG / GIỜ" Binding="{Binding WorkQuantityDisplay}" Width="130" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                                    <DataGridTextColumn Header="LƯƠNG CƠ BẢN" Binding="{Binding PayRateDisplay}" Width="130" FontWeight="SemiBold" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                                    <DataGridTextColumn Header="PHỤ CẤP" Binding="{Binding Allowances, StringFormat='{}{0:N0} đ'}" Width="120" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                                    <DataGridTextColumn Header="THƯỞNG KPI" Binding="{Binding KpiBonus, StringFormat='{}{0:N0} đ'}" Width="120" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                                    <DataGridTextColumn Header="KHẤU TRỪ BHYT" Binding="{Binding HealthInsurance, StringFormat='{}{0:N0} đ'}" Width="130" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />

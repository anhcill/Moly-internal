                                            </StackPanel>
                                            <Button x:Name="SaveLmsMappingButton" Grid.Column="4" Content="Lưu mapping" Click="SaveLmsMapping_Click" Style="{StaticResource PrimaryGradientButton}" Height="32" Padding="14,0" VerticalAlignment="Bottom" />
                                        </Grid>
                                    </Border>
                                    <DataGrid Grid.Row="2" x:Name="LmsCourseMappingsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="LmsCourseMappingsDataGrid_SelectionChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0" MinRowHeight="40">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="KHÓA HỌC" Binding="{Binding CourseTitle}" Width="1.45*" FontWeight="Bold" ElementStyle="{StaticResource DataGridWrapBoldTextCellStyle}" />
                                            <DataGridTextColumn Header="SOURCE ID" Binding="{Binding CourseSourceId}" Width="1.1*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                            <DataGridTextColumn Header="LMS SLUG" Binding="{Binding LmsCourseSlug}" Width="1*" ElementStyle="{StaticResource DataGridWrapTextCellStyle}" />
                                            <DataGridTextColumn Header="LMS ID" Binding="{Binding LmsCourseId}" Width=".7*" />
                                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusLabel}" Width=".8*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <!-- Right: LMS Outbox -->
                            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="14" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="LMS Outbox" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />

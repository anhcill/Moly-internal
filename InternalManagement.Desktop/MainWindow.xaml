                                                <Border Grid.Row="0" Grid.Column="1" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="8" Width="32" Height="32">
                                                    <TextBlock Text="👥" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
